{%- doc -%}
  One video slot for the video block.

  Picks the uploaded or the URL path and hands off to the shared `video` snippet.
  It exists so the block can render a second slot for phones without repeating
  the same branch twice.

  @param {string} source - 'uploaded' or 'url'
  @param {object} [video] - Shopify video object, used when source is 'uploaded'
  @param {object} [video_url] - video_url setting, used when source is 'url'
  @param {object} [cover_image] - Poster image for the URL path
  @param {string} [alt] - Alt text for the URL path
  @param {string} [video_style] - Inline styles, carries the aspect ratio
  @param {boolean} [video_autoplay] - Whether the video plays on load
  @param {boolean} [video_loop] - Whether the video loops
  @param {boolean} [video_background] - Strip player chrome
  @param {string} [additional_attributes] - Extra attributes, e.g. the editor handle
{%- enddoc -%}

{%- liquid
  # Unlisted Vimeo videos only play with their privacy hash, and the video_url
  # object hands Liquid the bare id. The setting still holds the whole URL, so
  # read the hash back off it — /ID/HASH and ?h=HASH are both valid share forms.
  assign vimeo_hash = ''
  assign url_string = video_url | append: ''
  if source != 'uploaded' and url_string contains 'vimeo'
    if url_string contains 'h='
      assign vimeo_hash = url_string | split: 'h=' | last | split: '&' | first
    else
      assign url_tail = url_string | split: '?' | first | split: '/' | last
      if url_tail != video_url.id
        assign vimeo_hash = url_tail
      endif
    endif
  endif
-%}

{%- if source == 'uploaded' -%}
  {% render 'video',
    video: video,
    video_class: 'spacing-style size-style border-style',
    video_autoplay: video_autoplay,
    video_loop: video_loop,
    video_style: video_style,
    video_preview_image: video.preview_image,
    video_background: video_background,
    additional_attributes: additional_attributes
  %}
{%- else -%}
  {% render 'video',
    video_from_url: true,
    video: video_url.id,
    video_class: 'spacing-style size-style border-style',
    video_type: video_url.type,
    video_hash: vimeo_hash,
    video_autoplay: video_autoplay,
    video_loop: video_loop,
    video_style: video_style,
    video_alt: alt,
    video_preview_image: cover_image,
    video_background: video_background,
    additional_attributes: additional_attributes
  %}
{%- endif -%}

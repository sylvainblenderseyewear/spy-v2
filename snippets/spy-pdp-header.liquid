{%- doc -%}
  Title, price and stars above the PDP gallery below 992px, like the source's
  `.ds-main-grid.d-lg-none` header. The right column hides its own title, price and
  stars there (src/tailwind.css), so one h1 shows at any width.

  The price is Horizon's product-price with its own block id, so a size or lens
  pick updates it like the column's price. The stars are the same Yotpo markup as
  the Star Rating block (spy-app-embed, yotpo_bottomline, yotpo.product_id).

  @param {product} product - The product on the page

  @example
  {% render 'spy-pdp-header', product: product %}
{%- enddoc -%}

{%- liquid
  # Yotpo keys reviews to the old store's ids and wants an absolute image URL
  assign yotpo_id = product.metafields.yotpo.product_id.value | default: product.id
  assign yotpo_img = product.featured_image | image_url: width: 600
  assign yotpo_img_head = yotpo_img | slice: 0, 2
  if yotpo_img_head == '//'
    assign yotpo_img = 'https:' | append: yotpo_img
  elsif yotpo_img != blank
    assign yotpo_img = shop.url | append: yotpo_img
  endif
-%}

<div class="spy-pdp-header min-[992px]:hidden" data-testid="spy-pdp-header">
  <h1>{{ product.title }}</h1>
  <div class="[display:flex] items-start justify-between gap-3">
    <product-price
      class="text-block rte text-left paragraph spacing-style"
      data-block-id="spy-pdp-header-price"
      data-product-id="{{ product.id }}"
      style="--padding-block-start: 0px; --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px; --width: fit-content;"
    >
      {% render 'price', show_unit_price: true, product_resource: product, show_sale_price_first: true %}
    </product-price>
    <div
      class="
        spy-rating-embed text-spy-orange-ui text-[0.6875rem]
        [&_.yotpo-stars]:mr-px
        [&_.text-m]:font-spy [&_.text-m]:text-[13px] [&_.text-m]:text-spy-review-label
        [&_.text-m]:whitespace-nowrap [&_.text-m]:no-underline
      "
    >
      <div
        class="yotpo bottomLine"
        data-product-id="{{ yotpo_id }}"
        data-name="{{ product.title | escape }}"
        data-url="{{ shop.url }}{{ product.url }}"
        data-image-url="{{ yotpo_img }}"
        data-description="{{ product.description | strip_html | truncate: 300 | escape }}"
      ></div>
    </div>
  </div>
</div>

{% doc %}
  SPY search bar. Slides down from under the header like the source,
  with the suggestions panel hanging below it (sections/predictive-search).
  Horizon's dialog + predictive-search components still run it: focus trap,
  Escape, click outside, arrow keys and fetching.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [class] - Additional CSS classes to apply to the predictive search component.
{% enddoc %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'predictive-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  {% comment %} Clip + slide run together, so the bar looks like it comes out from behind the header {% endcomment %}
  <dialog
    ref="dialog"
    class="fixed inset-x-0 top-[var(--spy-search-top,0px)] m-0 w-full max-w-none max-h-none p-0 border-0 bg-transparent overflow-visible open:block backdrop:bg-transparent open:animate-spy-search-in [&.dialog-closing]:animate-spy-search-out motion-reduce:animate-none"
    scroll-lock
    aria-labelledby="search-modal-heading"
  >
    <h2
      id="search-modal-heading"
      class="sr-only"
    >
      {{ 'content.search' | t }}
    </h2>
    <predictive-search-component
      class="block w-full font-spy text-spy-ink{% if class != blank %} {{ class | strip }}{% endif %}"
      data-section-id="predictive-search"
      data-testid="search-component--modal"
      role="search"
      aria-label="{{ 'content.search_input_label' | t }}"
    >
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="block w-full"
        ref="form"
        on:keydown="/onSearchKeyDown"
      >
        <div class="flex items-center h-[45px] px-2 py-1 bg-white border border-spy-border">
          <label
            for="cmdk-input"
            class="sr-only"
          >
            {{- 'content.search_input_label' | t -}}
          </label>
          <input
            class="flex-1 min-w-0 h-[25px] px-1 m-0 bg-transparent border-0 rounded-none shadow-none outline-none text-center font-spy text-[13px] leading-[18.2px] text-spy-ink placeholder:text-spy-muted placeholder:opacity-100 [&::-webkit-search-cancel-button]:appearance-none"
            id="cmdk-input"
            type="search"
            name="q"
            aria-controls="predictive-search-results"
            autocomplete="off"
            placeholder="{{ 'content.spy_search.placeholder' | t }}"
            ref="searchInput"
            on:input="/search"
            on:keydown="/onSearchKeyDown"
          >
          <input
            name="options[prefix]"
            type="hidden"
            value="last"
          >
          {% comment %} Results page is product-only, so filters and grouped cards work {% endcomment %}
          <input
            name="type"
            type="hidden"
            value="product"
          >
          {% comment %} Source shows Chrome's blue clear ✕; ours draws the same in every browser {% endcomment %}
          <button
            type="button"
            class="button-unstyled [display:flex] [&[hidden]]:hidden items-center h-[22px] px-1 text-spy-review-link"
            ref="resetButton"
            hidden
            aria-label="{{ 'accessibility.reset_search' | t }}"
            on:click="/resetSearch"
          >
            <span class="block w-2 h-[11px] [&_svg]:size-full [&_svg]:max-w-none">
              {{- 'spy-fa-xmark.svg' | inline_asset_content -}}
            </span>
          </button>
          <button
            type="submit"
            class="button-unstyled flex items-center h-[22px] pr-1 pl-0 text-spy-ink"
            aria-label="{{ 'content.spy_search.submit' | t }}"
          >
            <span class="block size-[15px] [&_svg]:size-full [&_svg]:max-w-none">
              {{- 'spy-fa-search.svg' | inline_asset_content -}}
            </span>
          </button>
          <button
            type="button"
            class="button-unstyled flex items-center justify-center size-[35px] px-3 py-2 text-spy-ink"
            aria-label="{{ 'content.spy_search.close' | t }}"
            on:click="dialog-component/closeDialog"
            ref="closeModalButton"
          >
            <span class="block w-[9px] h-3 [&_svg]:size-full [&_svg]:max-w-none">
              {{- 'spy-fa-xmark.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        <div ref="predictiveSearchResults"></div>
      </form>
    </predictive-search-component>
  </dialog>
</dialog-component>

<script>
  // Park the bar right under the header each time it opens
  (() => {
    const dialog = document.querySelector('#search-modal dialog');
    if (!dialog) return;
    new MutationObserver(() => {
      if (!dialog.open) return;
      const header = document.querySelector('.spy-header-section') || document.querySelector('#header-group');
      const top = header ? Math.max(0, Math.round(header.getBoundingClientRect().bottom)) : 0;
      dialog.style.setProperty('--spy-search-top', `${top}px`);
    }).observe(dialog, { attributes: true, attributeFilter: ['open'] });
  })();
</script>

{%- comment -%}
  Compact country + language picker for the footer brand column.
  Matches the source: flag, 12px uppercase label, caret. Falls back to a static
  label when the store has a single market/language, and hides below 769px.
{%- endcomment -%}
{%- liquid
  assign has_countries = false
  if localization.available_countries.size > 1
    assign has_countries = true
  endif
  assign has_languages = false
  if localization.available_languages.size > 1
    assign has_languages = true
  endif
  assign flag = ''
  if localization.country.iso_code == 'US'
    assign flag = 'spy-flag-us.svg'
  endif
-%}
<div
  class="spy-locale hidden min-h-[34px] w-full text-center text-[12px] font-normal uppercase leading-[16.8px] min-[769px]:block"
  style="color: var(--color-foreground);"
>
  {%- comment -%} Inline flow, not flex: the label has to wrap mid-string like the source. {%- endcomment -%}
  {%- form 'localization', id: 'FooterLocalization', class: 'spy-locale__form' -%}
    {%- if flag != blank -%}
      <img
        src="{{ flag | asset_url }}"
        alt=""
        width="16"
        height="12"
        class="mr-1 inline-block h-[12px] w-[16px] align-[-0.1em]"
        aria-hidden="true"
      >
    {%- endif -%}

    {%- if has_countries -%}
      <label class="sr-only" for="FooterLocaleCountry">Country/region</label>
      <span class="relative inline-flex items-center">
        <select
          id="FooterLocaleCountry"
          name="country_code"
          data-initial="{{ localization.country.iso_code }}"
          {% comment %} WCAG 3.2.2: arrowing through options must not reload the page {% endcomment %}
          onmousedown="delete this.dataset.kb"
          onkeydown="if(event.key==='Enter'){event.preventDefault();this.form.submit()}else if(event.key!=='Tab'){this.dataset.kb='1'}"
          onchange="if(!this.dataset.kb)this.form.submit()"
          onblur="if(this.dataset.kb&&this.value!==this.dataset.initial)this.form.submit()"
          class="cursor-pointer appearance-none border-0 bg-transparent pr-3 text-[12px] font-normal uppercase leading-[16.8px] text-current"
        >
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
              {{ country.name }}{% unless has_languages %} ({{ localization.language.endonym_name | capitalize }}){% endunless %}
            </option>
          {%- endfor -%}
        </select>
        <span class="pointer-events-none absolute right-0 w-3 [display:flex] [&_svg]:h-3 [&_svg]:w-3">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </span>
    {%- else -%}
      <span class="text-[12px] font-normal uppercase leading-[16.8px]">
        {{- localization.country.name }} ({{ localization.language.endonym_name | capitalize }})
        <span class="inline-block w-3 align-[-0.15em] [&_svg]:h-3 [&_svg]:w-3">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </span>
    {%- endif -%}

    {%- if has_languages -%}
      <label class="sr-only" for="FooterLocaleLanguage">Language</label>
      <span class="relative inline-flex items-center">
        <select
          id="FooterLocaleLanguage"
          name="language_code"
          data-initial="{{ localization.language.iso_code }}"
          onmousedown="delete this.dataset.kb"
          onkeydown="if(event.key==='Enter'){event.preventDefault();this.form.submit()}else if(event.key!=='Tab'){this.dataset.kb='1'}"
          onchange="if(!this.dataset.kb)this.form.submit()"
          onblur="if(this.dataset.kb&&this.value!==this.dataset.initial)this.form.submit()"
          class="cursor-pointer appearance-none border-0 bg-transparent pr-4 text-[12px] font-normal uppercase leading-[16.8px] text-current"
        >
          {%- for language in localization.available_languages -%}
            <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
              {{ language.endonym_name | capitalize }}
            </option>
          {%- endfor -%}
        </select>
        <span class="pointer-events-none absolute right-0 w-3 [display:flex] [&_svg]:h-3 [&_svg]:w-3">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </span>
    {%- endif -%}
  {%- endform -%}
</div>

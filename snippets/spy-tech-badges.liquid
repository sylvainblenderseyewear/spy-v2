{%- doc -%}
  Renders a product card's stickers, top right of the image. Each sticker is one
  product tag, set per product to match spyoptic.com (scripts/card-stickers.mjs
  works them out from the legacy site):

    badge::bonus-lens · badge::deadbolt · badge::happy-boost · badge::ansi-z87
    badge::ansi-z87-2-plus · badge::cat-4 · badge::not-for-driving · badge::mips

  They print in that order, the legacy site's. The art lives in the shop's Files;
  a block can swap the four pictos it has settings for.

  @param {object} product - product whose tags pick the stickers
  @param {object} [happy_boost_icon] - Happy Boost picto, instead of the pictohappyboost file
  @param {object} [mips_icon] - Mips picto, instead of the mips file
  @param {object} [bonus_lens_icon] - bonus lens picto, instead of the Bonus_Lens file
  @param {object} [deadbolt_icon] - Deadbolt picto, instead of the deadbolt file
{%- enddoc -%}

{%- liquid
  # One pass over the tags. The pipes stop "badge::ansi-z87" matching inside "badge::ansi-z87-2-plus"
  assign badge_tags = '|'
  for tag in product.tags
    assign tag_key = tag | downcase | strip
    if tag_key contains 'badge::'
      assign badge_tags = badge_tags | append: tag_key | append: '|'
    endif
  endfor
-%}

{%- if badge_tags contains '|badge::bonus-lens|' -%}
  {%- render 'spy-badge-image',
    image: bonus_lens_icon,
    fallback_file: 'Bonus_Lens.webp',
    alt: 'Bonus lens included',
    modifier: 'bonus-lens',
    width: 274,
    height: 284
  -%}
{%- endif -%}

{%- if badge_tags contains '|badge::deadbolt|' -%}
  {%- render 'spy-badge-image',
    image: deadbolt_icon,
    fallback_file: 'deadbolt.webp',
    alt: 'Deadbolt lens change system',
    modifier: 'deadbolt',
    width: 153,
    height: 153
  -%}
{%- endif -%}

{%- if badge_tags contains '|badge::happy-boost|' -%}
  {%- render 'spy-badge-image',
    image: happy_boost_icon,
    fallback_file: 'pictohappyboost.webp',
    alt: 'Happy Boost',
    modifier: 'hb',
    width: 153,
    height: 153
  -%}
{%- endif -%}

{%- if badge_tags contains '|badge::ansi-z87|' -%}
  {%- render 'spy-badge-image', fallback_file: 'ANSI_Z87.webp', alt: 'ANSI Z87', modifier: 'ansi', width: 50, height: 50 -%}
{%- endif -%}

{%- if badge_tags contains '|badge::ansi-z87-2-plus|' -%}
  {%- render 'spy-badge-image', fallback_file: 'ANSI_-Z87.webp', alt: 'ANSI Z87-2+', modifier: 'ansi', width: 50, height: 50 -%}
{%- endif -%}

{%- if badge_tags contains '|badge::cat-4|' -%}
  {%- render 'spy-badge-image', fallback_file: 'MurdrdOut-CAT4.svg', alt: 'Cat. 4 lens', modifier: 'cat-4', width: 80, height: 80 -%}
{%- endif -%}

{%- if badge_tags contains '|badge::not-for-driving|' -%}
  {%- render 'spy-badge-image',
    fallback_file: 'MurdrdOut-WARNING.svg',
    alt: 'Not for use while driving',
    modifier: 'not-for-driving',
    width: 80,
    height: 80
  -%}
{%- endif -%}

{%- if badge_tags contains '|badge::mips|' -%}
  {%- render 'spy-badge-image',
    image: mips_icon,
    fallback_file: 'mips.webp',
    alt: 'Mips',
    modifier: 'mips',
    width: 225,
    height: 225
  -%}
{%- endif -%}

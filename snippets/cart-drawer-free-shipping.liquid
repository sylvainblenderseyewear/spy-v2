{% doc %}
  Renders the cart drawer free-shipping goal: a progress track plus the
  remaining-spend or unlocked message.

  @example
  {% render 'cart-drawer-free-shipping' %}
{% enddoc %}

{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100
  assign show_goal = true
  if settings.cart_drawer_free_shipping == false or threshold <= 0 or cart.item_count == 0
    assign show_goal = false
  endif

  assign spent = cart.total_price
  assign remaining = threshold | minus: spent
  assign remaining_money = remaining | money
  assign percent = spent | times: 100 | divided_by: threshold
  if percent > 100
    assign percent = 100
  endif
-%}

{%- if show_goal -%}
  <div
    class="cart-drawer__free-shipping [display:flex] flex-col gap-2 px-4 pt-3 pb-1"
    role="status"
    aria-live="polite"
  >
    <p class="m-0 font-spy text-[14px] font-normal leading-[18px] text-spy-ink [&_b]:font-bold">
      {%- if remaining > 0 -%}
        {{ 'content.cart_free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'content.cart_free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>

    <div
      class="h-[6px] w-full overflow-hidden rounded-full bg-spy-mc-band"
      aria-hidden="true"
    >
      <span
        class="block h-full rounded-full bg-spy-orange-ui transition-[width] duration-300 ease-out"
        style="width: {{ percent }}%;"
      ></span>
    </div>
  </div>
{%- endif -%}

{%- doc -%}
  One PLP card for a whole model instead of one per colourway.

  Same shell, refs and class hooks as `product-card`, so everything the SPY card
  styling in tailwind.css does (square 10%-inset image, heavy uppercase title,
  reserved badge slot, hover swatch row, Quick View on hover) applies here
  unchanged. What differs: the title prints the model name from the group tag and
  the label prints the colourway count. Quick View opens the representative
  colourway, since the card itself stands for a model.

  Laid out in the source's three bands so the CSS can be plain geometry:
  `.spy-image-container` (image + Quick View + labels) is the hover zone, inside it
  `.spy-color-swatches` holds the label stack with the thumbnail row on top of it,
  and `.spy-tile-body` carries the title and price. Measurements for each band are
  in docs/superpowers/specs/2026-08-04-plp-product-card-pixel-perfect-design.md.

  @param {object} product - the colourway that represents the group
  @param {string} group_name - model name from the `collection: xxx` tag
  @param {number} group_count - colourway count to use when no model collection is found
  @param {object} [group_collection] - the model's collection, when the caller already holds it
  @param {object} [block] - calling block, for appearance + label settings
    (`card_per: 'colourway'` = one card per colourway, like the source homepage rail:
    colour name as the label, one thumbnail, this colourway's own badges and price)
  @param {string} [image_sizes] - sizes attribute for the card image
  @param {string} [product_view_context] - context passed to the view event

  @example
  {%- render 'spy-grouped-product-card',
    product: product,
    group_name: 'Cyrus',
    group_count: 23,
    block: block
  -%}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings

  assign title = group_name | strip
  if title == blank
    assign title = product.title
  endif

  assign target = product.selected_or_first_available_variant.url
  if target == blank
    assign target = product.url
  endif

  assign per_colourway = false
  if block_settings.card_per == 'colourway'
    assign per_colourway = true
  endif

  assign image_sizes = image_sizes | default: '(min-width: 750px) 50vw, 100vw'
  assign card_gap_value = block_settings.product_card_gap | default: 16
  assign media = product.selected_or_first_available_variant.featured_media | default: product.featured_media

  assign show_swatches = block_settings.show_swatches
  assign swatch_count = block_settings.swatch_count | default: 4

  # A card built from a collection is handed its model; the rest match on the group name
  assign model_collection = group_collection
  if per_colourway
    # This card is one colourway, so nothing reads the rest of the model
    assign model_collection = nil
  elsif model_collection == blank and group_name != blank
    assign group_key = group_name | handleize
    assign group_title = group_name | downcase | strip
    for col in product.collections
      assign col_title = col.title | downcase | strip
      if col.handle == group_key or col_title == group_title
        assign model_collection = col
        break
      endif
    endfor
  endif

  # Blenders-style colour list (frame + lens): the count and the thumbnails both read it
  assign count = group_count | plus: 0
  assign colour_entries = ''
  if model_collection != blank
    capture model_facts
      render 'spy-model-collection-facts', product: product, group_name: group_name, model_collection: model_collection
    endcapture
    assign model_facts = model_facts | strip | split: '~^~'
    assign list_count = model_facts[0] | plus: 0
    if list_count > 0
      assign count = list_count
      assign colour_entries = model_facts[2] | split: ','
    endif
  endif

  # Groups always hold at least the product in hand
  if count < 1
    assign count = 1
  endif

  if per_colourway
    capture count_label
      render 'spy-colourway-name', product: product
    endcapture
    assign count_label = count_label | strip
  elsif count == 1
    assign count_label = block_settings.label_colors_one | default: '1 color available'
  else
    assign count_label = block_settings.label_colors_many | default: '[count] colors available'
  endif
  assign count_label = count_label | replace: '[count]', count

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif
-%}

{%- liquid
  # Sticker art the block can swap; anything unset falls back to the shop's Files
  assign hb_icon = block_settings.happy_boost_icon
  assign mips_icon = block_settings.mips_icon
  assign bonus_lens_icon = block_settings.bonus_lens_icon
  assign deadbolt_icon = block_settings.deadbolt_icon
-%}

<product-card
  class="product-card spy-grouped-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  data-group-name="{{ title | escape }}"
  data-group-count="{{ count }}"
  id="product-card-{{ block.id }}-{{ product.id }}"
  {{ block.shopify_attributes }}
  {% # theme-check-disable-next-line UnknownFilter %}
  view-event-payload="{{ product | standard_event_data: 'view', context: product_view_context | escape }}"
>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: none;
      --quick-add-mobile-display: none;
      --quick-add-mobile-opacity: 0;
    "
  >
    {%- comment -%}
      Image band — the source's `.image-container`. Hovering anywhere in here swaps the
      label row for the colourway thumbnails; the text band below is deliberately outside,
      so hovering the title or price leaves the labels alone.
      The card-wide link lives in here too, so it covers the image and the label row but
      not the text band, which keeps the hover zone honest.
    {%- endcomment -%}
    <div class="spy-image-container">
      <a
        href="{{ target }}"
        class="product-card__link"
        ref="productCardLink"
      >
        <span class="visually-hidden">{{ title }}</span>
      </a>

      {%- comment -%}
        Stickers of the colourway on show, like the legacy tile: 11.2px from the top,
        5px from the right (the 70% scale under 544px is in src/tailwind.css)
      {%- endcomment -%}
      <spy-tech-badge class="spy-tech-badge absolute top-[11.2px] right-[5px] z-10 pointer-events-none">
        <span class="spy-tech-badge__current flex items-start gap-1" data-tech-current>
          {%- render 'spy-tech-badges',
            product: product,
            happy_boost_icon: hb_icon,
            mips_icon: mips_icon,
            bonus_lens_icon: bonus_lens_icon,
            deadbolt_icon: deadbolt_icon
          -%}
        </span>
      </spy-tech-badge>

      <div class="card-gallery" data-product-id="{{ product.id }}">
        <a
          class="contents"
          ref="cardGalleryLink"
          href="{{ target }}"
          aria-label="{{ title | escape }}"
        >
          {%- if media != blank -%}
            {{
              media
              | image_url: width: 1000
              | image_tag: sizes: image_sizes, widths: '200,300,400,500,600,800,1000', alt: title, loading: 'lazy'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          {%- endif -%}
        </a>
      </div>

      {%- comment -%}
        Quick View, revealed on card hover. Sits right after the gallery because the
        CSS pulls it up over the image bottom, so it costs the card no height at rest.
      {%- endcomment -%}
      {%- render 'spy-quick-view-button', product: product -%}

      {%- comment -%}
        Label band — the source's `.color-swatches`. One box holds the badge and the label
        stacked bottom-up, and the thumbnail row sits on top of them, so the swap on hover
        moves nothing below it.
      {%- endcomment -%}
      <div class="spy-color-swatches">
        <div class="spy-tile-labels">
          {%- comment -%} Badge slot always renders so every card keeps the same height {%- endcomment -%}
          {%- capture badge_text -%}{%- render 'spy-product-badge-text', product: product -%}{%- endcapture -%}
          <div class="spy-product-badge">
            {%- if badge_text != blank -%}
              <span class="spy-badge-pill border border-spy-orange-ui text-spy-orange-ui">{{ badge_text | strip }}</span>
            {%- endif -%}
          </div>

          <p class="spy-color-count m-0">{{ count_label }}</p>
        </div>

        {%- comment -%}
          Colourway thumbnails, revealed on hover in place of the label row (source behaviour:
          the labels fade out, this row fades in — same slot, so nothing below moves).
        {%- endcomment -%}
        {%- if show_swatches and per_colourway and media != blank -%}
          {%- comment -%} Source homepage tile: the one thumbnail is the colourway itself {%- endcomment -%}
          <div class="spy-swatches" data-spy-swatches>
            <a
              href="{{ target }}"
              class="spy-swatches__item"
              data-full="{{ media | image_url: width: 640 }}"
              aria-label="{{ title | escape }} — {{ count_label | escape }}"
            >
              <img
                src="{{ media | image_url: width: 240 }}"
                alt="{{ count_label | default: product.title | escape }}"
                width="42"
                height="26"
                loading="lazy"
              >
            </a>
          </div>
        {%- elsif show_swatches and colour_entries != blank -%}
          {%- assign tech_store = '' -%}
          {%- assign tech_keys = '|' -%}
          <div class="spy-swatches" data-spy-swatches>
            {%- for entry in colour_entries limit: swatch_count -%}
              {%- liquid
                assign entry_parts = entry | split: '.'
                assign p_idx = entry_parts[0] | plus: 0
                assign v_idx = entry_parts[1] | plus: 0
                assign colourway = model_collection.products[p_idx]
                assign colour_variant = colourway.variants[v_idx]
                assign colour_media = colour_variant.featured_media | default: colourway.featured_media

                # Frame from the title, lens from the variant
                assign colour_name = colourway.title
                for opt in colourway.options_with_values
                  assign opt_name = opt.name | downcase
                  if opt_name == 'lens'
                    assign lens_index = opt.position | minus: 1
                    assign lens_name = colour_variant.options[lens_index]
                    assign lens_lower = lens_name | downcase
                    unless lens_lower contains 'no lens' or lens_lower contains 'demo'
                      assign colour_name = colourway.title | append: ' - ' | append: lens_name
                    endunless
                    break
                  endif
                endfor
              -%}
              {%- if colour_media != blank -%}
                {%- comment -%}
                  Each thumbnail carries its frame's stickers, so hovering one swaps them with
                  the image. One set per frame, parked in a <template>.
                {%- endcomment -%}
                {%- assign tech_probe = '|' | append: colourway.id | append: '|' -%}
                {%- unless tech_keys contains tech_probe -%}
                  {%- assign tech_keys = tech_keys | append: colourway.id | append: '|' -%}
                  {%- capture tech_entry -%}
                    <span data-tech-key="{{ colourway.id }}">
                      {%- render 'spy-tech-badges',
                        product: colourway,
                        happy_boost_icon: hb_icon,
                        mips_icon: mips_icon,
                        bonus_lens_icon: bonus_lens_icon,
                        deadbolt_icon: deadbolt_icon
                      -%}
                    </span>
                  {%- endcapture -%}
                  {%- assign tech_store = tech_store | append: tech_entry -%}
                {%- endunless -%}

                <a
                  href="{{ colour_variant.url }}"
                  class="spy-swatches__item"
                  data-tech-key="{{ colourway.id }}"
                  data-full="{{ colour_media | image_url: width: 640 }}"
                  aria-label="{{ title | escape }} — {{ colour_name | escape }}"
                >
                  {%- comment -%} 240 covers the widest the thumb flexes to on a 3x screen {%- endcomment -%}
                  <img
                    src="{{ colour_media | image_url: width: 240 }}"
                    alt="{{ colour_name | escape }}"
                    width="42"
                    height="26"
                    loading="lazy"
                  >
                </a>
              {%- endif -%}
            {%- endfor -%}

            {%- if count > swatch_count -%}
              {%- comment -%}
                The source points this at the model's own page. Here the model collection
                is the page that lists them all.
              {%- endcomment -%}
              <a
                href="{{ model_collection.url }}"
                class="spy-swatches__more"
                aria-label="See all {{ count }} colors of {{ title | escape }}"
              >
                {%- comment -%} 32x10 arrow, the source's `.view-pdp-link svg` {%- endcomment -%}
                <svg width="32" height="10" viewBox="0 0 32 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M0.5 5H30.42" stroke="currentColor" stroke-miterlimit="10"></path>
                  <path d="M27.1 9.09L26.42 8.36L30.03 5L26.42 1.64L27.1 0.91L31.5 5L27.1 9.09Z" fill="currentColor"></path>
                </svg>
              </a>
            {%- endif -%}
          </div>

          {%- comment -%} Badge sets the hover script swaps in, one per thumbnail {%- endcomment -%}
          {%- if tech_store != blank -%}
            <template data-tech-store>{{ tech_store }}</template>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Text band — the source's `.tile-body`. Its padding and the gap between title and
      price live on this box, not on the blocks, so the two stay locked together.
    {%- endcomment -%}
    <div class="spy-tile-body">
      <a class="contents user-select-text" ref="productTitleLink" href="{{ target }}">
        <div class="text-block text-block--align-center rte" style="--width: 100%; --text-align: center;">
          <p role="heading" aria-level="3">{{ title }}</p>
        </div>
      </a>

      {%- if block_settings.show_price -%}
        <product-price
          class="spy-card-price text-block text-block--align-center rte"
          data-product-id="{{ product.id }}"
          style="--width: 100%; --text-align: center;"
        >
          {%- render 'spy-card-price',
            product: product,
            group_collection: model_collection,
            from_label: block_settings.label_price_from
          -%}
        </product-price>
      {%- endif -%}
    </div>
  </div>
</product-card>

{%- comment -%}
  Hovering a thumbnail previews that colourway: spy-card.js swaps the card image,
  spy-tech-badge.js swaps the badge to match.
{%- endcomment -%}
{%- if show_swatches and model_collection != blank -%}
  <script src="{{ 'spy-card.js' | asset_url }}" defer></script>
  <script src="{{ 'spy-tech-badge.js' | asset_url }}" defer></script>
{%- endif -%}

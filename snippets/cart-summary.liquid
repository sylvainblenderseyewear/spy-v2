{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
  @param {string} [context] - Render context — pass `'drawer'` to use the drawer's leaner summary.
  @param {boolean} [show_subtotal] - Page only. Pass false to drop the Subtotal row (source has none).
  @param {string} [shipping_label] - Page only. Optional shipping row label.
  @param {string} [shipping_value] - Page only. Text on the right of the shipping row.
  @param {string} [checkout_label] - Page only. Overrides the checkout button text.
  @param {boolean} [shipping_estimate] - Page only. Show the source's "Shipping" select with live rates.
  @param {string} [shipping_select_label] - Page only. Label above the select.
  @param {string} [estimate_country] - Page only. Estimate address override (else customer, else store).
  @param {string} [estimate_province] - Page only.
  @param {string} [estimate_zip] - Page only.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}

<div class="cart-totals {% if context == 'drawer' %}gap-0 pt-0 mt-0{% else %}w-full gap-0 p-0 m-0 border-0{% endif %}">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography {% if context == 'drawer' %}[&:not(:has(*))]:hidden{% endif %}">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <span class="cart-totals__item cart-totals__original">
        <span class="cart-totals__original-label">{{ 'content.cart_subtotal' | t }}</span>
        <span
          class="cart-totals__original-value cart-secondary-typography"
          data-testid="cart-subtotal-value"
        >
          {{- cart.items_subtotal_price | money -}}
        </span>
      </span>
      <ul
        class="cart-discounts"
        role="list"
        aria-label="{{ 'content.discounts' | t }}"
      >
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="cart-discounts__item">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount.title | escape }}
            </span>
            <span class="cart-discounts__value cart-secondary-typography"
              >-{{ discount.total_allocated_amount | money -}}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}
      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}
      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor

          assign discount_codes = discount_codes | uniq

          # Evaluate the boolean expression for the disclosure state
          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        %}

        {% capture cart_discount_accordion_children %}
          <details
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">{{ 'content.discount' | t }}</span>

              <span class="cart-totals__icon">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>

            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component
                  {% if section_id != blank %}
                    data-section-id="{{ section_id }}"
                  {% endif %}
                >
                  <div class="cart-discount__content">
                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>
                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                        data-skip-node-update
                      >
                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="cart-discount__codes">
                    {% for discount_code in discount_codes %}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          {{ discount_code }}
                        </p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: cart_discount_accordion_children, class: 'cart-discount' %}
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif
  -%}

  <div class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}{% if context != 'drawer' %} gap-0{% endif %}">
    {%- comment -%}
      Source always shows a subtotal above the total. Horizon only prints one when a
      cart-level discount exists (`cart-totals__original` above), so this covers the
      plain case and hides itself when that one is already on screen.
    {%- endcomment -%}
    {%- liquid
      assign show_subtotal_row = true
      if context == 'drawer' and settings.cart_drawer_show_subtotal != true
        assign show_subtotal_row = false
      endif
      if context != 'drawer' and show_subtotal == false
        assign show_subtotal_row = false
      endif
    -%}
    {%- if cart.cart_level_discount_applications.size == 0 and show_subtotal_row -%}
      <span class="cart-totals__item spy-cart-totals__subtotal{% if context != 'drawer' %} [display:flex] justify-between items-baseline gap-4 m-0 mb-2 p-0 text-[16px] leading-[22.4px] text-spy-ink{% endif %}">
        <span class="cart-totals__original-label cart-primary-typography">
          {{- 'content.cart_subtotal' | t -}}
        </span>
        <span class="cart-totals__original-value cart-secondary-typography">
          {{- cart.items_subtotal_price | money -}}
        </span>
      </span>
    {%- endif -%}

    {%- comment -%}
      Source has a shipping row here. Shopify only knows the rate at checkout,
      so the page shows an editable label + note instead of a price.
    {%- endcomment -%}
    {%- if context != 'drawer' and shipping_estimate -%}
      {%- liquid
        # Estimate address: signed-in customer, then theme setting, then the store itself
        assign est_country = shop.address.country
        assign est_province = shop.address.province
        assign est_zip = shop.address.zip
        if estimate_country != blank
          assign est_country = estimate_country
          assign est_province = estimate_province
          assign est_zip = estimate_zip
        endif
        if customer.default_address
          assign est_country = customer.default_address.country
          assign est_province = customer.default_address.province
          assign est_zip = customer.default_address.zip
        endif
      -%}
      <script src="{{ 'spy-cart-shipping.js' | asset_url }}" type="module"></script>
      <spy-shipping-estimate
        class="block"
        data-country="{{ est_country | escape }}"
        data-province="{{ est_province | escape }}"
        data-zip="{{ est_zip | escape }}"
        data-money-format="{{ shop.money_format | strip_html | escape }}"
        data-currency="{{ cart.currency.iso_code }}"
        data-total="{{ cart.total_price }}"
      >
        {%- comment -%} Source: 16px label, 36px select, 16px under the group {%- endcomment -%}
        <div class="mb-4">
          <label class="block m-0 text-[16px] leading-[22.4px] text-spy-ink" for="spy-shipping-method">
            {{- shipping_select_label -}}
          </label>
          <div class="relative">
            <select
              id="spy-shipping-method"
              class="block w-full h-9 m-0 pt-[6.4px] pb-[6.4px] pl-1 pr-2 border border-spy-border rounded-none bg-transparent shadow-none appearance-none text-[13px] leading-[18.2px] text-spy-ink cursor-default transition-[background-color,border-color,box-shadow] duration-150 ease-[ease-in-out] focus:border-black focus:outline-none"
              data-shipping-select
            >
              <option>{{ shipping_value }}</option>
            </select>
            <svg class="absolute right-0 top-1/2 -translate-y-1/2 size-[13px] max-w-none pointer-events-none text-spy-gray" aria-hidden="true" focusable="false" viewBox="0 0 26 26"><path fill="currentColor" d="M4 9h18l-9 9z"/></svg>
          </div>
        </div>
        {%- if shipping_label != blank -%}
          <span class="cart-totals__item spy-cart-totals__shipping [display:flex] justify-between items-baseline gap-4 m-0 mb-2 p-0 text-[16px] leading-[22.4px] text-spy-ink">
            <span>{{ shipping_label }}</span>
            <span class="text-right" data-shipping-cost>{{ shipping_value }}</span>
          </span>
        {%- endif -%}
      </spy-shipping-estimate>
    {%- elsif context != 'drawer' and shipping_label != blank -%}
      <span class="cart-totals__item spy-cart-totals__shipping [display:flex] justify-between items-baseline gap-4 m-0 mb-2 p-0 text-[16px] leading-[22.4px] text-spy-ink">
        <span>{{ shipping_label }}</span>
        <span class="text-right">{{ shipping_value }}</span>
      </span>
    {%- endif -%}

    <span
      class="cart-totals__item cart-totals__total {% if context == 'drawer' %}my-4{% else %}[display:flex] justify-between items-baseline gap-4 m-0 mb-2 p-0 text-[16px] leading-[22.4px] text-spy-ink{% endif %}"
      role="status"
    >
      <span class="cart-totals__total-label cart-primary-typography {% if context == 'drawer' %}text-[16px] font-semibold leading-[22.4px] text-spy-ink{% else %}text-[16px] font-bold leading-[22.4px]{% endif %}">{{ 'content.cart_estimated_total' | t }}</span>
      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart-totals__total-value cart-secondary-typography {% if context == 'drawer' %}text-[16px] font-semibold leading-[22.4px] text-spy-ink{% else %}text-[16px] font-normal leading-[22.4px] text-right{% endif %}"
        {% comment %} Used by payment_terms web component {% endcomment %}
        data-testid="cart-total-value"
        data-cart-subtotal
      >
        {{ total_price }}
      </text-component>
    </span>
    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
    {%- if context != 'drawer' or settings.cart_drawer_show_tax_note -%}
      <div class="cart-totals__item cart-totals__tax-note cart-primary-typography{% if context != 'drawer' %} hidden{% endif %}">
        {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="cart__ctas {% if context == 'drawer' %}gap-0{% else %}w-full mt-4{% endif %}">
  {%- liquid
    assign cta_to_cart = false
    if context == 'drawer' and settings.cart_drawer_cta_target == 'cart'
      assign cta_to_cart = true
    endif
  -%}
  {%- if cta_to_cart -%}
    {%- comment -%} Source sends shoppers to the cart page, not straight to checkout {%- endcomment -%}
    <a
      href="{{ routes.cart_url }}"
      id="checkout"
      class="cart__checkout-button button{% if cart == empty %} is-disabled{% endif %} [display:flex] items-center justify-center w-full min-h-[51px] p-4 rounded-none text-[12px] font-normal leading-[16.8px] tracking-normal uppercase no-underline border border-spy-orange-ui {% if settings.cart_drawer_cta_style == 'outline' %}bg-transparent text-spy-orange-ui{% else %}bg-spy-orange-ui text-white{% endif %} hover:bg-spy-cta-hover hover:border-spy-cta-hover hover:text-white [&.is-disabled]:pointer-events-none [&.is-disabled]:opacity-50 [&[disabled]]:pointer-events-none [&[disabled]]:opacity-50"
      role="button"
      {% if cart == empty %}
        aria-disabled="true"
        tabindex="-1"
      {% endif %}
    >
      <span class="button-text">
        {{ 'content.cart_drawer_cta' | t }}
      </span>
    </a>
  {%- else -%}
    <button
      type="submit"
      id="checkout"
      class="cart__checkout-button button {% if context == 'drawer' %}[display:flex] items-center justify-center w-full min-h-[51px] p-4 rounded-none text-[12px] font-normal leading-[16.8px] tracking-normal uppercase no-underline border border-spy-orange-ui {% if settings.cart_drawer_cta_style == 'outline' %}bg-transparent text-spy-orange-ui{% else %}bg-spy-orange-ui text-white{% endif %} hover:bg-spy-cta-hover hover:border-spy-cta-hover hover:text-white [&.is-disabled]:pointer-events-none [&.is-disabled]:opacity-50 [&[disabled]]:pointer-events-none [&[disabled]]:opacity-50{% else %}[display:flex] items-center justify-center gap-0 w-full min-h-[54px] m-0 p-4 rounded-none shadow-none border border-spy-orange-ui bg-spy-orange-ui text-white text-[14px] font-normal leading-[19.6px] tracking-normal uppercase transition-colors duration-150 ease-[ease-in-out] hover:bg-spy-cta-hover hover:border-spy-cta-hover hover:text-white{% endif %}"
      name="checkout"
      {% if cart == empty %}
        disabled
      {% endif %}
      form="cart-form"
    >
      <span class="button-text">
        {%- if context != 'drawer' and checkout_label != blank -%}
          {{ checkout_label }}
        {%- else -%}
          {{ 'content.checkout' | t }}
        {%- endif -%}
      </span>
    </button>
  {%- endif -%}

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }
{% endstylesheet %}

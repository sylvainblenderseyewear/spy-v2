{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif

  # Slider works in whole currency units: 0 to the top price, rounded up.
  # Shopify exposes no collection price floor in Liquid, so the low end is 0.
  assign slider_top = filter.range_max | divided_by: 100.0 | ceil
  if slider_top < 1
    assign slider_top = 1
  endif

  assign slider_low = 0
  if filter.min_value.value != null
    assign slider_low = filter.min_value.value | divided_by: 100
  endif
  assign slider_high = slider_top
  if filter.max_value.value != null
    assign slider_high = filter.max_value.value | divided_by: 100.0 | ceil
  endif
  if slider_high > slider_top
    assign slider_high = slider_top
  endif
  if slider_low > slider_high
    assign slider_low = slider_high
  endif

  # Track fill, as a 0-1 share of the track
  assign slider_low_share = slider_low | times: 1.0 | divided_by: slider_top
  assign slider_high_share = slider_high | times: 1.0 | divided_by: slider_top
  assign slider_low_cents = slider_low | times: 100
  assign slider_high_cents = slider_high | times: 100

  # Stable key so the open/closed state survives a section re-render
  assign filter_param_name = filter.param_name | escape | replace: '.', '-'

  # Hidden gte/lte fields: empty means "no bound", so the full range sends nothing
  assign min_input_value = ''
  if filter.min_value.value != null
    assign min_input_value = slider_low
  endif
  assign max_input_value = ''
  if filter.max_value.value != null
    assign max_input_value = slider_high
  endif
-%}
{% capture accordion_children %}
  <details
    class="facets__panel{% if is_vertical %} group mb-6{% endif %}"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
  >
    <summary
      class="
        facets__summary
        {%- if is_vertical %} mb-2 cursor-pointer select-none list-none items-center justify-between gap-3 border-b border-solid border-b-spy-ink pb-2 [&::-webkit-details-marker]:hidden{% endif %}
      "
      data-testid="price-filter"
    >
      <span
        class="
          facets__label
          {%- if is_vertical %} me-0 text-[16px] font-semibold uppercase leading-[1.4] text-spy-ink{% endif %}
        "
      >
        {{- filter.label -}}
      </span>

      {% if is_vertical %}
        <span
          class="relative block h-2.5 w-2.5 shrink-0"
          aria-hidden="true"
        >
          <span class="absolute left-0 top-1 block h-0.5 w-2.5 bg-spy-ink"></span><span class="absolute left-1 top-0 block h-2.5 w-0.5 bg-spy-ink group-open:hidden"></span>
        </span>
      {% endif %}

      <facet-status-component class="facets__status{% if is_vertical %} hidden{% endif %}">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      {% unless is_vertical %}
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      {% endunless %}
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-custom-popover{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        {% unless is_vertical %}
          on:change="/updatePriceFilterAndResults"
        {% endunless %}
      >
        {% if is_vertical %}
          {%- liquid
            # Same thumb on both sliders; they sit on top of each other
            capture range_input_class
              echo 'pointer-events-none absolute inset-0 m-0 h-6 w-full cursor-pointer appearance-none bg-transparent p-0 focus-visible:outline-none'
              echo ' [&::-webkit-slider-runnable-track]:bg-transparent [&::-moz-range-track]:bg-transparent'
              echo ' [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-solid [&::-webkit-slider-thumb]:border-spy-ink [&::-webkit-slider-thumb]:bg-white'
              echo ' [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-3 [&::-moz-range-thumb]:w-3 [&::-moz-range-thumb]:cursor-pointer [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-2 [&::-moz-range-thumb]:border-solid [&::-moz-range-thumb]:border-spy-ink [&::-moz-range-thumb]:bg-white'
              echo ' focus-visible:[&::-webkit-slider-thumb]:outline-2 focus-visible:[&::-webkit-slider-thumb]:outline-offset-2 focus-visible:[&::-webkit-slider-thumb]:outline-spy-ink'
              echo ' focus-visible:[&::-moz-range-thumb]:outline-2 focus-visible:[&::-moz-range-thumb]:outline-offset-2 focus-visible:[&::-moz-range-thumb]:outline-spy-ink'
            endcapture
          -%}
          {% comment %} Two-thumb slider; the real gte/lte fields ride along hidden {% endcomment %}
          <div class="facets__inputs-wrapper my-0 py-0">
            <div
              class="relative h-6"
              ref="rangeTrack"
              style="--lo: {{ slider_low_share }}; --hi: {{ slider_high_share }};"
            >
              <span
                class="absolute inset-x-2 top-1/2 block h-0.5 -translate-y-1/2 bg-spy-border"
                aria-hidden="true"
              ></span>
              <span
                class="absolute top-1/2 block h-0.5 -translate-y-1/2 bg-spy-ink left-[calc(0.5rem_+_(100%_-_1rem)_*_var(--lo))] right-[calc(0.5rem_+_(100%_-_1rem)_*_(1_-_var(--hi)))]"
                aria-hidden="true"
              ></span>

              <input
                type="range"
                class="{{ range_input_class }}"
                min="0"
                max="{{ slider_top }}"
                step="1"
                value="{{ slider_low }}"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
                aria-valuetext="{{ slider_low_cents | money | strip_html | escape }}"
                ref="minRange"
                on:input="/previewPriceRange"
                on:change="/commitPriceRange"
              >
              <input
                type="range"
                class="{{ range_input_class }}"
                min="0"
                max="{{ slider_top }}"
                step="1"
                value="{{ slider_high }}"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
                aria-valuetext="{{ slider_high_cents | money | strip_html | escape }}"
                ref="maxRange"
                on:input="/previewPriceRange"
                on:change="/commitPriceRange"
              >
            </div>

            {% comment %} Source prints the range as "25.00 - 340.01" {% endcomment %}
            <p
              class="m-0 mt-1 text-[16px] leading-[22.4px] text-spy-ink"
              ref="rangeLabel"
            >
              {{- slider_low_cents | money_without_currency }} - {{ slider_high_cents | money_without_currency -}}
            </p>

            <input
              type="hidden"
              name="{{ filter.min_value.param_name }}"
              value="{{ min_input_value }}"
              ref="minInput"
            >
            <input
              type="hidden"
              name="{{ filter.max_value.param_name }}"
              value="{{ max_input_value }}"
              ref="maxInput"
            >
          </div>
        {% else %}
        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- assign formatted_highest_price = filter.range_max | money -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>
        {% endif %}

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% comment %} Source panel ships every facet collapsed — no open_by_default here {% endcomment %}
{%- if is_horizontal -%}{%- assign filter_role = 'listitem' -%}{%- else -%}{%- assign filter_role = nil -%}{%- endif -%}
{% render 'accordion-custom-component',
  role: filter_role,
  children: accordion_children,
  class: 'facets__item',
  open: false,
  open_by_default_on_desktop: false,
  open_by_default_on_mobile: false,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal,
  data_filter_param_name: filter_param_name
%}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: right;
    padding-left: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    color: var(--color-foreground-muted);
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }
{% endstylesheet %}

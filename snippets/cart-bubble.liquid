{%- doc -%}
  @param [limit] - {number}

  The maximum number of items to display. Anything above shows as "99+".

  Colors: reads --cart-bubble-background / --cart-bubble-text from an ancestor. Falls back to a contrasting pair
  computed from the palette foreground when unset.
{%- enddoc -%}

{% liquid
  assign bubble_bg_fallback = settings.page_text_color
  assign bubble_text_fallback = settings.page_background_color
%}

<div
  ref="cartBubble"
  class="cart-bubble{% if cart == empty %} visually-hidden{% endif %}"
  style="--cart-bubble-background-fallback: {{ bubble_bg_fallback }}; --cart-bubble-text-fallback: {{ bubble_text_fallback }};"
  {% assign item_count = cart.item_count %}
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
  >
    <span
      class="cart-bubble__text-count{% if cart == empty %} hidden{% endif %}"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or cart.item_count < limit %}
        {{- cart.item_count -}}
      {%- endif -%}
    </span>
  </span>
</div>

{% stylesheet %}
  .cart-bubble {
    --cart-padding: 0.2em;

    position: relative;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    border-width: 0;
    display: flex;
    line-height: normal;
    align-items: center;
    justify-content: center;
    color: var(--cart-bubble-text, var(--cart-bubble-text-fallback));
    padding-inline: var(--cart-padding);
  }

  .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
  }

  .cart-bubble[data-maintain-ratio] .cart-bubble__background {
    border-radius: var(--style-border-radius-50);
  }

  .cart-bubble__background {
    position: absolute;
    inset: 0;
    background-color: var(--cart-bubble-background, var(--cart-bubble-background-fallback));
    border-radius: var(--style-border-radius-lg);
  }

  .cart-bubble__text {
    font-size: var(--font-size--3xs);
    z-index: var(--layer-flat);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* SPY header badge — small outlined circle at the bag's top-right.
     Measured from the source: 1.3em box, .9rem text, 1px #1d2a2b ring on white.
     Absolute so it never adds width to the button (in-flow it overflowed the
     36px button and the icon looked cut off). Scoped to cart-icon so the cart
     page title keeps its own inline badge. */
  cart-icon {
    position: relative;
  }

  cart-icon .cart-bubble {
    --cart-padding: 0;

    position: absolute;
    top: -0.35em;
    right: -0.9em;
    width: 1.3em;
    height: 1.3em;
    font-size: 0.9rem;
    border: 1px solid #1d2a2b;
    border-radius: 50%;
    background: #fff;
    color: #1d2a2b;
    pointer-events: none;
  }

  cart-icon .cart-bubble__background {
    background: none;
  }

  cart-icon .cart-bubble__text {
    font-size: 1em;
  }

  /* Small pop when the count changes. Also lets cart-icon.js finish its
     await on the animation, so it clears the animating class. */
  @keyframes spy-cart-bubble-pop {
    0% {
      transform: scale(0.6);
    }

    60% {
      transform: scale(1.15);
    }

    100% {
      transform: scale(1);
    }
  }

  cart-icon .cart-bubble--animating .cart-bubble__text {
    animation: spy-cart-bubble-pop 0.3s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    cart-icon .cart-bubble--animating .cart-bubble__text {
      animation: none;
    }
  }
{% endstylesheet %}

{%- doc -%}
  SPY card rail, used by every product and collection carousel. One behaviour, run by
  <spy-slider> (assets/spy-slider.js):
  - 1 card per arrow click in 300ms; arrows from 769px, outside the cards; swipe below
  - loops when the rail plays by itself, or on phones when the centred card shows its neighbours
  - cards that all fit sit centred or on the left (the section's "Cards that fit in one row")

  @param {object} slides - An array of HTML for the slides to display in the carousel
  @param {object} settings - The block or sections settings from the parent block/section.

  @example
  {% render 'resource-list-carousel', slides: slides, settings: section.settings %}
{%- enddoc -%}

{%- liquid
  # Page-width rails line up with the page; full-width ones keep 16px off the screen edge from 992px
  if settings.section_width == 'page-width'
    assign rail_edge = '[--gutter-slide-width:var(--util-page-margin-offset)]'
  else
    assign rail_edge = '[--gutter-slide-width:0px] min-[992px]:[--gutter-slide-width:16px]'
  endif

  assign rail_cols = settings.columns | default: 4
  assign rail_auto = 0
  assign rail_loop = 0
  if settings.carousel_autoplay
    assign rail_auto = settings.carousel_autoplay_speed | default: 3 | times: 1000
    assign rail_loop = 1
  endif
  # A centred phone rail with peeks loops there, so a card always shows on both sides
  assign rail_loop_phone = rail_loop
  if settings.mobile_peek > 0 and slides.size > 1
    assign rail_loop_phone = 1
  endif
  assign rail_dots = 0
  if settings.mobile_dots
    assign rail_dots = 1
  endif

  # By window width: up to 540, 541-768, 769 and up. JSON lives in an assign: Shopify cuts {{ }} at the first brace
  assign rail_opts = '{"speed":300,"step":1,"bp":[540,768],"loop":[' | append: rail_loop_phone | append: ',' | append: rail_loop | append: ',' | append: rail_loop | append: '],"arrows":[0,0,1],"dots":[' | append: rail_dots | append: ',0,0],"autoplay":' | append: rail_auto | append: '}'

  # More cards than fit: 50px margins for the arrows. Set here for desktop, the engine keeps it right per width
  assign rail_more = false
  if slides.size > rail_cols
    assign rail_more = true
  elsif rail_loop == 1 and slides.size > 1
    assign rail_more = true
  endif
-%}

<div
  class="{{ rail_edge }}"
  style="--spy-peek: {{ settings.mobile_peek | default: 0 }}px; --spy-s1: 100%; --spy-s2: calc(100% / 2); --spy-s3: calc(100% / 3); --spy-s4: calc(100% / {{ rail_cols }});"
>
  {%- comment -%}
    Whole cards only, edge to edge (a margin, not padding, so the loop's copies never peek in).
    Arrows sit in that margin, off the cards. Phones can centre the card with a peek either side.
  {%- endcomment -%}
  <spy-slider
    class="relative block [--spy-rail-edge:var(--gutter-slide-width)] min-[769px]:data-[arrows]:[--spy-rail-edge:max(var(--gutter-slide-width),50px)]"
    {% if rail_more %}data-arrows{% endif %}
    data-opts="{{ rail_opts | escape }}"
  >
    {%- render 'spy-slider-arrow', dir: 'prev', class: 'absolute left-[max(0px,calc(var(--spy-rail-edge)_-_50px))] top-1/2 z-[2] -translate-y-1/2' -%}
    <div
      data-track
      class="[display:flex] overflow-x-auto snap-x snap-mandatory select-none [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [&[data-dragging]_a]:pointer-events-none [&[data-dragging]_button]:pointer-events-none [&_img]:[-webkit-user-drag:none] mx-[var(--spy-rail-edge)] max-[541px]:px-[var(--spy-peek)] max-[541px]:scroll-px-[var(--spy-peek)]{% if settings.fit_align != 'start' %} justify-center-safe{% endif %}"
    >
      {%- for item in slides -%}
        <div class="shrink-0 grow-0 min-w-0 snap-start max-[541px]:snap-center basis-[var(--spy-s1)] min-[541px]:basis-[var(--spy-s2)] min-[721px]:basis-[var(--spy-s3)] min-[1141px]:basis-[var(--spy-s4)] px-[calc(var(--resource-list-column-gap,0px)/2)]">
          {{ item }}
        </div>
      {%- endfor -%}
    </div>
    {%- render 'spy-slider-arrow', dir: 'next', class: 'absolute right-[max(0px,calc(var(--spy-rail-edge)_-_50px))] top-1/2 z-[2] -translate-y-1/2' -%}
    <div
      data-dots
      data-off
      data-dot-label="{{ 'accessibility.slide_status' | t: index: '[i]', length: '[n]' | escape }}"
      class="[display:flex] data-[off]:hidden absolute inset-x-0 bottom-4 items-center justify-center gap-2"
      role="group"
      aria-label="{{ 'accessibility.slideshow' | t | escape }}"
    ></div>
  </spy-slider>
</div>
<script src="{{ 'spy-slider.js' | asset_url }}" type="module"></script>

{%- doc -%}
  PDP colour picker — one 56px thumb per colourway, current one outlined,
  sold-out ones faded with the diagonal bar. Shared by the PDP swatch block and
  the quick view dialog.

  Colourways come from the product's colour option when it has more than one
  value (combined listing). Staging has one product per frame with lenses as
  variants instead, so the list is every frame of the model's own collection
  (found by the `collection::MODEL` tag) times its lenses, like the source's
  frame + lens colour row. No model collection: this product's own lenses.

  That list covers every lens, so the container says so with `data-spy-colourways`
  and the PDP and quick view hide their lens buttons. A hidden `data-spy-one-size`
  marker inside means the picked colourway comes in one size, so the size buttons
  go too (spy-frame-colourways).

  @param {object} product - Product the picker belongs to
  @param {string} [wrapper_class] - Replaces the default top margin
  @param {string} [shopify_attributes] - Block attributes, when a block renders it

  @example
  {%- render 'spy-color-picker', product: closest.product -%}
{%- enddoc -%}

{%- liquid
  assign p = product

  assign color_option = nil
  if p != blank
    for opt in p.options_with_values
      assign opt_lower = opt.name | downcase
      if opt_lower == 'frame color' or opt_lower == 'color' or opt_lower == 'colour'
        assign color_option = opt
        break
      endif
    endfor
  endif

  assign has_option_colors = false
  if color_option != nil and color_option.values.size > 1
    assign has_option_colors = true
  endif

  comment
    No real colour option — use the model's collection, matched on the
    `collection::MODEL` tag the way the grouped card does. "First collection that is
    not a category" picked curated ones (Men's Sunglasses, Blue Light Glasses) and
    filled the picker with other models.
  endcomment
  assign model_col = nil
  if has_option_colors == false and p != blank
    capture group_name
      render 'spy-group-name', product: p
    endcapture
    assign group_name = group_name | strip
    if group_name != blank
      assign group_key = group_name | handleize
      assign group_title = group_name | downcase
      for col in p.collections
        assign col_title = col.title | downcase | strip
        if col.handle == group_key or col_title == group_title
          assign model_col = col
          break
        endif
      endfor
    endif
  endif
-%}

{%- if p != blank -%}
{%- liquid
  assign swatch_base = 'spy-swatches__item relative block h-14 w-14 rounded-[2px] bg-white overflow-hidden'
  # Links take the outline from aria-current, so the PDP can mark a pick before the swap lands
  assign swatch_link = swatch_base | append: ' border border-[color:var(--color-spy-border)] aria-[current=true]:border-2 aria-[current=true]:border-[color:var(--color-spy-text)]'
  comment
    Sold-out colourway: half-faded with a thin diagonal bar across the thumb,
    same as the source's .swatch-not-orderable (69x2px, 45deg, #f2f2f2).
  endcomment
  assign swatch_oos = ' spy-swatches__item--oos opacity-50 after:content-[""] after:absolute after:block after:top-[25px] after:-left-2 after:h-[2px] after:w-[69px] after:rotate-45 after:bg-[#f2f2f2] after:pointer-events-none'

  unless has_option_colors
    # The picked colourway: its lens marks the current swatch, its size is kept on a switch
    assign own = p.selected_or_first_available_variant
    assign own_lens = '-'
    assign own_size = ''
    for opt in p.options_with_values
      assign opt_lower = opt.name | downcase
      unless opt_lower == 'lens' or opt_lower == 'size'
        continue
      endunless
      case opt.position
        when 1
          assign own_value = own.option1
        when 2
          assign own_value = own.option2
        when 3
          assign own_value = own.option3
      endcase
      if opt_lower == 'lens'
        assign own_lens = own_value | downcase | split: ' ' | join: ' '
        if own_lens == blank or own_lens contains 'no lens' or own_lens contains 'demo'
          assign own_lens = '-'
        endif
      else
        assign own_size = own_value | downcase | replace: '-', ' ' | split: ' ' | join: ' '
      endif
    endfor

    # The model collection lists the page's frame; render it alone if it ever falls outside
    assign own_listed = false
    if model_col != nil
      for sp in model_col.products
        if sp.id == p.id
          assign own_listed = true
          break
        endif
      endfor
    endif
  endunless
-%}
<div
  class="spy-swatches flex flex-wrap items-center gap-2 aria-busy:cursor-progress {{ wrapper_class | default: 'mt-[22px]' }}"
  {% unless has_option_colors %}data-spy-colourways{% endunless %}
  {{ shopify_attributes }}
>
  {%- if has_option_colors -%}
    {%- for v in color_option.values -%}
      {%- assign media = v.variant.featured_media | default: p.featured_media -%}
      {%- if media != blank -%}
        {%- liquid
          assign cls = swatch_link
          comment
            A colour with no orderable variant counts as sold out.
          endcomment
          assign v_available = false
          if v.variant.available
            assign v_available = true
          endif
          unless v_available
            assign cls = cls | append: swatch_oos
          endunless
        -%}
        <a
          href="{{ v.variant.url | default: p.url }}"
          class="{{ cls }}"
          {% if v.selected %}aria-current="true"{% endif %}
          {% unless v_available %}data-spy-oos aria-describedby="spy-oos-note"{% endunless %}
          aria-label="{{ p.title | escape }} – {{ v.name | escape }}{% unless v_available %} ({{ 'products.product.sold_out' | t }}){% endunless %}"
        >
          <img
            src="{{ media | image_url: width: 160 }}"
            alt="{{ v.name | escape }}"
            width="56"
            height="56"
            loading="lazy"
            class="m-auto block h-[90%] w-[90%] object-contain"
          >
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} Collection order, then each frame's lenses in variant order; a pick stays in place {%- endcomment -%}
    {%- unless own_listed -%}
      {%- render 'spy-frame-colourways',
        product: p,
        current: true,
        current_lens: own_lens,
        current_size: own_size,
        link_class: swatch_link,
        oos_class: swatch_oos
      -%}
    {%- endunless -%}
    {%- if model_col != nil -%}
      {%- for sp in model_col.products -%}
        {%- liquid
          assign is_own = false
          if sp.id == p.id
            assign is_own = true
          endif
        -%}
        {%- render 'spy-frame-colourways',
          product: sp,
          current: is_own,
          current_lens: own_lens,
          current_size: own_size,
          link_class: swatch_link,
          oos_class: swatch_oos
        -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
</div>
{%- endif -%}

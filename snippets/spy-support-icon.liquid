{%- comment -%}
  Outline icons for the SPY support menu — thin single-stroke shapes that match
  the source's Font Awesome look. Inline SVG keeps them recolorable via
  `currentColor`, so a row can flip to white on the black selected state.

  Usage: {% render 'spy-support-icon', icon: 'envelope', class: 'w-5 h-5' %}
{%- endcomment -%}

{%- capture icon_body -%}
  {%- case icon -%}
    {%- when 'envelope' -%}
      <rect x="2.75" y="5.25" width="18.5" height="13.5" rx="1.25" /><path d="m3.5 6.5 8.5 6.25L20.5 6.5" />
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="3.4" /><path d="M4.8 20c.6-3.7 3.6-6 7.2-6s6.6 2.3 7.2 6" />
    {%- when 'question' -%}
      <circle cx="12" cy="12" r="9.25" /><path d="M9.5 9.4a2.6 2.6 0 0 1 5.1.8c0 1.7-2.5 2-2.5 3.6" /><path
        d="M12 17.1h.01"
        stroke-width="2"
      />
    {%- when 'sparkle' -%}
      <path d="M12 3c.5 4.3 1.7 5.5 6 6-4.3.5-5.5 1.7-6 6-.5-4.3-1.7-5.5-6-6 4.3-.5 5.5-1.7 6-6Z" />
    {%- when 'shield' -%}
      <path d="M12 2.9l7.5 2.6v5.9c0 4.3-3 7.4-7.5 9.2-4.5-1.8-7.5-4.9-7.5-9.2V5.5z" /><path
        d="m8.7 11.9 2.3 2.3 4.3-4.3"
      />
    {%- when 'bag' -%}
      <path d="M5.6 7.8h12.8l.9 12.4H4.7z" /><path d="M9 7.8a3 3 0 0 1 6 0" />
    {%- when 'tag' -%}
      <path d="M12.6 3.6H20v7.4l-8.7 8.7a1 1 0 0 1-1.4 0L4 13.6a1 1 0 0 1 0-1.4z" /><circle cx="16.4" cy="7.2" r="1.3" />
    {%- when 'truck' -%}
      <path d="M2.8 6.4h10.4v9H2.8z" /><path d="M13.2 9.4h3.5l2.5 3v3h-6z" /><circle cx="7" cy="17.6" r="1.6" /><circle
        cx="16.4"
        cy="17.6"
        r="1.6"
      />
    {%- when 'chat' -%}
      <path
        d="M20.5 12.4c0 3.6-3.8 6.5-8.5 6.5-1 0-2-.1-2.9-.4l-4.6 2 1.4-3.4c-1.5-1.2-2.4-2.9-2.4-4.7 0-3.6 3.8-6.5 8.5-6.5s8.5 2.9 8.5 6.5Z"
      />
    {%- when 'pin' -%}
      <path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.6" />
    {%- when 'phone' -%}
      <path
        d="M8.1 3.5H5.9A2.4 2.4 0 0 0 3.5 6c.4 8 6.5 14.1 14.5 14.5a2.4 2.4 0 0 0 2.5-2.4v-2.2l-4.4-1.6-2 2a15 15 0 0 1-4.4-4.4l2-2z"
      />
    {%- when 'star' -%}
      <path d="m12 3.6 2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L3.4 9.9l6-.8z" />
  {%- endcase -%}
{%- endcapture -%}

{%- if icon_body != blank -%}
  <svg
    class="{{ class }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {{ icon_body }}
  </svg>
{%- endif -%}

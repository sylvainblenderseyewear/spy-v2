<link rel="preload" as="font" type="font/woff" href="{{ 'DINNextLTPro-Regular.woff' | asset_url }}" crossorigin>
<link rel="preload" as="font" type="font/woff" href="{{ 'DINNextLTPro-Bold.woff' | asset_url }}" crossorigin>
<style>
  {%- comment -%} Real DIN Next LT Pro — brand font (Layer 1) {%- endcomment -%}
  @font-face {
    font-family: "DINNextLTPro";
    src: url("{{ 'DINNextLTPro-Light.woff' | asset_url }}") format("woff");
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "DINNextLTPro";
    src: url("{{ 'DINNextLTPro-Regular.woff' | asset_url }}") format("woff");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "DINNextLTPro";
    src: url("{{ 'DINNextLTPro-Bold.woff' | asset_url }}") format("woff");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  {%- comment -%} D-DIN kept as fallback for any weight DIN Next lacks {%- endcomment -%}
  @font-face {
    font-family: "D-DIN";
    src: url("{{ 'D-DIN.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "D-DIN";
    src: url("{{ 'D-DIN-Bold.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-body--family: "DINNextLTPro", "D-DIN", sans-serif;
    --font-subheading--family: "DINNextLTPro", "D-DIN", sans-serif;
    --font-heading--family: "DINNextLTPro", "D-DIN", sans-serif;
    --font-accent--family: "DINNextLTPro", "D-DIN", sans-serif;
    --font-primary--family: "DINNextLTPro", "D-DIN", sans-serif;
  }

  body {
    font-family: var(--font-body--family);
  }

  {%- comment -%}
    Rewards page keeps the theme's own body font (Layer 1 — settings > Typography)
    instead of the DIN override above, which is what the source page shows.

    Scoped to <main data-template>, so the announcement bar, the rest of the
    header and the footer all stay on DIN. All five families are switched
    because the page's text blocks pick from body, accent and primary.
  {%- endcomment -%}
  {%- assign page_font = settings.type_body_font.family -%}
  {%- if settings.type_body_font.fallback_families != blank -%}
    {%- assign page_font = page_font | append: ', ' | append: settings.type_body_font.fallback_families -%}
  {%- endif -%}
  main[data-template="page.rewards-program"] {
    {%- comment -%} Set outright too: anything that just inherits would otherwise
    still read Tailwind's --font-sans off <body>. {%- endcomment -%}
    font-family: {{ page_font }};
    --font-body--family: {{ page_font }};
    --font-subheading--family: {{ page_font }};
    --font-heading--family: {{ page_font }};
    --font-accent--family: {{ page_font }};
    --font-primary--family: {{ page_font }};
    {%- comment -%} Buttons need their own line: Horizon resolves these two at
    :root, so they keep the root family unless restated here. {%- endcomment -%}
    --button-font-family-primary: {{ page_font }};
    --button-font-family-secondary: {{ page_font }};
  }
</style>

        "text_P9Cb4c": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h2><strong>How to return a product?</strong><br/></h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "1.5rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",

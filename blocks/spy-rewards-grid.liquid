{%- comment -%}
  Rewards grid — one tile per way to earn points.

  Colours and sizes live HERE, not on each tile. The tiles and their text blocks
  read them as CSS variables, so all nine stay in sync from one place. Only the
  wording and the two links sit on each tile, because a child block cannot read
  its parent's settings — and per-tile wording helps anyway: the Facebook tile
  can send people to Facebook.

  Each `--x-d` / `--x-m` pair is picked once here, at 750px, so children just use
  `var(--rw-title-size)` and never repeat the breakpoint.

  Note: `[display:grid]`, not Tailwind's `grid`. Horizon's base.css owns a `.grid`
  class of its own — the 14-column page layout with `grid-template-areas` — and
  those named areas would force their own columns no matter what we set here.
{%- endcomment -%}

<div
  class="
    spy-rewards-grid [display:grid] w-full mx-auto
    [max-width:var(--rw-max)]
    [grid-template-columns:repeat(var(--rw-cols-m),minmax(0,1fr))]
    min-[750px]:[grid-template-columns:repeat(var(--rw-cols-t),minmax(0,1fr))]
    min-[990px]:[grid-template-columns:repeat(var(--rw-cols-d),minmax(0,1fr))]
    [--rw-ratio:var(--rw-ratio-m)]
    [--rw-pad:var(--rw-pad-m)]
    [--rw-icon-w:var(--rw-icon-w-m)]
    [--rw-title-size:var(--rw-title-size-m)]
    [--rw-text-size:var(--rw-text-size-m)]
    [--rw-cta-size:var(--rw-cta-size-m)]
    [--rw-cta-w:var(--rw-cta-w-m)]
    [--rw-note-size:var(--rw-note-size-m)]
    min-[750px]:[--rw-ratio:var(--rw-ratio-d)]
    min-[750px]:[--rw-pad:var(--rw-pad-d)]
    min-[750px]:[--rw-icon-w:var(--rw-icon-w-d)]
    min-[750px]:[--rw-title-size:var(--rw-title-size-d)]
    min-[750px]:[--rw-text-size:var(--rw-text-size-d)]
    min-[750px]:[--rw-cta-size:var(--rw-cta-size-d)]
    min-[750px]:[--rw-cta-w:var(--rw-cta-w-d)]
    min-[750px]:[--rw-note-size:var(--rw-note-size-d)]
  "
  style="
    --rw-max: {{ block.settings.max_width }}px;
    --rw-cols-d: {{ block.settings.columns_desktop }};
    --rw-cols-t: {{ block.settings.columns_tablet }};
    --rw-cols-m: {{ block.settings.columns_mobile }};
    --rw-ratio-d: {{ block.settings.tile_ratio }};
    --rw-ratio-m: {{ block.settings.tile_ratio_mobile }};
    --rw-min-h: {{ block.settings.tile_min_height }}px;
    --rw-pad-d: {{ block.settings.tile_padding }}px;
    --rw-pad-m: {{ block.settings.tile_padding_mobile }}px;
    --rw-radius: {{ block.settings.tile_radius }}px;
    --rw-tile-bg: {{ block.settings.tile_background }};
    --rw-tile-bg-hover: {{ block.settings.tile_background_hover }};
    --rw-fade: {{ block.settings.fade_duration }}ms;
    --rw-icon-w-d: {{ block.settings.icon_width }}px;
    --rw-icon-w-m: {{ block.settings.icon_width_mobile }}px;
    --rw-title-color: {{ block.settings.title_color }};
    --rw-title-size-d: {{ block.settings.title_size }}px;
    --rw-title-size-m: {{ block.settings.title_size_mobile }}px;
    --rw-title-weight: {{ block.settings.title_weight }};
    --rw-title-tracking: {{ block.settings.title_tracking }}px;
    --rw-text-color: {{ block.settings.text_color }};
    --rw-text-size-d: {{ block.settings.text_size }}px;
    --rw-text-size-m: {{ block.settings.text_size_mobile }}px;
    --rw-cta-bg: {{ block.settings.cta_background }};
    --rw-cta-bg-hover: {{ block.settings.cta_background_hover }};
    --rw-cta-color: {{ block.settings.cta_color }};
    --rw-cta-size-d: {{ block.settings.cta_size }}px;
    --rw-cta-size-m: {{ block.settings.cta_size_mobile }}px;
    --rw-cta-tracking: {{ block.settings.cta_tracking }}px;
    --rw-cta-w-d: {{ block.settings.cta_width }}px;
    --rw-cta-w-m: {{ block.settings.cta_width_mobile }}px;
    --rw-cta-h: {{ block.settings.cta_height }}px;
    --rw-cta-radius: {{ block.settings.cta_radius }}px;
    --rw-note-color: {{ block.settings.note_color }};
    --rw-note-size-d: {{ block.settings.note_size }}px;
    --rw-note-size-m: {{ block.settings.note_size_mobile }}px;
    --rw-note-gap: {{ block.settings.note_gap }}px;
    --rw-link-color: {{ block.settings.link_color }};
    gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}

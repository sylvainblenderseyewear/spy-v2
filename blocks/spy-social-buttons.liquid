{%- comment -%}
  Social buttons under the blog post meta line.

  Square outlined buttons, one per network, that fill with the hover colour on hover
  and focus. Horizon's stock social-links block draws bare icons off theme settings,
  so the boxed source look needs its own block. A blank URL drops that button.
{%- endcomment -%}

{%- liquid
  assign platforms = 'instagram,facebook,twitter,youtube' | split: ','

  case block.settings.align
    when 'left'
      assign align = 'justify-start'
    when 'right'
      assign align = 'justify-end'
    else
      assign align = 'justify-center'
  endcase

  # Same vars the content block uses, so the row always lines up with the body
  case block.settings.width
    when 'narrow'
      assign width_class = 'max-w-[var(--narrow-content-width)] mx-auto'
    when 'wide'
      assign width_class = 'max-w-[var(--wide-content-width)] mx-auto'
    when 'full'
      assign width_class = ''
    else
      assign width_class = 'max-w-[var(--normal-content-width)] mx-auto'
  endcase

  assign link_count = 0
  for platform in platforms
    assign url_key = platform | append: '_url'
    if block.settings[url_key] != blank
      assign link_count = link_count | plus: 1
    endif
  endfor
-%}

{%- if link_count > 0 -%}
  {%- comment -%} [display:flex] not `flex`: Horizon's base.css adds its own gap {%- endcomment -%}
  <div
    class="
      spy-social-buttons w-full flex-wrap items-center [display:flex] {{ align }} {{ width_class }}
      gap-[var(--sb-gap)] mt-[var(--sb-mt)] mb-[var(--sb-mb)]
    "
    style="
      --sb-gap: {{ block.settings.gap }}px;
      --sb-mt: {{ block.settings.margin_top }}px;
      --sb-mb: {{ block.settings.margin_bottom }}px;
      --sb-size: {{ block.settings.button_size }}px;
      --sb-icon: {{ block.settings.icon_size }}px;
      --sb-border: {{ block.settings.border_color }};
      --sb-color: {{ block.settings.icon_color }};
      --sb-bg: {{ block.settings.background_color }};
      --sb-hover-bg: {{ block.settings.hover_background_color }};
      --sb-hover-color: {{ block.settings.hover_icon_color }};
      --sb-radius: {{ block.settings.corner_radius }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- for platform in platforms -%}
      {%- liquid
        assign url_key = platform | append: '_url'
        assign url = block.settings[url_key]
      -%}
      {%- if url != blank -%}
        <a
          class="
            h-[var(--sb-size)] w-[var(--sb-size)] shrink-0 items-center justify-center [display:flex]
            rounded-[var(--sb-radius)] border border-solid border-[color:var(--sb-border)]
            bg-[color:var(--sb-bg)] text-[color:var(--sb-color)] no-underline
            transition-colors duration-200
            hover:border-[color:var(--sb-hover-bg)] hover:bg-[color:var(--sb-hover-bg)] hover:text-[color:var(--sb-hover-color)]
            focus-visible:border-[color:var(--sb-hover-bg)] focus-visible:bg-[color:var(--sb-hover-bg)] focus-visible:text-[color:var(--sb-hover-color)]
            focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spy-orange
          "
          href="{{ url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sr-only">{{ platform | capitalize }}</span>
          {%- case platform -%}
            {%- when 'instagram' -%}
              <svg
                class="h-[var(--sb-icon)] w-[var(--sb-icon)]"
                viewBox="0 0 448 512"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/>
              </svg>
            {%- when 'facebook' -%}
              <svg
                class="h-[var(--sb-icon)] w-[var(--sb-icon)]"
                viewBox="0 0 320 512"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/>
              </svg>
            {%- when 'twitter' -%}
              <svg
                class="h-[var(--sb-icon)] w-[var(--sb-icon)]"
                viewBox="0 0 512 512"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M459.37 151.716c.325 4.548.325 9.097.325 13.645 0 138.72-105.583 298.558-298.558 298.558-59.452 0-114.68-17.219-161.137-47.106 8.447.974 16.568 1.299 25.34 1.299 49.055 0 94.213-16.568 130.274-44.832-46.132-.975-84.792-31.188-98.112-72.772 6.498.974 12.995 1.624 19.818 1.624 9.421 0 18.843-1.3 27.614-3.573-48.081-9.747-84.143-51.98-84.143-102.985v-1.299c13.969 7.797 30.214 12.67 47.431 13.319-28.264-18.843-46.781-51.005-46.781-87.391 0-19.492 5.197-37.36 14.294-52.954 51.655 63.675 129.3 105.258 216.365 109.807-1.624-7.797-2.599-15.918-2.599-24.04 0-57.828 46.782-104.934 104.934-104.934 30.213 0 57.502 12.67 76.67 33.137 23.715-4.548 46.456-13.32 66.599-25.34-7.798 24.366-24.366 44.833-46.132 57.827 21.117-2.273 41.584-8.122 60.426-16.243-14.292 20.791-32.161 39.308-52.628 54.253z"/>
              </svg>
            {%- when 'youtube' -%}
              <svg
                class="h-[var(--sb-icon)] w-[var(--sb-icon)]"
                viewBox="0 0 576 512"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M549.655 124.083c-6.281-23.65-24.787-42.276-48.284-48.597C458.781 64 288 64 288 64S117.22 64 74.629 75.486c-23.497 6.322-42.003 24.947-48.284 48.597-11.412 42.867-11.412 132.305-11.412 132.305s0 89.438 11.412 132.305c6.281 23.65 24.787 41.5 48.284 47.821C117.22 448 288 448 288 448s170.78 0 213.371-11.486c23.497-6.321 42.003-24.171 48.284-47.821 11.412-42.867 11.412-132.305 11.412-132.305s0-89.438-11.412-132.305zm-317.51 213.508V175.185l142.739 81.205-142.739 81.201z"/>
              </svg>
          {%- endcase -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Social buttons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between buttons",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#1d2a2b"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Background on hover",
      "default": "#2c393e"
    },
    {
      "type": "color",
      "id": "hover_icon_color",
      "label": "Icon on hover",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "info": "Match the post body keeps the row the same width as the content.",
      "options": [
        { "value": "normal", "label": "Match the post body" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Space above",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Space below",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Social buttons",
      "category": "SPY",
      "settings": {
        "instagram_url": "https://www.instagram.com/spyoptic/",
        "facebook_url": "https://www.facebook.com/SPYOptic/",
        "twitter_url": "https://twitter.com/spyoptic",
        "youtube_url": "https://www.youtube.com/user/spyoptic"
      }
    }
  ]
}
{% endschema %}

{%- doc -%}
  Collection intro copy with a "Read more" toggle, the way the source PLP shows it.

  Text comes from the collection's own description in the admin, so an editor writes
  it where they already manage the collection. The `collection.intro_copy` metafield
  wins when it's filled, for collections that need richer markup than the plain
  description field allows.

  Collapsed it prints the first 130 characters (cut on a word, never mid-word) with
  "Read more" inline; expanded it prints the full text with "Read less" underneath.
  Short copy skips the toggle entirely.
{%- enddoc -%}

{%- liquid
  assign intro_meta = collection.metafields.collection.intro_copy

  if intro_meta != blank and intro_meta.value != blank
    capture body_html
      echo intro_meta | metafield_tag
    endcapture
  else
    assign body_html = collection.description
  endif

  assign limit = block.settings.char_limit | default: 130

  # Tags become spaces first, so block ends don't glue two words together
  assign flat = body_html | replace: '</p>', ' ' | replace: '</li>', ' ' | replace: '</div>', ' '
  assign plain = flat | newline_to_br | replace: '<br />', ' ' | strip_html | strip

  assign truncated = false
  assign preview = plain

  if plain.size > limit
    assign truncated = true

    # The "..." counts inside the limit, so the collapsed line matches the source
    assign text_limit = limit | minus: 3
    assign preview = plain | slice: 0, text_limit

    # Keep whole words: drop the last one unless the cut already landed on a space
    assign next_char = plain | slice: text_limit, 1
    unless next_char == ' '
      assign words = preview | split: ' '
      assign keep = words.size | minus: 1
      assign preview = ''
      for word in words limit: keep
        assign preview = preview | append: word | append: ' '
      endfor
    endunless

    assign preview = preview | strip
  endif

  assign label_more = block.settings.label_more | default: 'Read more'
  assign label_less = block.settings.label_less | default: 'Read less'

  assign copy_classes = 'text-[15px] leading-[1.6] text-[color:var(--color-spy-text)]'
  assign rte_classes = '[&_p]:m-0 [&_p+p]:mt-3 [&_a]:underline [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1'
  # No display utility on purpose: it would beat the browser's own [hidden] rule
  # and leave the collapsed button on screen
  assign toggle_classes = 'cursor-pointer whitespace-nowrap bg-transparent border-0 p-0 font-[inherit] text-[15px] leading-[1.6] text-spy-orange hover:underline'
-%}

{%- if body_html != blank -%}
  <spy-read-more data-spy-read-more {{ block.shopify_attributes }}>
    {%- if truncated -%}
      <p class="m-0 {{ copy_classes }}" data-preview>
        {{- preview }}...
        <button
          type="button"
          class="{{ toggle_classes }}"
          data-more
          aria-expanded="false"
          aria-controls="collection-intro-{{ block.id }}"
        >
          {{- label_more -}}
          {%- render 'spy-caret', direction: 'down' -%}
        </button>
      </p>

      <div id="collection-intro-{{ block.id }}" class="{{ copy_classes }} {{ rte_classes }}" data-full hidden>
        {{ body_html }}
      </div>

      <button
        type="button"
        class="{{ toggle_classes }}"
        data-less
        hidden
        aria-expanded="true"
        aria-controls="collection-intro-{{ block.id }}"
      >
        {{- label_less -}}
        {%- render 'spy-caret', direction: 'up' -%}
      </button>
    {%- else -%}
      <div class="{{ copy_classes }} {{ rte_classes }}">{{ body_html }}</div>
    {%- endif -%}
  </spy-read-more>

  {%- if truncated -%}
    <script src="{{ 'spy-read-more.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection intro",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Prints the collection description. Fill the `collection.intro_copy` metafield instead when the copy needs links or lists."
    },
    {
      "type": "range",
      "id": "char_limit",
      "label": "Characters shown when collapsed",
      "info": "Cut on the nearest word before this count.",
      "min": 60,
      "max": 400,
      "step": 10,
      "default": 130
    },
    { "type": "text", "id": "label_more", "label": "Expand label", "default": "Read more" },
    { "type": "text", "id": "label_less", "label": "Collapse label", "default": "Read less" }
  ],
  "presets": [{ "name": "Collection intro", "category": "SPY" }]
}
{% endschema %}

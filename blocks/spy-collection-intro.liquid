{%- doc -%}
  Collection intro copy with a "Read more" toggle, the way the source PLP shows it.

  Text comes from the collection's own description in the admin, so an editor writes
  it where they already manage the collection. The `collection.intro_copy` metafield
  wins when it's filled, for collections that need richer markup than the plain
  description field allows.

  Collapsed it prints ONE line clipped with a CSS ellipsis — same as the source, so
  the cut point follows the column width instead of a fixed character count — with
  "Read more" inline right after it. Expanded it prints the full text with
  "Read less" underneath. Short copy skips the toggle entirely.

  The collapsed line is a % of the row: the source uses 50% from 544px up and 100%
  below that, where the toggle wraps onto its own line.
{%- enddoc -%}

{%- liquid
  assign intro_meta = collection.metafields.collection.intro_copy

  if intro_meta != blank and intro_meta.value != blank
    capture body_html
      echo intro_meta | metafield_tag
    endcapture
  else
    assign body_html = collection.description
  endif

  assign limit = block.settings.char_limit | default: 130

  # Tags become spaces first, so block ends don't glue two words together
  assign flat = body_html | replace: '</p>', ' ' | replace: '</li>', ' ' | replace: '</div>', ' '
  assign plain = flat | newline_to_br | replace: '<br />', ' ' | strip_html | strip

  # CSS does the clipping; this only decides whether the toggle is worth showing
  assign truncated = false
  if plain.size > limit
    assign truncated = true
  endif

  assign label_more = block.settings.label_more | default: 'Read more'
  assign label_less = block.settings.label_less | default: 'Read less'

  assign width_mobile = block.settings.collapsed_width_mobile | default: 100
  assign width_desktop = block.settings.collapsed_width_desktop | default: 50

  assign copy_classes = 'text-[16px] leading-[1.4] text-spy-ink'
  assign rte_classes = '[&_p]:m-0 [&_p+p]:mt-3 [&_a]:underline [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1'
  # No display utility on purpose: it would beat the browser's own [hidden] rule
  # and leave the collapsed button on screen
  assign toggle_classes = 'cursor-pointer whitespace-nowrap bg-transparent border-0 p-0 font-[inherit] text-[16px] leading-[1.4] text-spy-orange-ui'
-%}

{%- if body_html != blank -%}
  {% comment %}
    Clearfix keeps the floated line inside the block so the 16px gap below holds.
    w-full + min-w-0: the row is a flex parent, so the nowrap line would otherwise
    size this to the full text width and push the page sideways.
  {% endcomment %}
  <spy-read-more
    class="mb-4 block w-full min-w-0 after:block after:clear-both after:content-['']"
    data-spy-read-more
    {{ block.shopify_attributes }}
  >
    {%- if truncated -%}
      {% comment %} Source floats the clipped line so the toggle sits beside it, then wraps under it on mobile {% endcomment %}
      <p
        class="float-left m-0 w-[var(--intro-w-mobile)] overflow-hidden text-ellipsis whitespace-nowrap min-[544px]:w-[var(--intro-w-desktop)] {{ copy_classes }}"
        style="--intro-w-mobile: {{ width_mobile }}%; --intro-w-desktop: {{ width_desktop }}%;"
        data-preview
      >
        {{- plain -}}
      </p>

      <button
        type="button"
        class="{{ toggle_classes }}"
        data-more
        aria-expanded="false"
        aria-controls="collection-intro-{{ block.id }}"
      >
        {{- label_more -}}
        {%- render 'spy-caret', direction: 'down' -%}
      </button>

      <div id="collection-intro-{{ block.id }}" class="{{ copy_classes }} {{ rte_classes }}" data-full hidden>
        {{ body_html }}
      </div>

      <button
        type="button"
        class="{{ toggle_classes }}"
        data-less
        hidden
        aria-expanded="true"
        aria-controls="collection-intro-{{ block.id }}"
      >
        {{- label_less -}}
        {%- render 'spy-caret', direction: 'up' -%}
      </button>
    {%- else -%}
      <div class="{{ copy_classes }} {{ rte_classes }}">{{ body_html }}</div>
    {%- endif -%}
  </spy-read-more>

  {%- if truncated -%}
    <script src="{{ 'spy-read-more.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection intro",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Prints the collection description. Fill the `collection.intro_copy` metafield instead when the copy needs links or lists."
    },
    {
      "type": "range",
      "id": "collapsed_width_desktop",
      "label": "Collapsed line width (desktop)",
      "info": "Share of the row the one-line preview fills before it clips. Source uses 50%.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "collapsed_width_mobile",
      "label": "Collapsed line width (mobile)",
      "info": "Below 544px. At 100% the toggle wraps onto its own line, like the source.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "char_limit",
      "label": "Show the toggle past this many characters",
      "info": "Shorter copy prints in full with no Read more.",
      "min": 60,
      "max": 400,
      "step": 10,
      "default": 130
    },
    { "type": "text", "id": "label_more", "label": "Expand label", "default": "Read more" },
    { "type": "text", "id": "label_less", "label": "Collapse label", "default": "Read less" }
  ],
  "presets": [{ "name": "Collection intro", "category": "SPY" }]
}
{% endschema %}

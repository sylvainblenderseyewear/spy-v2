{%- doc -%}
  Lens information panel — VLT / category / tint / technology.

  Lens data is VARIANT-scoped in this store (spec.vlt_percent, spec.lens_category,
  spec.base_tint, spec.lens_tint, spec.lens_technology), so read the selected
  variant first and fall back to the product. Coverage is uneven between variants
  of the same product, so each tile checks its own value.
{%- enddoc -%}

{%- liquid
  assign p = closest.product
  assign v = p.selected_or_first_available_variant
  assign vs = v.metafields.spec
  assign ps = p.metafields.spec

  assign vlt = vs.vlt_percent.value
  if vlt == blank
    assign vlt = ps.vlt_percent.value
  endif

  assign lens_cat = vs.lens_category.value
  if lens_cat == blank
    assign lens_cat = ps.lens_category.value
  endif

  # base_tint is the tile the source labels "Tint base"; lens_tint is the nearest
  # stand-in when a variant only carries that one.
  assign base_tint = vs.base_tint.value
  if base_tint == blank
    assign base_tint = vs.lens_tint.value
  endif
  if base_tint == blank
    assign base_tint = ps.base_tint.value
  endif

  # Variant stores the technology as plain text ("Happy"); the product-level
  # metaobject list is richer (it can carry an icon) so prefer it when present.
  assign technologies = ps.technologies.value
  assign tech_text = vs.lens_technology.value
  if tech_text == blank
    assign tech_text = ps.lens_technology.value
  endif

  if vlt == blank and lens_cat == blank and base_tint == blank and technologies == blank and tech_text == blank
    assign skip_block = true
  endif

  # "Read more" opens the lens-tech drawer, like the source. Its content is the same
  # editorial copy for every product, so it lives in block settings; when a product
  # references a technology metaobject that entry overrides the logo, blurb and body.
  assign tech = nil
  if technologies != blank
    assign tech = technologies | first
  endif

  assign drawer_logo = block.settings.drawer_logo
  assign drawer_title = block.settings.drawer_title
  assign drawer_blurb = block.settings.drawer_blurb
  assign drawer_benefits = block.settings.drawer_benefits

  if tech != nil
    if tech.icon.value != blank
      assign drawer_logo = tech.icon.value
    endif
    if tech.name.value != blank
      assign drawer_title = tech.name.value
    endif
    if tech.short_blurb.value != blank
      assign drawer_blurb = tech.short_blurb.value
    endif
    if tech.long_description.value != blank
      assign drawer_benefits = tech.long_description.value
    endif
  endif

  assign drawer_id = 'spy-lens-tech-' | append: block.id
  assign drawer_label = drawer_title | default: block.settings.drawer_eyebrow

  # Nothing to show at all — keep the old link behaviour rather than an empty panel.
  assign use_drawer = false
  if drawer_logo != blank or drawer_title != blank or drawer_blurb != blank or drawer_benefits != blank
    assign use_drawer = true
  endif

  assign read_more_url = block.settings.read_more_url
  if read_more_url == blank and tech != nil
    assign read_more_url = tech.link.value
  endif
  if read_more_url == blank
    assign read_more_url = '#spy-spec-details'
  endif

  # Parse category number (handles "Cat. 3", "Cat. 1 (Clear) / Cat. 3", "3")
  assign cat_clean = lens_cat | downcase | remove: 'cat. ' | remove: 'cat.' | remove: 'cat ' | strip | split: ' ' | first
  assign cat_num = cat_clean | plus: 0
  assign show_scale = false
  unless cat_clean == blank
    assign show_scale = true
  endunless
-%}

{%- unless skip_block -%}
{%- comment -%}
  No rule above the heading — the source section has border-top: 0. Its heading row
  is 24px tall with the title left and "Read more" right, then 12px to the tiles.
{%- endcomment -%}
<div class="my-8" {{ block.shopify_attributes }}>

  <div class="flex items-center justify-between gap-3 h-6 mb-3">
    <span class="text-[16px] leading-6 font-medium text-[color:var(--color-spy-ink)]">Lens information</span>
    {%- liquid
      assign read_more_cls = 'text-[14px] leading-5 font-medium tracking-[0.01em] underline decoration-current underline-offset-2 text-[color:var(--color-spy-text)] hover:text-spy-orange'
    -%}
    {%- if use_drawer -%}
      <button
        type="button"
        id="{{ drawer_id }}-trigger"
        class="{{ read_more_cls }} cursor-pointer border-none bg-transparent p-0"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="{{ drawer_id }}"
        data-spy-drawer-open="{{ drawer_id }}"
      >{{ block.settings.read_more_label | default: 'Read more' }}</button>
    {%- elsif read_more_url != blank -%}
      <a
        href="{{ read_more_url }}"
        class="{{ read_more_cls }}"
      >{{ block.settings.read_more_label | default: 'Read more' }}</a>
    {%- endif -%}
  </div>

  {%- comment -%} 2x2 tiles, 8px gutters, no frame or divider lines {%- endcomment -%}
  <div class="[display:grid] grid-cols-2 gap-2">

    {%- if vlt != blank -%}
      <div class="bg-[color:var(--color-spy-surface)] flex flex-col items-center justify-between gap-0 px-3 py-4 h-full min-h-[76px] text-center">
        <span class="text-[18px] leading-7 font-medium tracking-[-0.01em] text-[color:var(--color-spy-ink)]">{{ vlt }}%</span>
        <span class="text-[12px] leading-4 tracking-[0.015em] text-[color:var(--color-spy-ink)]">Visible Light Transmission (VLT)</span>
      </div>
    {%- endif -%}

    {%- if lens_cat != blank -%}
      <div class="bg-[color:var(--color-spy-surface)] flex flex-col items-center justify-between gap-0 px-3 py-4 h-full min-h-[76px] text-center">
        <span class="text-[18px] leading-7 font-medium tracking-[-0.01em] text-[color:var(--color-spy-ink)]">{{ cat_num }}</span>
        <span class="text-[12px] leading-4 tracking-[0.015em] text-[color:var(--color-spy-ink)]">Lens category</span>
      </div>
    {%- endif -%}

    {%- if base_tint != blank -%}
      <div class="bg-[color:var(--color-spy-surface)] flex flex-col items-center justify-between gap-0 px-3 py-4 h-full min-h-[76px] text-center">
        <span class="text-[18px] leading-7 font-medium tracking-[-0.01em] text-[color:var(--color-spy-ink)]">{{ base_tint }}</span>
        <span class="text-[12px] leading-4 tracking-[0.015em] text-[color:var(--color-spy-ink)]">Tint base</span>
      </div>
    {%- endif -%}

    {%- liquid
      # Metaobject first (it can supply the logo), else the variant's text value.
      assign tech_name = tech_text
      assign icon_src = ''
      if technologies != blank
        assign first_tech = technologies | first
        if first_tech != blank
          assign tech_name = first_tech.name.value | default: tech_text
          assign tech_icon_file = first_tech.icon.value
          assign icon_src = tech_icon_file | image_url: width: 200
          if icon_src == blank
            assign icon_src = tech_icon_file.url
          endif
          # Source draws the logo at its own size, no class on the img. The art is
          # 100x20, so cap the height at 20 and let the width follow the ratio.
          # It stays INLINE like the source, so it shares the 28px lead line box
          # and the tile keeps its 76px height.
          assign icon_w = tech_icon_file.width | default: 100
          assign icon_h = tech_icon_file.height | default: 20
        endif
      endif
    -%}
    {%- if tech_name != blank or icon_src != blank -%}
      <div class="bg-[color:var(--color-spy-surface)] flex flex-col items-center justify-between gap-0 px-3 py-4 h-full min-h-[76px] text-center">
        {%- if icon_src != blank -%}
          {%- comment -%} Source sits the logo in a py-2 px-4 box, centred by a flex row {%- endcomment -%}
          <div class="[display:flex] justify-center px-6 py-2">
            <img src="{{ icon_src }}" alt="{{ tech_name }}" width="{{ icon_w }}" height="{{ icon_h }}" loading="lazy" class="h-5 w-auto max-w-full">
          </div>
        {%- else -%}
          <span class="text-[18px] leading-7 font-medium tracking-[-0.01em] text-[color:var(--color-spy-ink)]">{{ tech_name }}</span>
        {%- endif -%}
        <span class="text-[12px] leading-4 tracking-[0.015em] text-[color:var(--color-spy-ink)]">Technology</span>
      </div>
    {%- endif -%}

  </div>

  {%- comment -%}
    Cat 0-4 scale, 24px under the tiles. Source grid is `0 repeat(4, 1fr)` and each
    step right-aligns its icon, tick and label, so Cat. 0 sits on the left edge and
    Cat. 4 hard right. Grey track and the 56px active bar are absolute, pinned at 50%.
  {%- endcomment -%}
  {%- if show_scale -%}
    <div class="spy-cat-scale mt-6">
      {%- for i in (0..4) -%}
        {%- liquid
          assign is_active = false
          if i == cat_num
            assign is_active = true
          endif
        -%}
        {%- comment -%}
          Step 0 owns a 0-width track, so it reads left to keep its icon and label on
          the left edge; every other step reads right like the source.
        {%- endcomment -%}
        <div class="relative text-[16px] leading-[1.4] text-[color:var(--color-spy-text)] {% if forloop.first %}text-left{% else %}text-right{% endif %}">
          {%- comment -%} Grey track, 10px inset; the last step closes the right end {%- endcomment -%}
          {%- unless forloop.first -%}
            {%- if forloop.last -%}
              <span class="absolute top-1/2 right-0 w-[calc(100%+0.625rem)] h-2 bg-[color:var(--color-spy-surface)]" aria-hidden="true"></span>
            {%- else -%}
              <span class="absolute top-1/2 right-[0.625rem] w-full h-2 bg-[color:var(--color-spy-surface)]" aria-hidden="true"></span>
            {%- endif -%}
          {%- endunless -%}
          {%- comment -%} 56px bar on the active step, overhanging 16px like the source {%- endcomment -%}
          {%- if is_active -%}
            <span class="absolute top-1/2 right-[-1rem] z-[1] w-14 h-2 bg-[color:var(--color-spy-text)]" aria-hidden="true"></span>
          {%- endif -%}
          {%- comment -%} Weather icon, inline so it sits in a 22.4px line box {%- endcomment -%}

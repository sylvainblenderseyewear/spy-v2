                <svg class="inline align-middle max-w-none" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 5.625C7.58375 5.625 5.625 7.58375 5.625 10C5.625 12.4162 7.58375 14.375 10 14.375C12.4162 14.375 14.375 12.4162 14.375 10C14.375 7.58375 12.4162 5.625 10 5.625ZM4.375 10C4.375 6.8934 6.8934 4.375 10 4.375C13.1066 4.375 15.625 6.8934 15.625 10C15.625 13.1066 13.1066 15.625 10 15.625C6.8934 15.625 4.375 13.1066 4.375 10Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M17.7083 10C17.7083 9.65482 17.9881 9.375 18.3333 9.375L19.1666 9.375C19.5118 9.375 19.7916 9.65482 19.7916 10C19.7916 10.3452 19.5118 10.625 19.1666 10.625L18.3333 10.625C17.9881 10.625 17.7083 10.3452 17.7083 10Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M10 2.29163C9.65482 2.29163 9.375 2.0118 9.375 1.66663V0.833293C9.375 0.488115 9.65482 0.208293 10 0.208293C10.3452 0.208293 10.625 0.488115 10.625 0.833293V1.66663C10.625 2.0118 10.3452 2.29163 10 2.29163Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M10 19.7916C9.65482 19.7916 9.375 19.5118 9.375 19.1666V18.3333C9.375 17.9881 9.65482 17.7083 10 17.7083C10.3452 17.7083 10.625 17.9881 10.625 18.3333V19.1666C10.625 19.5118 10.3452 19.7916 10 19.7916Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M17.1087 17.1086C16.8646 17.3526 16.4689 17.3526 16.2248 17.1086L15.3915 16.2752C15.1474 16.0312 15.1474 15.6354 15.3915 15.3914C15.6356 15.1473 16.0313 15.1473 16.2754 15.3914L17.1087 16.2247C17.3528 16.4688 17.3528 16.8645 17.1087 17.1086Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M17.1087 2.89143C16.8646 2.64735 16.4689 2.64735 16.2248 2.89143L15.3915 3.72477C15.1474 3.96884 15.1474 4.36457 15.3915 4.60865C15.6356 4.85273 16.0313 4.85273 16.2754 4.60865L17.1087 3.77532C17.3528 3.53124 17.3528 3.13551 17.1087 2.89143Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M2.89131 17.1086C3.13539 17.3526 3.53112 17.3526 3.77519 17.1086L4.60853 16.2752C4.8526 16.0312 4.8526 15.6354 4.60853 15.3914C4.36445 15.1473 3.96872 15.1473 3.72464 15.3914L2.89131 16.2247C2.64723 16.4688 2.64723 16.8645 2.89131 17.1086Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M2.89131 2.89143C3.13539 2.64735 3.53112 2.64735 3.77519 2.89143L4.60853 3.72477C4.8526 3.96884 4.8526 4.36457 4.60853 4.60865C4.36445 4.85273 3.96872 4.85273 3.72464 4.60865L2.89131 3.77532C2.64723 3.53124 2.64723 3.13551 2.89131 2.89143Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M0.208252 10C0.208252 9.65482 0.488074 9.375 0.833252 9.375L1.66659 9.375C2.01176 9.375 2.29159 9.65482 2.29159 10C2.29159 10.3452 2.01176 10.625 1.66659 10.625L0.833252 10.625C0.488074 10.625 0.208252 10.3452 0.208252 10Z" fill="currentColor"></path></svg>
              {%- when 4 -%}
                <svg class="inline align-middle max-w-none" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.0001 9.375C10.3453 9.375 10.6251 9.65482 10.6251 10L10.6251 13.1045L13.4466 11.537C13.7483 11.3694 14.1288 11.4781 14.2965 11.7798C14.4641 12.0815 14.3554 12.462 14.0536 12.6297L11.2871 14.1667L14.0536 15.7037C14.3554 15.8713 14.4641 16.2518 14.2965 16.5535C14.1288 16.8553 13.7483 16.964 13.4466 16.7963L10.6251 15.2289L10.6251 18.3333C10.6251 18.6785 10.3453 18.9583 10.0001 18.9583C9.65494 18.9583 9.37511 18.6785 9.37511 18.3333L9.37511 15.2289L6.55364 16.7963C6.2519 16.964 5.8714 16.8553 5.70377 16.5535C5.53613 16.2518 5.64485 15.8713 5.94659 15.7037L8.71316 14.1667L5.94659 12.6297C5.64485 12.462 5.53613 12.0815 5.70377 11.7798C5.8714 11.4781 6.2519 11.3694 6.55364 11.537L9.37511 13.1045L9.37511 10C9.37511 9.65482 9.65494 9.375 10.0001 9.375Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M17.7083 10C17.7083 9.65482 17.9881 9.375 18.3333 9.375L19.1666 9.375C19.5118 9.375 19.7916 9.65482 19.7916 10C19.7916 10.3452 19.5118 10.625 19.1666 10.625L18.3333 10.625C17.9881 10.625 17.7083 10.3452 17.7083 10Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M10 2.29163C9.65482 2.29163 9.375 2.0118 9.375 1.66663V0.833293C9.375 0.488115 9.65482 0.208293 10 0.208293C10.3452 0.208293 10.625 0.488115 10.625 0.833293V1.66663C10.625 2.0118 10.3452 2.29163 10 2.29163Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M17.1087 2.89143C16.8646 2.64735 16.4689 2.64735 16.2248 2.89143L15.3915 3.72477C15.1474 3.96884 15.1474 4.36457 15.3915 4.60865C15.6356 4.85273 16.0313 4.85273 16.2754 4.60865L17.1087 3.77532C17.3528 3.53124 17.3528 3.13551 17.1087 2.89143Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M2.89131 2.89143C3.13539 2.64735 3.53112 2.64735 3.77519 2.89143L4.60853 3.72477C4.8526 3.96884 4.8526 4.36457 4.60853 4.60865C4.36445 4.85273 3.96872 4.85273 3.72464 4.60865L2.89131 3.77532C2.64723 3.53124 2.64723 3.13551 2.89131 2.89143Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M0.208252 10C0.208252 9.65482 0.488074 9.375 0.833252 9.375L1.66659 9.375C2.01176 9.375 2.29159 9.65482 2.29159 10C2.29159 10.3452 2.01176 10.625 1.66659 10.625L0.833252 10.625C0.488074 10.625 0.208252 10.3452 0.208252 10Z" fill="currentColor"></path><path d="M4.16659 10C4.16659 8.45294 4.78117 6.96921 5.87513 5.87525C6.96909 4.78129 8.45282 4.16671 9.99992 4.16671C11.547 4.16671 13.0307 4.78129 14.1247 5.87525C15.2187 6.96921 15.8333 8.45294 15.8333 10L14.3382 10C14.3382 8.84946 13.8811 7.74601 13.0675 6.93242C12.254 6.11884 11.1505 5.66178 9.99992 5.66178C8.84934 5.66178 7.74589 6.11884 6.9323 6.93242C6.11872 7.74601 5.66166 8.84946 5.66166 10L4.16659 10Z" fill="currentColor"></path></svg>
          {%- endcase -%}
          {%- comment -%} 1x16 tick, dark on the active step only {%- endcomment -%}
          <span class="relative z-[1] block w-px h-4 mt-2 ml-auto {% if forloop.last %}mr-0{% else %}mr-[0.625rem]{% endif %} {% if is_active %}bg-[color:var(--color-spy-text)]{% else %}bg-transparent{% endif %}" aria-hidden="true"></span>
          {%- comment -%} Source nudges labels 1-3 right by 25% of their own width {%- endcomment -%}
          <span class="block whitespace-nowrap text-[color:var(--color-spy-ink)]{% if i > 0 and i < 4 %} w-fit ml-auto translate-x-[25%]{% endif %}">Cat. {{ i }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{%- comment -%}
  Lens tech drawer, opened by "Read more". Copy comes from the block settings and a
  linked technology metaobject overrides it. Matches the source's .spy-hl-* content
  asset (24px gutters, 8px orange dots, grey note).
{%- endcomment -%}
{%- if use_drawer -%}
  {%- capture lens_tech_body -%}
    {%- comment -%} Source fades the content up 6px as the panel opens, and antialiases it {%- endcomment -%}
    <div class="antialiased group-data-[open]:animate-spy-fade-up">
    <div class="px-6 pt-6">
      <p class="mb-3.5 text-[10px] font-bold uppercase leading-none tracking-[0.3em] text-spy-orange">{{ block.settings.drawer_eyebrow }}</p>
      {%- if drawer_logo != blank -%}
        <img
          src="{{ drawer_logo | image_url: width: 400 }}"
          alt="{{ drawer_title | default: 'Lens technology' | escape }}"
          loading="lazy"
          class="mb-3.5 block max-h-12 w-auto max-w-full max-[768px]:max-h-14"
        >
      {%- elsif drawer_title != blank -%}
        {%- comment -%} No logo uploaded — the name carries the heading {%- endcomment -%}
        <p class="mb-3.5 text-[22px] font-bold uppercase leading-none tracking-[0.04em] text-[#111]" style="font-family: var(--font-heading--family);">{{ drawer_title }}</p>
      {%- endif -%}
      {%- if drawer_blurb != blank -%}
        <div class="border-b border-[#e5e5e5] pb-[18px] text-[13px] font-normal italic leading-[1.65] text-[#666] max-[768px]:text-[14px] [&_p]:m-0">{{ drawer_blurb }}</div>
      {%- endif -%}
    </div>

    {%- if drawer_benefits != blank -%}
      {%- comment -%}
        Editor's rich text becomes the benefit list: each list item gets the orange
        dot, a bold lead-in reads as the benefit name.
      {%- endcomment -%}
      <div class="px-6 pt-[18px] text-[12px] leading-[1.65] text-[#888] max-[768px]:text-[13px]
        [&_ul]:m-0 [&_ul]:flex [&_ul]:list-none [&_ul]:flex-col [&_ul]:gap-4 [&_ul]:p-0
        [&_li]:relative [&_li]:pl-[21px]
        [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-[5px] [&_li]:before:h-2 [&_li]:before:w-2 [&_li]:before:rounded-full [&_li]:before:bg-spy-orange [&_li]:before:content-['']
        [&_strong]:mb-[3px] [&_strong]:block [&_strong]:text-[13px] [&_strong]:font-bold [&_strong]:text-[#111] [&_strong]:max-[768px]:text-[14px]
        [&_p]:m-0 [&_p:not(:last-child)]:mb-4
        [&_a]:text-spy-orange [&_a]:underline [&_a]:decoration-current">
        {{ drawer_benefits }}
      </div>
    {%- endif -%}

    {%- if block.settings.drawer_note != blank -%}
      {%- comment -%} Grey callout with the orange rule down its left edge {%- endcomment -%}
      <div class="mx-6 mb-7 mt-5 rounded-r-[2px] border-l-[3px] border-spy-orange bg-[#f7f7f7] px-[15px] py-[13px]">
        <div class="text-[12px] leading-[1.7] text-[#999] max-[768px]:text-[13px] [&_p]:m-0">{{ block.settings.drawer_note }}</div>
      </div>
    {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- render 'spy-drawer',
    id: drawer_id,
    label: drawer_label,
    body: lens_tech_body
  -%}
  <script src="{{ 'spy-drawer.js' | asset_url }}" defer></script>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Lens Info",
  "tag": null,
  "settings": [
    { "type": "url", "id": "read_more_url", "label": "\"Read more\" link", "info": "Used only when the product references no technology metaobject" },
    { "type": "text", "id": "read_more_label", "label": "\"Read more\" label", "default": "Read more" },
    { "type": "header", "content": "Lens tech drawer" },
    { "type": "text", "id": "drawer_eyebrow", "label": "Eyebrow", "default": "Lens Technology" },
    { "type": "image_picker", "id": "drawer_logo", "label": "Logo", "info": "Overridden by a linked technology metaobject icon" },
    { "type": "text", "id": "drawer_title", "label": "Title", "info": "Shown when no logo is set", "default": "Happy Lens Tech" },
    { "type": "richtext", "id": "drawer_blurb", "label": "Intro", "default": "<p>SPY's patented spectrally-selective filter technology blocks harmful UV and HEV light while preserving the beneficial wavelengths that keep your mind and eyes performing at their best.</p>" },
    { "type": "richtext", "id": "drawer_benefits", "label": "Benefits", "info": "Use a bulleted list; bold the start of each point for its title", "default": "<ul><li><strong>Mood-Boosting Light Science</strong> Lets in long-wave blue light that studies show can boost alertness, improve mood, and keep you feeling sharp longer.</li><li><strong>100% UV Protection</strong> Blocks all UVA and UVB rays completely — full protection from harmful sun exposure in every condition.</li><li><strong>Enhanced Color &amp; Contrast</strong> Richer color and sharper edge definition so the world looks the way it's supposed to — vivid and clear.</li></ul>" },
    { "type": "richtext", "id": "drawer_note", "label": "Closing note", "default": "<p>The lens engineered to work with your brain, not just your eyes, letting in the light that makes you feel better all day long.</p>" }
  ],
  "presets": [
    {
      "name": "Lens Info",
      "category": "SPY"
    }
  ]
}
{% endschema %}

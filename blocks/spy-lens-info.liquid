              {%- when 1 -%}
                <svg class="inline align-middle max-w-none" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.16085 5.52993C5.63786 6.40159 5.62492 7.477 5.62492 8.33337C5.62492 8.67855 5.3451 8.95837 4.99992 8.95837C4.40549 8.95837 3.49993 9.14184 2.76094 9.67392C2.05382 10.183 1.45825 11.0371 1.45825 12.5C1.45825 13.963 2.05382 14.817 2.76094 15.3262C3.49993 15.8582 4.40549 16.0417 4.99992 16.0417H14.9999C15.5943 16.0417 16.4999 15.8582 17.2389 15.3262C17.946 14.817 18.5416 13.963 18.5416 12.5C18.5416 11.0371 17.946 10.183 17.2389 9.67392C16.4999 9.14184 15.5943 8.95837 14.9999 8.95837C14.6547 8.95837 14.3749 8.67855 14.3749 8.33337C14.3749 7.477 14.362 6.40159 13.839 5.52993C13.3577 4.72786 12.3477 3.95837 9.99992 3.95837C7.65212 3.95837 6.6421 4.72786 6.16085 5.52993ZM5.08898 4.88681C5.85774 3.60556 7.34772 2.70837 9.99992 2.70837C12.6521 2.70837 14.1421 3.60556 14.9109 4.88681C15.4855 5.84461 15.5979 6.93544 15.6197 7.75073C16.3408 7.84561 17.2077 8.11117 17.9693 8.6595C18.9983 9.40037 19.7916 10.6297 19.7916 12.5C19.7916 14.3704 18.9983 15.5997 17.9693 16.3406C16.9722 17.0585 15.7944 17.2917 14.9999 17.2917H4.99992C4.20546 17.2917 3.02768 17.0585 2.03056 16.3406C1.00157 15.5997 0.208252 14.3704 0.208252 12.5C0.208252 10.6297 1.00157 9.40037 2.03056 8.6595C2.79213 8.11117 3.65908 7.8456 4.38014 7.75073C4.40198 6.93544 4.51431 5.84461 5.08898 4.88681Z" fill="currentColor"></path></svg>

{%- doc -%}
  Read-only frame/lens summary shown under the swatches (Ref / COLOR / LENS).
  Values come from metafields first, then fall back to the selected variant's
  options + SKU so it still renders on combined-listing products where the
  spec.* metafields are not filled yet.
{%- enddoc -%}

{%- liquid
  assign p = closest.product
  assign variant = p.selected_or_first_available_variant

  # Pull the matching option values off the selected variant (by option name)
  assign color_opt = ''
  assign lens_opt = ''
  assign extra_opt = ''
  for opt in p.options_with_values
    assign n = opt.name | downcase
    if n contains 'extra'
      assign extra_opt = opt.selected_value
    elsif n contains 'lens'
      assign lens_opt = opt.selected_value
    elsif n contains 'color' or n contains 'colour' or n contains 'frame'
      assign color_opt = opt.selected_value
    endif
  endfor

  # Metafield first, variant option / SKU as fallback
  # Frame data is product-scoped; lens data and the reference are variant-scoped.
  assign color_val = p.metafields.spec.frame_color.value | default: color_opt
  assign lens_val  = variant.metafields.spec.lens_name.value
  if lens_val == blank
    assign lens_val = p.metafields.spec.lens_name.value
  endif
  if lens_val == blank
    assign lens_val = lens_opt
  endif
  assign extra_val = extra_opt
  assign ref_val = variant.metafields.spec.sku_ref.value
  if ref_val == blank
    assign ref_val = p.metafields.spec.reference.value
  endif
  if ref_val == blank
    assign ref_val = variant.sku
  endif

  assign has_any = false
  if color_val != blank or lens_val != blank or ref_val != blank
    assign has_any = true
  endif
-%}

{%- liquid
  comment
    Measured off the source PDP: 24px under the swatches, Ref at 16/24, then 12px
    to the first row and 16px between rows. Label is the design system's label-m
    (14/20 bold uppercase, 0.5% tracking), value is 16/1.4.
  endcomment
  assign label_cls = 'text-[14px] leading-[20px] font-bold uppercase tracking-[0.005em] text-[color:var(--color-spy-ink)]'
  assign value_cls = 'text-[16px] leading-[1.4] text-[color:var(--color-spy-ink)]'
  assign row_gap = 'mt-4'
  if ref_val != blank
    assign row_gap = 'mt-3'
  endif
-%}

{%- if has_any -%}
<div class="pt-6 text-[color:var(--color-spy-text)]" {{ block.shopify_attributes }}>

  {%- if ref_val != blank -%}
    <div class="text-[16px] leading-6 text-[color:var(--color-spy-muted)]">Ref : {{ ref_val }}</div>
  {%- endif -%}

  {%- if color_val != blank -%}
    <div class="{{ row_gap }}">
      <div class="{{ label_cls }}">{{ block.settings.color_label | default: 'Frame' }}</div>
      <div class="{{ value_cls }}">{{ color_val }}</div>
    </div>
    {%- assign row_gap = 'mt-4' -%}
  {%- endif -%}

  {%- if lens_val != blank -%}
    <div class="{{ row_gap }}">
      <div class="{{ label_cls }}">Lens</div>
      <div class="{{ value_cls }}">{{ lens_val }}</div>
    </div>
    {%- assign row_gap = 'mt-4' -%}
  {%- endif -%}

  {%- if extra_val != blank -%}
    <div class="{{ row_gap }}">
      <div class="{{ label_cls }}">Extra Lens</div>
      <div class="{{ value_cls }}">{{ extra_val }}</div>
    </div>
  {%- endif -%}

</div>
{%- endif -%}

{% schema %}
{
  "name": "Frame Summary",
  "tag": null,
  "settings": [
    { "type": "text", "id": "color_label", "label": "Colour row label", "default": "Frame" }
  ],
  "presets": [{ "name": "Frame Summary", "category": "SPY" }]
}
{% endschema %}

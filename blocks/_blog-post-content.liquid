

{%- liquid
  # Migrated posts ship their own <style> block, and it styles the page BODY:
  # `body{margin:0;padding:30px 20px;font-family:Helvetica;font-size:14px}`.
  # That padding pushed the header, post and footer 20px in on every article,
  # and the font overrode the brand face. Rename the selector so the rule can
  # never match — the rest of the post's CSS (.blog-content, .two-col-images,
  # image helpers) is what the markup needs, so it stays.
  assign post_html = article.content | replace: 'body{', '.spy-post-body-noop{'
  assign post_html = post_html | replace: 'body {', '.spy-post-body-noop {'
-%}

<div
  class="blog-post-content rte"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ post_html }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--normal-content-width);
    margin: 0 auto;
    color: var(--color, inherit);
  }

  .blog-post-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "t:names.content",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}

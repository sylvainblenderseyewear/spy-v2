{%- doc -%}
  SPY colour preview — a row of small product-image thumbnails (always ≥1).

  Two looks, set by the `display` setting:
  - card: small thumbs for PLP / carousel cards. Hovering swaps the card image
    (spy-card.js) and an arrow appears when more colours exist than fit.
  - pdp: the 56px colour picker from the product page. Shows every colourway,
    marks the current one, and links out to its PDP.

  Colours come from the product's colour option when it has more than one value
  (combined listing). Staging has one product per colourway instead, so the pdp
  look falls back to the model collection — the same collection the breadcrumb
  uses. Both paths disappear once the migration brings real combined listings.
{%- enddoc -%}

{%- liquid
  assign p = closest.product
  assign max_shown = 4
  assign is_pdp = false
  if block.settings.display == 'pdp'
    assign is_pdp = true
  endif

  assign color_option = nil
  if p != blank
    for opt in p.options_with_values
      assign opt_lower = opt.name | downcase
      if opt_lower == 'frame color' or opt_lower == 'color' or opt_lower == 'colour'
        assign color_option = opt
        break
      endif
    endfor
  endif

  assign has_option_colors = false
  if color_option != nil and color_option.values.size > 1
    assign has_option_colors = true
  endif

  comment
    No real colour option — find the model collection (first one that is not a
    broad category), same rule as the breadcrumb.
  endcomment
  assign model_col = nil
  if is_pdp and has_option_colors == false and p != blank
    assign category_handles = 'sunglasses,eyeglasses,goggles,snow-goggles,moto-goggles,snow-helmets,gear,accessories' | split: ','
    for col in p.collections
      if col.handle == 'frontpage' or col.handle == 'all'
        continue
      endif
      unless category_handles contains col.handle
        assign model_col = col
        break
      endunless
    endfor
  endif
-%}

{%- if p != blank -%}
  {%- if is_pdp -%}
    {%- liquid
      assign swatch_base = 'spy-swatches__item relative block h-14 w-14 rounded-[2px] bg-white overflow-hidden'
      assign swatch_off = swatch_base | append: ' border border-[color:var(--color-spy-border)]'
      assign swatch_on = swatch_base | append: ' border-2 border-[color:var(--color-spy-text)]'
      comment
        Sold-out colourway: half-faded with a thin diagonal bar across the thumb,
        same as the source's .swatch-not-orderable (69x2px, 45deg, #f2f2f2).
      endcomment
      assign swatch_oos = ' spy-swatches__item--oos opacity-50 after:content-[""] after:absolute after:block after:top-[25px] after:-left-2 after:h-[2px] after:w-[69px] after:rotate-45 after:bg-[#f2f2f2] after:pointer-events-none'
    -%}
    <div class="spy-swatches flex flex-wrap items-center gap-2 mt-[22px]" {{ block.shopify_attributes }}>
      {%- if has_option_colors -%}
        {%- for v in color_option.values -%}
          {%- assign media = v.variant.featured_media | default: p.featured_media -%}
          {%- if media != blank -%}
            {%- liquid
              if v.selected
                assign cls = swatch_on
              else
                assign cls = swatch_off
              endif
              comment
                A colour with no orderable variant counts as sold out.
              endcomment
              assign v_available = false
              if v.variant.available
                assign v_available = true
              endif
              unless v_available
                assign cls = cls | append: swatch_oos
              endunless
            -%}
            <a
              href="{{ v.variant.url | default: p.url }}"
              class="{{ cls }}"
              {% if v.selected %}aria-current="true"{% endif %}
              {% unless v_available %}data-spy-oos aria-describedby="spy-oos-note"{% endunless %}
              aria-label="{{ p.title | escape }} – {{ v.name | escape }}{% unless v_available %} ({{ 'products.product.sold_out' | t }}){% endunless %}"
            >
              <img
                src="{{ media | image_url: width: 160 }}"
                alt="{{ v.name | escape }}"
                width="56"
                height="56"
                loading="lazy"
                class="m-auto block h-[90%] w-[90%] object-contain"
              >
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif model_col != nil -%}
        {%- for sp in model_col.products -%}
          {%- if sp.featured_media != blank -%}
            {%- liquid
              if sp.id == p.id
                assign cls = swatch_on
              else
                assign cls = swatch_off
              endif
              comment
                One product per colourway in staging, so stock is read off the
                product itself rather than a variant.
              endcomment
              assign sp_available = sp.available
              unless sp_available
                assign cls = cls | append: swatch_oos
              endunless
            -%}
            <a
              href="{{ sp.url }}"
              class="{{ cls }}"
              {% if sp.id == p.id %}aria-current="true"{% endif %}
              {% unless sp_available %}data-spy-oos{% endunless %}
              aria-label="{{ sp.title | escape }}{% unless sp_available %} ({{ 'products.product.sold_out' | t }}){% endunless %}"
            >
              <img
                src="{{ sp.featured_media | image_url: width: 160 }}"
                alt="{{ sp.title | escape }}"
                width="56"
                height="56"
                loading="lazy"
                class="m-auto block h-[90%] w-[90%] object-contain"
              >
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif p.featured_media != blank -%}
        {%- comment -%} single colourway — still show it, marked as current {%- endcomment -%}
        <span class="{{ swatch_on }}" aria-label="{{ p.title | escape }}">
          <img
            src="{{ p.featured_media | image_url: width: 160 }}"
            alt="{{ p.title | escape }}"
            width="56"
            height="56"
            loading="lazy"
            class="m-auto block h-[90%] w-[90%] object-contain"
          >
        </span>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- comment -%}
      Square and fixed on purpose. These were 72x52 and free to wrap, so a card with four
      colourways ran onto a second row and ended up taller than a two-colourway card beside
      it. `shrink-0` keeps every thumb identical whatever the count; the sizes are the largest
      that still fit all four (max_shown) plus 6px gaps on one line — the swatch row is
      ~152px on mobile and ~239px on desktop.
      object-contain rather than cover: product shots are wide, so a square crop would eat them.
      No outline on purpose — the source thumb (.swatch-circle) is a bare image.
    {%- endcomment -%}
    {%- comment -%} Source .swatch-circle: 48px square on #f8f8f8, 8px apart {%- endcomment -%}
    {%- liquid
      assign card_swatch = 'spy-swatches__item block h-12 w-12 shrink-0 overflow-hidden bg-[#f8f8f8]'
      assign card_swatch_img = 'block h-full w-full object-contain'
    -%}
    <div class="spy-swatches flex items-start justify-center gap-2" data-spy-swatches {{ block.shopify_attributes }}>
      {%- if color_option != nil and color_option.values.size > 0 -%}
        {%- for v in color_option.values limit: max_shown -%}
          {%- assign media = v.variant.featured_media | default: p.media[forloop.index0] | default: p.featured_media -%}
          {%- if media != blank -%}
            {%- assign v_url = v.variant.url | default: p.url -%}
            <a
              href="{{ v_url }}"
              class="{{ card_swatch }}"
              data-full="{{ media | image_url: width: 640 }}"
              aria-label="{{ p.title | escape }} – {{ v.name | escape }}"
            >
              <img src="{{ media | image_url: width: 144 }}" alt="{{ v.name | escape }}" width="36" height="36" loading="lazy" class="{{ card_swatch_img }}">
            </a>
          {%- endif -%}
        {%- endfor -%}
        {%- if color_option.values.size > max_shown -%}
          {%- comment -%} 32x10 arrow, the source's `.view-pdp-link svg` {%- endcomment -%}
          <a href="{{ p.url }}" class="spy-swatches__more inline-flex h-12 shrink-0 items-center text-spy-gray hover:text-spy-orange no-underline" aria-label="View all {{ color_option.values.size }} colors">
            <svg width="32" height="10" viewBox="0 0 32 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M0.5 5H30.42" stroke="currentColor" stroke-miterlimit="10"></path>
              <path d="M27.1 9.09L26.42 8.36L30.03 5L26.42 1.64L27.1 0.91L31.5 5L27.1 9.09Z" fill="currentColor"></path>
            </svg>
          </a>
        {%- endif -%}
      {%- elsif p.featured_media != blank -%}
        <a
          href="{{ p.url }}"
          class="{{ card_swatch }}"
          data-full="{{ p.featured_media | image_url: width: 640 }}"
          aria-label="{{ p.title | escape }}"
        >
          <img src="{{ p.featured_media | image_url: width: 144 }}" alt="{{ p.title | escape }}" width="36" height="36" loading="lazy" class="{{ card_swatch_img }}">
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}

{%- unless is_pdp -%}
  <script src="{{ 'spy-card.js' | asset_url }}" defer></script>
{%- endunless -%}

{% schema %}
{
  "name": "Color Preview",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        { "value": "card", "label": "Card thumbnails" },
        { "value": "pdp", "label": "Product page colour picker" }
      ],
      "default": "card"
    }
  ],
  "presets": [
    {
      "name": "Color Preview",
      "category": "SPY"
    }
  ]
}
{% endschema %}

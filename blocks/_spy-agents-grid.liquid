{%- comment -%}
  Agents grid — holds one card per person.

  One breakpoint at 990px, not a gradual 4/3/2 step-down. The site header stops
  fitting below 990, so everything under that is treated as one stacked layout:
  a single column, each portrait filling the width. A short trailing row (3 cards
  after 4) just stays left-aligned above 990, which is what the source does.

  Label colours and size live here, not on each card: the cards read them as CSS
  variables so all seven stay in sync from one place.

  Note: `[display:grid]`, not Tailwind's `grid`. Horizon's base.css owns a `.grid`
  class of its own — the 14-column page layout, with `grid-template-areas` — and
  those 14 named areas would force 14 explicit columns here no matter what we set.
{%- endcomment -%}

<div
  class="
    spy-agents-grid [display:grid] w-full
    [grid-template-columns:repeat(var(--agents-cols-stacked),minmax(0,1fr))]
    min-[990px]:[grid-template-columns:repeat(var(--agents-cols),minmax(0,1fr))]
  "
  style="
    --agents-cols: {{ block.settings.columns_desktop }};
    --agents-cols-stacked: {{ block.settings.columns_stacked }};
    --agent-ratio: {{ block.settings.image_ratio }};
    --agent-card-bg: {{ block.settings.card_background }};
    --agent-label-bg: {{ block.settings.label_background }};
    --agent-label-color: {{ block.settings.label_color }};
    --agent-label-size: {{ block.settings.label_size }}px;
    --agent-label-size-mobile: {{ block.settings.label_size_mobile }}px;
    --agent-label-offset: {{ block.settings.label_offset }}px;
    gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Agents grid",
  "tag": null,
  "blocks": [
    { "type": "_spy-agent-card" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop (990px and up)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_stacked",
      "label": "Below 990px",
      "info": "1 means each portrait fills the full width.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ],
      "default": "1/1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Name label"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Text color",
      "default": "#ee7624"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Background color",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Font size — 990px and up",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "label": "Font size — below 990px",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "label_offset",
      "label": "Distance from card bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ]
}
{% endschema %}

{%- comment -%}
  Agents grid — holds one card per person.

  Column counts are per breakpoint, so the source's 4-up desktop row can drop to
  3-up and 2-up without the cards ever squashing. A short trailing row (3 cards
  after 4) just stays left-aligned, which is what the source does.

  Label colours and size live here, not on each card: the cards read them as CSS
  variables so all seven stay in sync from one place.

  Note: `[display:grid]`, not Tailwind's `grid`. Horizon's base.css owns a `.grid`
  class of its own — the 14-column page layout, with `grid-template-areas` — and
  those 14 named areas would force 14 explicit columns here no matter what we set.
{%- endcomment -%}

<div
  class="
    spy-agents-grid [display:grid] w-full
    [grid-template-columns:repeat(var(--agents-cols-mobile),minmax(0,1fr))]
    min-[750px]:[grid-template-columns:repeat(var(--agents-cols-tablet),minmax(0,1fr))]
    min-[1100px]:[grid-template-columns:repeat(var(--agents-cols),minmax(0,1fr))]
  "
  style="
    --agents-cols: {{ block.settings.columns_desktop }};
    --agents-cols-tablet: {{ block.settings.columns_tablet }};
    --agents-cols-mobile: {{ block.settings.columns_mobile }};
    --agent-ratio: {{ block.settings.image_ratio }};
    --agent-card-bg: {{ block.settings.card_background }};
    --agent-label-bg: {{ block.settings.label_background }};
    --agent-label-color: {{ block.settings.label_color }};
    --agent-label-size: {{ block.settings.label_size }}px;
    --agent-label-size-mobile: {{ block.settings.label_size_mobile }}px;
    --agent-label-offset: {{ block.settings.label_offset }}px;
    gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Agents grid",
  "tag": null,
  "blocks": [
    { "type": "_spy-agent-card" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ],
      "default": "1/1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Name label"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Text color",
      "default": "#ee7624"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Background color",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Font size — desktop",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "label": "Font size — mobile",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "label_offset",
      "label": "Distance from card bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ]
}
{% endschema %}

{%- doc -%}
  One reusable Yotpo classic widget.

  Yotpo ships app blocks for some widgets but not the reviews carousel or the photo
  gallery, so those stay classic embeds — a div whose class and data attributes Yotpo's
  script reads on load. Rather than paste that markup per page, every id and option is
  a setting here, so the same block covers the homepage site-wide carousel, a per-product
  carousel on a PDP, and the photo gallery.

  The loader lives in snippets/spy-yotpo-loader.liquid, rendered site-wide from the
  layout. Without it these divs stay empty.

  Each Yotpo widget on a page needs its own element id — the source uses 1 for the
  carousel and 2 for the gallery.
{%- enddoc -%}

{%- liquid
  assign widget = block.settings.widget | default: 'reviews_carousel'
  assign size_class = block.settings.size_class

  # per_product needs an id; fall back to the page's product so a PDP needs no wiring
  assign pid = block.settings.product.id | default: closest.product.id | default: product.id

  assign autoplay = '0'
  if block.settings.autoplay
    assign autoplay = '1'
  endif
  assign bottomline = '0'
  if block.settings.show_bottomline
    assign bottomline = '1'
  endif
  assign navigation = '0'
  if block.settings.show_navigation
    assign navigation = '1'
  endif
-%}

{%- if widget == 'pictures_gallery' -%}
  {%- if block.settings.gallery_id != blank -%}
    <div
      class="yotpo yotpo-pictures-widget w-full {{ size_class }}"
      data-gallery-id="{{ block.settings.gallery_id }}"
      data-yotpo-element-id="{{ block.settings.element_id }}"
      {{ block.shopify_attributes }}
    ></div>
  {%- elsif request.design_mode -%}
    <p class="m-0 text-[13px] text-[color:var(--color-spy-muted)]" {{ block.shopify_attributes }}>
      Add a Yotpo gallery ID to show this widget.
    </p>
  {%- endif -%}

{%- else -%}
  {%- comment -%} &nbsp; is in Yotpo's own snippet — the widget needs a non-empty node {%- endcomment -%}
  <div
    class="yotpo yotpo-reviews-carousel w-full {{ size_class }}"
    data-background-color="{{ block.settings.background_color }}"
    data-mode="{{ block.settings.mode }}"
    data-type="{{ block.settings.source }}"
    data-count="{{ block.settings.count }}"
    data-show-bottomline="{{ bottomline }}"
    data-autoplay-enabled="{{ autoplay }}"
    data-autoplay-speed="{{ block.settings.autoplay_speed }}"
    data-show-navigation="{{ navigation }}"
    {% if block.settings.source == 'per_product' and pid != blank %}
      data-product-id="{{ pid }}"
    {% endif %}
    data-yotpo-element-id="{{ block.settings.element_id }}"
    {{ block.shopify_attributes }}
  >&nbsp;</div>
{%- endif -%}

{% schema %}
{
  "name": "Yotpo Widget",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "widget",
      "label": "Widget",
      "options": [
        { "value": "reviews_carousel", "label": "Reviews carousel" },
        { "value": "pictures_gallery", "label": "Photo gallery" }
      ],
      "default": "reviews_carousel"
    },
    {
      "type": "text",
      "id": "element_id",
      "label": "Yotpo element ID",
      "info": "Each Yotpo widget on the same page needs its own number.",
      "default": "1"
    },
    {
      "type": "text",
      "id": "size_class",
      "label": "Yotpo size class",
      "info": "Leave empty unless Yotpo's install dialog gives one."
    },
    {
      "type": "header",
      "content": "Photo gallery",
      "visible_if": "{{ block.settings.widget == 'pictures_gallery' }}"
    },
    {
      "type": "text",
      "id": "gallery_id",
      "label": "Gallery ID",
      "info": "Yotpo admin > Visual UGC > Galleries.",
      "visible_if": "{{ block.settings.widget == 'pictures_gallery' }}"
    },
    {
      "type": "header",
      "content": "Reviews carousel",
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Reviews shown",
      "options": [
        { "value": "site", "label": "Whole store" },
        { "value": "per_product", "label": "One product" }
      ],
      "default": "site",
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Only used when 'One product' is selected. Leave empty on a product page to use that product."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Order",
      "options": [
        { "value": "top_rated", "label": "Top rated" },
        { "value": "most_recent", "label": "Most recent" }
      ],
      "default": "top_rated",
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Reviews",
      "min": 3,
      "max": 30,
      "step": 1,
      "default": 9,
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "text",
      "id": "background_color",
      "label": "Background",
      "default": "transparent",
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "show_bottomline",
      "label": "Show the star summary",
      "default": true,
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "default": 3000,
      "visible_if": "{{ block.settings.widget == 'reviews_carousel' and block.settings.autoplay }}"
    }
  ],
  "presets": [
    {
      "name": "Yotpo Widget",
      "category": "SPY"
    }
  ]
}
{% endschema %}

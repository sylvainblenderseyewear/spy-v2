

{% doc %}
  Cart Title

  Renders the cart title or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state

  @example
  {% render 'cart-title', force_empty: true %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
  if block_settings.text_color != blank
    render 'contrast-override', background_color: '', text_color: block_settings.text_color, section_id: block.id
  endif
%}

{%- liquid
  # 'spy' = the source heading: fluid 21.6-24px, 600, ink
  assign spy_type = false
  if block_settings.type_preset == 'spy'
    assign spy_type = true
  endif
-%}

<div
  class="cart-title spacing-style text-{{ block_settings.alignment }}{% if block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <h1 class="m-0 {% if spy_type %}block text-[calc(1.275rem_+_0.3vw)] min-[1200px]:text-[24px] font-semibold leading-[1.2] tracking-normal normal-case text-spy-ink{% else %}inline-flex items-center gap-[var(--gap-sm)] {{ block_settings.type_preset | default: 'h2' }}{% endif %}">
    {%- if cart.empty? or force_empty -%}
      {{ 'content.your_cart_is_empty' | t }}
    {%- else -%}
      {{ block_settings.title }}
      {%- if block_settings.show_count -%}
        {%- comment -%} Source prints the count inline in brackets, no pill {%- endcomment -%}
        <span class="{% if spy_type %}[&_.cart-bubble]:inline [&_.cart-bubble]:static [&_.cart-bubble]:size-auto [&_.cart-bubble]:min-w-0 [&_.cart-bubble]:aspect-auto [&_.cart-bubble]:p-0 [&_.cart-bubble]:bg-transparent [&_.cart-bubble]:text-inherit [&_.cart-bubble\_\_background]:hidden [&_.cart-bubble\_\_text]:static [&_.cart-bubble\_\_text]:inline [&_.cart-bubble\_\_text]:[font:inherit] [&_.cart-bubble\_\_text]:text-inherit [&_.cart-bubble\_\_text-count]:inline-flex [&_.cart-bubble\_\_text-count]:before:content-['('] [&_.cart-bubble\_\_text-count]:after:content-[')']{% else %}[&_.cart-bubble]:inline-flex [&_.cart-bubble]:items-center [&_.cart-bubble]:justify-center [&_.cart-bubble]:w-fit [&_.cart-bubble]:aspect-auto [&_.cart-bubble]:p-[var(--cart-padding)] [&_.cart-bubble[data-maintain-ratio]]:size-[min(1lh,26px)] [&_.cart-bubble\_\_background]:bg-[rgb(var(--color-foreground-rgb)/var(--opacity-10-25))] [&_.cart-bubble\_\_text]:text-[var(--color-foreground)] [&_.cart-bubble\_\_text]:text-[length:clamp(var(--font-size--3xs),0.75em,var(--font-size--xs))]{% endif %}">
          {%- render 'cart-bubble' -%}
        </span>
      {%- endif -%}
    {%- endif -%}
  </h1>
</div>

{% schema %}
{
  "name": "t:names.title",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:settings.cart_title",
      "default": "t:text_defaults.cart"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:settings.cart_count",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "spy",
          "label": "SPY cart heading"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.title"
    }
  ]
}
{% endschema %}

{%- doc -%}
  Compact star rating for Quick View only — the PDP now shows the real Yotpo
  bottom line through a spy-app-embed block. Quick View fetches its markup, so
  Yotpo would need a refresh call after each fetch; until then this keeps the
  source's empty state (outline stars + "Write a review").
{%- enddoc -%}

<div class="spy-rating flex items-center gap-2" {{ block.shopify_attributes }}>
  <span class="inline-flex gap-0.5 text-[color:var(--color-spy-muted)]" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M10 1.7l2.5 5.1 5.6.8-4 3.9 1 5.6L10 14.5 4.9 17.1l1-5.6-4-3.9 5.6-.8L10 1.7Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
    {%- endfor -%}
  </span>
  <a href="#spy-reviews" class="text-[13px] text-[color:var(--color-spy-text-2)] underline decoration-current underline-offset-2 hover:text-spy-orange">
    {{ block.settings.empty_label | default: 'Write a review' }}
  </a>
</div>

{% schema %}
{
  "name": "Rating",
  "tag": null,
  "settings": [
    { "type": "text", "id": "empty_label", "label": "Label when no reviews", "default": "Write a review" }
  ],
  "presets": [{ "name": "Rating", "category": "SPY" }]
}
{% endschema %}

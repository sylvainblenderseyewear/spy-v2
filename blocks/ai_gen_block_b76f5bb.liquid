{% doc %}
  @prompt
    I want to make search box
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-box-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-search-box-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-search-box-form-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    transition: border-color 0.3s ease;
  }

  .ai-search-box-form-{{ ai_gen_id }}:focus-within {
    border-color: {{ block.settings.focus_border_color }};
  }

  .ai-search-box-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-search-box-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-search-box-input-{{ ai_gen_id }} {
    flex-grow: 1;
    border: none;
    background: transparent;
    font-size: {{ block.settings.input_font_size }}px;
    color: {{ block.settings.text_color }};
    outline: none;
    padding: 0;
    font-family: inherit;
  }

  .ai-search-box-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
    opacity: 1;
  }

  .ai-search-box-button-{{ ai_gen_id }} {
    flex-shrink: 0;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-transform: {{ block.settings.button_text_transform }};
    font-family: inherit;
  }

  .ai-search-box-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-search-box-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-search-box-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_font_size | times: 0.9 }}px;
    }

    .ai-search-box-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-search-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-search-box-wrapper-{{ ai_gen_id }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="ai-search-box-form-{{ ai_gen_id }}">
      {% if block.settings.show_icon %}
        <div class="ai-search-box-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>
      {% endif %}

      <input
        type="search"
        name="q"
        class="ai-search-box-input-{{ ai_gen_id }}"
        placeholder="{{ block.settings.placeholder_text }}"
        value="{{ search.terms | escape }}"
        aria-label="Search"
        autocomplete="off"
      >

      <input type="hidden" name="type" value="{{ block.settings.search_type }}">

      {% if block.settings.show_button %}
        <button type="submit" class="ai-search-box-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Search box",
  "settings": [
    {
      "type": "header",
      "content": "Search settings"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "default": "Search products..."
    },
    {
      "type": "select",
      "id": "search_type",
      "label": "Search type",
      "options": [
        {
          "value": "product",
          "label": "Products only"
        },
        {
          "value": "article",
          "label": "Articles only"
        },
        {
          "value": "page",
          "label": "Pages only"
        },
        {
          "value": "product,article,page",
          "label": "All content"
        }
      ],
      "default": "product"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Search box style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "focus_border_color",
      "label": "Focus border",
      "default": "#2c393e"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Search icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#6a6c77"
    },
    {
      "type": "header",
      "content": "Input field"
    },
    {
      "type": "range",
      "id": "input_font_size",
      "label": "Font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2c393e"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#6a6c77"
    },
    {
      "type": "header",
      "content": "Search button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show search button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Search"
    },
    {
      "type": "select",
      "id": "button_text_transform",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#2c393e"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#1D2A2B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Search box"
    }
  ]
}
{% endschema %}

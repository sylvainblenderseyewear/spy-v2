

{%- liquid
  assign block_settings = block.settings
  assign label = block_settings.label | strip_html | strip
  # Falls back to the sunglasses PLP so the bar ships with a working link
  assign href = block_settings.url | default: '/collections/sunglasses'
  assign block_index = section.blocks | find_index: 'id', block.id
-%}

{%- unless label == '' -%}
  <slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      [grid-area:stack]
      [display:flex] items-center justify-center
      transition-[opacity,visibility] duration-500 ease-in-out
      aria-hidden:opacity-0 aria-hidden:invisible
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <a
      class="announcement-bar__link [display:inline-flex] items-center gap-2 no-underline text-current opacity-100 transition-opacity duration-200 hover:opacity-70"
      href="{{ href }}"
    >
      {%- if block_settings.icon != blank -%}
        <span class="text-[13px] leading-none" aria-hidden="true">{{ block_settings.icon }}</span>
      {%- endif -%}
      <span class="text-[13px] font-bold uppercase leading-none tracking-[0.06em] max-md:text-[11px]">
        {{- block_settings.label -}}
      </span>
    </a>
  </slideshow-slide>
{%- endunless -%}

{% schema %}
{
  "name": "t:names.announcement",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon or emoji",
      "info": "Shown before the text. Leave empty to hide.",
      "default": "🔥"
    },
    {
      "type": "inline_richtext",
      "id": "label",
      "label": "t:settings.text",
      "default": "Check out the sale section"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:settings.link",
      "info": "Defaults to the Sunglasses collection when empty."
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement"
    }
  ]
}
{% endschema %}

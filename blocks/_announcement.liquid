{%- comment -%}
  One announcement message. The icon rides inside the link's own text run with a
  plain space after it — the source has no separate icon element and no flex gap,
  so a gap here would read as too much air around the emoji.
{%- endcomment -%}

{%- liquid
  assign block_settings = block.settings
  assign label = block_settings.label | strip_html | strip
  # Falls back to the sunglasses PLP so the bar ships with a working link
  assign href = block_settings.url | default: '/collections/sunglasses'
  assign block_index = section.blocks | find_index: 'id', block.id

  assign message = block_settings.label
  if block_settings.icon != blank
    assign message = block_settings.icon | append: ' ' | append: block_settings.label
  endif
-%}

{%- unless label == '' -%}
  <slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      [grid-area:stack]
      [display:flex] items-center justify-center text-center
      transition-[opacity,visibility] duration-500 ease-in-out
      aria-hidden:opacity-0 aria-hidden:invisible
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <a
      class="
        announcement-bar__link
        no-underline text-current
        text-[12px] font-semibold uppercase
        leading-[1.4] tracking-[0.3px]
        max-[769px]:leading-[1.5] max-[769px]:tracking-[0.2px]
        max-[481px]:leading-[1.6]
        transition-opacity duration-200
        hover:underline hover:opacity-90
      "
      href="{{ href }}"
    >{{ message }}</a>
  </slideshow-slide>
{%- endunless -%}

{% schema %}
{
  "name": "t:names.announcement",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon or emoji",
      "info": "Shown before the text. Leave empty to hide.",
      "default": "🔥"
    },
    {
      "type": "inline_richtext",
      "id": "label",
      "label": "t:settings.text",
      "default": "Check out the sale section"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:settings.link",
      "info": "Defaults to the Sunglasses collection when empty."
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement"
    }
  ]
}
{% endschema %}

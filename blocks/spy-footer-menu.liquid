{%- comment -%}
  SPY Footer Menu — one footer link column.
  Heading + link blocks (or a Shopify menu when the column has none).
  Collapses into an accordion below 769px, exactly like the source footer;
  forced open from 769px up (CSS only, no JS).
{%- endcomment -%}

{%- liquid
  assign menu = block.settings.menu
  assign heading = block.settings.heading | default: menu.title

  # Link blocks win when the column has any; the menu is the fallback.
  assign has_links = false
  if block.blocks.size > 0
    assign has_links = true
  endif
-%}

{%- comment -%} Missing setting on older saved blocks means shown. {%- endcomment -%}
{%- unless block.settings.show == false -%}
<details
  class="spy-fmenu group w-full min-[769px]:[&:not([open])>.spy-fmenu-panel]:block min-[769px]:[&::details-content]:[content-visibility:visible]"
  {{ block.shopify_attributes }}
>
  <summary class="spy-fmenu-head cursor-pointer list-none items-center justify-between gap-0 py-0 [display:flex] max-[992px]:py-1 min-[769px]:pointer-events-none [&::-webkit-details-marker]:hidden">
    <span
      class="mr-4 text-[length:var(--spy-fmenu-heading-size,16px)] leading-[var(--spy-fmenu-heading-lh,22.4px)] [font-weight:var(--spy-fmenu-heading-weight,600)] [text-transform:var(--spy-fmenu-heading-case,uppercase)]"
    >{{ heading }}</span>
    {%- comment -%}
      Source toggle: a 10px "+" from two 2px bars. Opening spins it half a turn and
      drops the upright bar to leave "−"; closing grows it back. 0.3s like the source.
    {%- endcomment -%}
    <span
      class="relative h-[10px] w-[10px] shrink-0 transition-transform duration-300 ease-[ease] group-open:rotate-180 min-[769px]:hidden
        before:absolute before:bottom-[4px] before:left-0 before:h-0 before:w-[10px] before:rotate-90 before:border-b-2 before:border-current before:transition-[width] before:duration-300 before:ease-[ease] before:content-[''] group-open:before:w-0 group-open:before:transition-none
        after:absolute after:bottom-[4px] after:left-0 after:h-0 after:w-[10px] after:border-b-2 after:border-current after:content-['']"
      aria-hidden="true"
    ></span>
  </summary>

  <div class="spy-fmenu-panel">
    {%- if has_links == false and menu != blank -%}
      {%- for link in menu.links -%}
        <div class="spy-fmenu-item text-[length:var(--spy-fmenu-link-size,12px)] leading-[var(--spy-fmenu-link-lh,20px)] max-[992px]:py-1">
          <a class="text-current no-underline" href="{{ link.url }}">{{ link.title }}</a>
        </div>
      {%- endfor -%}
    {%- endif -%}
    {% content_for 'blocks' %}
  </div>
</details>
{%- endunless -%}

{% schema %}
{
  "name": "SPY Footer Menu",
  "tag": null,
  "blocks": [
    { "type": "spy-footer-link" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Falls back to the menu name."
    },
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show this column",
      "default": true
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "paragraph",
      "content": "Add link blocks below to edit items right here. A column with no link blocks falls back to the Shopify menu."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu (fallback)"
    }
  ],
  "presets": [
    {
      "name": "SPY Footer Menu",
      "category": "SPY"
    }
  ]
}
{% endschema %}

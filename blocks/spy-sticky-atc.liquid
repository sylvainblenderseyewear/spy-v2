{%- liquid
  assign p = closest.product
  assign variant = p.selected_or_first_available_variant

  capture model_name
    render 'spy-group-name', product: p
  endcapture
  assign model_name = model_name | strip | default: p.title

  assign show_compare = false
  if variant.compare_at_price > variant.price
    assign show_compare = true
  endif
-%}

<div class="contents" data-spy-variant-sync="{{ block.id }}">
  <div
    class="invisible pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-spy-border bg-white px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] opacity-0 shadow-[0_-2px_12px_rgba(0,0,0,0.12)] transition-[opacity,translate,visibility] duration-300 ease-out data-[visible=true]:visible data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 motion-reduce:transition-none min-[769px]:hidden"
    data-spy-sticky-atc
    data-visible="false"
    aria-hidden="true"
    role="region"
    aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    {{ block.shopify_attributes }}
  >
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="m-0 truncate text-[14px] font-bold uppercase leading-5 tracking-[0.005em] text-spy-text">
          {{ model_name }}
        </p>
        <p class="m-0 text-[14px] font-medium leading-5 text-spy-text">
          {%- if show_compare -%}
            <span class="mr-1 text-[color:var(--color-spy-strike)] line-through">
              {{- variant.compare_at_price | money -}}
            </span>
          {%- endif -%}
          {{ variant.price | default: p.price_min | money }}
        </p>
      </div>
      <button
        type="button"
        data-spy-sticky-atc-button
        class="shrink-0 cursor-pointer border-0 bg-spy-orange-ui px-6 py-3.5 text-[0.875rem] uppercase leading-none tracking-[0.02em] text-white transition-colors hover:bg-[color:var(--color-primary-button-hover-background)] disabled:cursor-not-allowed disabled:opacity-[0.65]"
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        {{ block.settings.label | default: 'Add to Cart' }}
      </button>
    </div>
  </div>
</div>

<script src="{{ 'spy-sticky-atc.js' | asset_url }}" defer></script>
<script src="{{ 'spy-variant-sync.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sticky Add to Cart",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Button label", "default": "Add to Cart" }
  ],
  "presets": [{ "name": "Sticky Add to Cart", "category": "SPY" }]
}
{% endschema %}

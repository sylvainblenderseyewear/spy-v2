{%- doc -%}
  Grouped PLP card — one card per model instead of one per colourway.

  The section works out the group (from each product's `collection: xxx` tag)
  and hands this block the colourway that represents it plus the model name and
  colourway count. Everything else matches the stock `_product-card` block, so
  the card keeps the same shell, refs and appearance settings.

  @param {string} [group_name] - model name from the group tag
  @param {number} [group_count] - how many colourways the model has
  @param {string} [image_sizes] - sizes attribute for the card image
  @param {string} [product_view_context] - context passed to the view event

  @example
  {% content_for 'block',
    type: '_spy-grouped-product-card',
    id: 'grouped-product-card',
    closest.product: product,
    group_name: 'Cyrus',
    group_count: 23
  %}
{%- enddoc -%}

{%- render 'spy-grouped-product-card',
  product: closest.product,
  group_name: group_name,
  group_count: group_count,
  image_sizes: image_sizes,
  block: block,
  product_view_context: product_view_context
-%}

{% schema %}
{
  "name": "Grouped product card",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows one card per model. The model name and colourway count come from the products' `collection: xxx` tag."
    },
    {
      "type": "text",
      "id": "label_colors_one",
      "label": "Label — one colourway",
      "default": "1 color available"
    },
    {
      "type": "text",
      "id": "label_colors_many",
      "label": "Label — several colourways",
      "info": "Use [count] where the number goes.",
      "default": "[count] colors available"
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show Quick View on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "info": "Off by default: a model's colourways can differ in price.",
      "default": false
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}

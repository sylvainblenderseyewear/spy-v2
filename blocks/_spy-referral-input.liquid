{%- doc -%}
  Email field for the referral form.

  Two states, like the source: at rest a plain grey box with a grey placeholder;
  on hover or focus the border turns orange, the placeholder drops out and an
  orange label rises above the box.

  The label is always in the DOM and tied to the input, so screen readers get a
  real name — only its opacity changes. It is absolute, so showing it never
  shifts the button below; `space_above` reserves the room it needs.

  Size, colours and font come from the parent form block. Each override below
  only writes its variable when the editor sets one, so a blank field keeps the
  shared value.
{%- enddoc -%}

{%- liquid
  assign input_id = 'spy-referral-input-' | append: block.id
  assign own_size = block.settings.size_override
-%}

<div
  class="spy-referral-field group relative w-full [max-width:var(--rf-width,581px)] [margin-top:var(--rf-label-room)]"
  style="--rf-label-room: {{ block.settings.space_above }}px;"
  {{ block.shopify_attributes }}
>
  <label
    for="{{ input_id }}"
    class="
      absolute left-0 [bottom:calc(100%+var(--rf-label-gap))] m-0 whitespace-nowrap pointer-events-none
      opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100
      [font-family:var(--rf-font,var(--font-body--family))]
      [color:var(--rf-accent,#e57e26)]
      [font-size:var(--rf-label-size,13px)]
      leading-tight
    "
    style="
      --rf-label-gap: {{ block.settings.label_gap }}px;
      --rf-label-size: {{ block.settings.label_size }}px;
    "
  >
    {{ block.settings.label }}
  </label>

  <input
    id="{{ input_id }}"
    type="{{ block.settings.input_type }}"
    name="{{ block.settings.field_name | default: 'contact[email]' }}"
    placeholder="{{ block.settings.placeholder }}"
    autocomplete="email"
    {% if block.settings.required %}required{% endif %}
    class="
      block w-full m-0 bg-white border border-solid outline-none transition-colors duration-150
      [height:var(--rf-height,48px)]
      [padding-inline:var(--rf-input-pad)]
      [border-radius:var(--rf-radius,0px)]
      [border-color:var(--rf-border,#cccccc)]
      [font-family:var(--rf-font,var(--font-body--family))]
      [color:var(--rf-text,#242424)]
      [font-size:var(--rf-input-size,15px)]
      placeholder:[color:var(--rf-placeholder,#a6a6a6)]
      hover:[border-color:var(--rf-accent,#e57e26)]
      focus:[border-color:var(--rf-accent,#e57e26)]
      hover:placeholder:text-transparent
      focus:placeholder:text-transparent
      focus-visible:[box-shadow:0_0_0_3px_color-mix(in_srgb,var(--rf-accent,#e57e26)_35%,transparent)]
    "
    style="
      --rf-input-pad: {{ block.settings.padding_inline }}px;
      {% if own_size > 0 %}--rf-input-size: {{ own_size }}px;{% endif %}
    "
  >
</div>

{% schema %}
{
  "name": "Referral input",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label on hover or focus",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "field_name",
      "label": "Field name",
      "info": "contact[email] posts to the shop's contact form. Change it to match the referral provider.",
      "default": "contact[email]"
    },
    {
      "type": "select",
      "id": "input_type",
      "label": "Input type",
      "options": [
        { "value": "email", "label": "Email" },
        { "value": "text", "label": "Text" }
      ],
      "default": "email"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "space_above",
      "label": "Space above",
      "info": "Room for the label that appears on hover.",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap between label and box",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Inner side padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Overrides"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "size_override",
      "label": "Text size override",
      "info": "0 uses the size set on the form.",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}

{%- doc -%}
  "Meet the Change Agents" — headline plus a tight grid of portrait cards.

  The grid, the label look and the card ratio live here so every card matches; the
  cards themselves only carry their own image, name and link. Those shared values
  are handed down as CSS variables, since a child block cannot read its parent's
  settings.

  Columns are set per breakpoint (desktop / tablet / mobile) as the source layout
  differs at each.
{%- enddoc -%}

{%- liquid
  assign settings = block.settings

  # Fixed class strings so Tailwind keeps them in the build
  case settings.columns_mobile
    when '1'
      assign cols_mobile = 'grid-cols-1'
    when '3'
      assign cols_mobile = 'grid-cols-3'
    else
      assign cols_mobile = 'grid-cols-2'
  endcase

  case settings.columns_tablet
    when '1'
      assign cols_tablet = 'md:grid-cols-1'
    when '3'
      assign cols_tablet = 'md:grid-cols-3'
    when '4'
      assign cols_tablet = 'md:grid-cols-4'
    else
      assign cols_tablet = 'md:grid-cols-2'
  endcase

  case settings.columns_desktop
    when '2'
      assign cols_desktop = 'lg:grid-cols-2'
    when '3'
      assign cols_desktop = 'lg:grid-cols-3'
    when '5'
      assign cols_desktop = 'lg:grid-cols-5'
    when '6'
      assign cols_desktop = 'lg:grid-cols-6'
    else
      assign cols_desktop = 'lg:grid-cols-4'
  endcase

  case settings.gap
    when '0'
      assign gap_class = 'gap-0'
    when '2'
      assign gap_class = 'gap-[2px]'
    when '8'
      assign gap_class = 'gap-2'
    when '12'
      assign gap_class = 'gap-3'
    when '16'
      assign gap_class = 'gap-4'
    when '24'
      assign gap_class = 'gap-6'
    else
      assign gap_class = 'gap-1'
  endcase

  if settings.heading_case == 'uppercase'
    assign heading_case_class = 'uppercase'
  else
    assign heading_case_class = 'normal-case'
  endif

  if settings.label_case == 'uppercase'
    assign label_case = 'uppercase'
  else
    assign label_case = 'none'
  endif

  case settings.label_alignment
    when 'left'
      assign label_justify = 'flex-start'
    when 'right'
      assign label_justify = 'flex-end'
    else
      assign label_justify = 'center'
  endcase

  assign heading_letter_spacing = settings.heading_letter_spacing | divided_by: 1000.0
-%}

{%- comment -%} Gutter sits on the outer box, so "max width" measures the grid itself {%- endcomment -%}
<div
  class="w-full px-4 md:px-8"
  style="
    padding-block: {{ settings.padding_top }}px {{ settings.padding_bottom }}px;
    --spy-ag-heading-size-m: {{ settings.heading_size_mobile }}px;
    --spy-ag-heading-size-d: {{ settings.heading_size_desktop }}px;
    --spy-ag-ratio: {{ settings.image_ratio }};
    --spy-ag-label-bg: {{ settings.label_background }};
    --spy-ag-label-color: {{ settings.label_text_color }};
    --spy-ag-label-size-m: {{ settings.label_size_mobile }}px;
    --spy-ag-label-size-d: {{ settings.label_size_desktop }}px;
    --spy-ag-label-offset: {{ settings.label_offset }}px;
    --spy-ag-label-justify: {{ label_justify }};
    --spy-ag-label-case: {{ label_case }};
  "
  {{ block.shopify_attributes }}
>
  <div class="mx-auto w-full" style="max-width: {{ settings.max_width }}px;">
    {%- if settings.heading != blank -%}
      {%- comment -%} No m-0 class: Tailwind runs in important mode and would win over the inline margin {%- endcomment -%}
      <h2
        class="
          text-center font-bold {{ heading_case_class }}
          font-[family-name:var(--font-heading--family)]
          text-[length:var(--spy-ag-heading-size-m)] md:text-[length:var(--spy-ag-heading-size-d)]
        "
        style="
          color: {{ settings.heading_color }};
          letter-spacing: {{ heading_letter_spacing }}em;
          margin: 0 0 {{ settings.heading_gap }}px;
        "
      >
        {{ settings.heading }}
      </h2>
    {%- endif -%}

    <div class="grid {{ cols_mobile }} {{ cols_tablet }} {{ cols_desktop }} {{ gap_class }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}

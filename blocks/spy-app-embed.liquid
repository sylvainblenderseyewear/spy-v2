{%- doc -%}
  One block for any third-party widget embed.

  Apps like Yotpo hand you a snippet to paste — a div with data attributes their
  script reads on load. Pasting that per page means the markup is frozen in the
  template and an editor cannot change an id. This block covers three cases with one
  file:

  - Custom code: paste any app's snippet as-is. Liquid inside it is evaluated, so a
    per-product embed like data-product-id="{{ product.id }}" works.
  - Yotpo photo gallery / reviews carousel: every id and option is a real setting,
    so the same block serves the homepage, a PDP, or anywhere else.

  Yotpo's script comes from its app embed (theme editor > App embeds), not from
  the theme. We used to load it by hand too, which ran widget.js twice and broke
  the widgets. Without the app embed on, these divs stay empty.

  The markup is kept byte-identical to what the app's dialog gives: no extra classes
  and no extra attributes unless a setting asks for them.
{%- enddoc -%}

{%- liquid
  assign embed = block.settings.embed | default: 'custom'

  assign extra = ''
  if block.settings.extra_class != blank
    assign extra = ' ' | append: block.settings.extra_class
  endif

  # per_product and the star rating both need the page's product
  assign yp = block.settings.product | default: closest.product | default: product
  assign pid = yp.id

  # Yotpo wants an absolute image URL; image_url gives a shop-relative one
  assign yp_img = yp.featured_image | image_url: width: 600
  assign yp_img_head = yp_img | slice: 0, 2
  if yp_img_head == '//'
    assign yp_img = 'https:' | append: yp_img
  elsif yp_img != blank
    assign yp_img = shop.url | append: yp_img
  endif

  # reviews were collected against the old store's ids, so allow a mapping
  if block.settings.legacy_id_metafield != blank
    assign mf = block.settings.legacy_id_metafield | split: '.'
    assign legacy = yp.metafields[mf[0]][mf[1]].value
    if legacy != blank
      assign pid = legacy
    endif
  endif
  if block.settings.legacy_id_preview != blank
    assign pid = block.settings.legacy_id_preview
  endif

  assign autoplay = '0'
  if block.settings.autoplay
    assign autoplay = '1'
  endif
  assign bottomline = '0'
  if block.settings.show_bottomline
    assign bottomline = '1'
  endif
  assign navigation = '0'
  if block.settings.show_navigation
    assign navigation = '1'
  endif
-%}

{%- case embed -%}
  {%- when 'yotpo_gallery' -%}
    {%- if block.settings.gallery_id != blank -%}
      <div
        class="yotpo yotpo-pictures-widget{{ extra }}"
        data-gallery-id="{{ block.settings.gallery_id }}"
        {% if block.settings.element_id != blank %}data-yotpo-element-id="{{ block.settings.element_id }}"{% endif %}
        {{ block.shopify_attributes }}
      ></div>
    {%- elsif request.design_mode -%}
      <p class="m-0 text-[13px] text-[color:var(--color-spy-muted)]" {{ block.shopify_attributes }}>
        Add a Yotpo gallery ID to show this widget.
      </p>
    {%- endif -%}

  {%- when 'yotpo_bottomline' -%}
    {%- comment -%}
      Stars + "N Reviews" beside the price. Source wraps the same div in .ratings,
      which paints the star font orange and sizes the row; the label is DIN 13px.
      Stays empty until Yotpo has reviews for the id we send.
    {%- endcomment -%}
    <div
      class="
        spy-rating-embed text-spy-orange-ui text-[0.6875rem]
        [&_.yotpo-stars]:mr-px
        [&_.text-m]:font-spy [&_.text-m]:text-[13px] [&_.text-m]:text-spy-review-label
        [&_.text-m]:whitespace-nowrap [&_.text-m]:no-underline
      "
      {{ block.shopify_attributes }}
    >
      <div
        class="yotpo bottomLine{{ extra }}"
        data-product-id="{{ pid }}"
        data-name="{{ yp.title | escape }}"
        data-url="{{ shop.url }}{{ yp.url }}"
        data-image-url="{{ yp_img }}"
        data-description="{{ yp.description | strip_html | truncate: 300 | escape }}"
        {% if block.settings.element_id != blank %}data-yotpo-element-id="{{ block.settings.element_id }}"{% endif %}
      ></div>
    </div>

  {%- when 'yotpo_reviews' -%}
    {%- comment -%} &nbsp; is in Yotpo's own snippet — the widget needs a non-empty node {%- endcomment -%}
    <div
      class="yotpo yotpo-reviews-carousel{{ extra }}"
      data-background-color="{{ block.settings.background_color }}"
      data-mode="{{ block.settings.mode }}"
      data-type="{{ block.settings.source }}"
      data-count="{{ block.settings.count }}"
      data-show-bottomline="{{ bottomline }}"
      data-autoplay-enabled="{{ autoplay }}"
      data-autoplay-speed="{{ block.settings.autoplay_speed }}"
      data-show-navigation="{{ navigation }}"
      {% if block.settings.source == 'per_product' and pid != blank %}data-product-id="{{ pid }}"{% endif %}
      {% if block.settings.element_id != blank %}data-yotpo-element-id="{{ block.settings.element_id }}"{% endif %}
      {{ block.shopify_attributes }}
    >&nbsp;</div>

  {%- else -%}
    {%- if block.settings.code != blank -%}
      <div class="spy-app-embed{{ extra }}" {{ block.shopify_attributes }}>{{ block.settings.code }}</div>
    {%- elsif request.design_mode -%}
      <p class="m-0 text-[13px] text-[color:var(--color-spy-muted)]" {{ block.shopify_attributes }}>
        Paste the app's embed code to show this widget.
      </p>
    {%- endif -%}
{%- endcase -%}

{% schema %}
{
  "name": "App Embed",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "embed",
      "label": "Embed",
      "options": [
        { "value": "custom", "label": "Custom code" },
        { "value": "yotpo_gallery", "label": "Yotpo photo gallery" },
        { "value": "yotpo_reviews", "label": "Yotpo reviews carousel" },
        { "value": "yotpo_bottomline", "label": "Yotpo star rating" }
      ],
      "default": "custom"
    },
    {
      "type": "liquid",
      "id": "code",
      "label": "Embed code",
      "info": "Paste the snippet the app gives you. Liquid is evaluated, so {{ product.id }} works.",
      "visible_if": "{{ block.settings.embed == 'custom' }}"
    },
    {
      "type": "text",
      "id": "extra_class",
      "label": "Extra CSS class",
      "info": "Optional. Some apps ask for a size class such as yotpo-size-7."
    },
    {
      "type": "text",
      "id": "element_id",
      "label": "Yotpo element ID",
      "info": "Optional. Only needed when two Yotpo widgets share a page.",
      "visible_if": "{{ block.settings.embed != 'custom' }}"
    },
    {
      "type": "header",
      "content": "Star rating",
      "visible_if": "{{ block.settings.embed == 'yotpo_bottomline' }}"
    },
    {
      "type": "text",
      "id": "legacy_id_metafield",
      "label": "Legacy review ID metafield",
      "info": "Reviews are keyed to the old site's product IDs, not Shopify's. Point this at the metafield holding it, e.g. spec.legacy_id. Empty uses the Shopify product ID.",
      "visible_if": "{{ block.settings.embed == 'yotpo_bottomline' }}"
    },
    {
      "type": "text",
      "id": "legacy_id_preview",
      "label": "Preview with a fixed ID",
      "info": "Overrides everything so the design can be checked before the migration fills the metafield. Clear it before launch.",
      "visible_if": "{{ block.settings.embed == 'yotpo_bottomline' }}"
    },
    {
      "type": "header",
      "content": "Photo gallery",
      "visible_if": "{{ block.settings.embed == 'yotpo_gallery' }}"
    },
    {
      "type": "text",
      "id": "gallery_id",
      "label": "Gallery ID",
      "info": "Yotpo admin > Visual UGC > the gallery's Get the code dialog.",
      "visible_if": "{{ block.settings.embed == 'yotpo_gallery' }}"
    },
    {
      "type": "header",
      "content": "Reviews carousel",
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Reviews shown",
      "options": [
        { "value": "site", "label": "Whole store" },
        { "value": "per_product", "label": "One product" }
      ],
      "default": "site",
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Only used for a one-product carousel. Leave empty on a product page to use that product."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Order",
      "options": [
        { "value": "top_rated", "label": "Top rated" },
        { "value": "most_recent", "label": "Most recent" }
      ],
      "default": "top_rated",
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Reviews",
      "min": 3,
      "max": 30,
      "step": 1,
      "default": 9,
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "text",
      "id": "background_color",
      "label": "Background",
      "default": "transparent",
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "checkbox",
      "id": "show_bottomline",
      "label": "Show the star summary",
      "default": true,
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "default": 3000,
      "visible_if": "{{ block.settings.embed == 'yotpo_reviews' and block.settings.autoplay }}"
    }
  ],
  "presets": [
    {
      "name": "App Embed",
      "category": "SPY"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Only for RX-eligible frames.
  - Visibility: shown if spec.available_rx is true, spec.rx_url has a value, or `always_show` is on.
  - Link priority: product's spec.rx_url → block "Fallback RX partner URL" → SportRx default.
{%- endcomment -%}
{%- assign rx_ok = closest.product.metafields.spec.available_rx.value -%}
{%- assign rx_product_url = closest.product.metafields.spec.rx_url.value | append: '' | strip -%}

{%- assign rx_href = block.settings.rx_url | default: 'https://www.sportrx.com' -%}
{%- if rx_product_url != blank -%}
  {%- assign rx_href = rx_product_url -%}
{%- endif -%}

{%- if rx_ok or rx_product_url != blank or block.settings.always_show -%}
<a
  href="{{ rx_href }}"
  class="flex items-center justify-center w-full py-3 mt-8 border border-spy-orange-ui text-spy-orange-ui uppercase font-bold text-[0.8125rem] tracking-[0.06em] no-underline hover:bg-spy-orange-ui hover:text-white transition-colors"
  {% if block.settings.open_new_tab %}target="_blank" rel="noopener nofollow"{% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.label | default: 'Buy in Prescription' }}
  {%- if block.settings.open_new_tab %}<span class="sr-only"> {{ 'accessibility.new_window' | t }}</span>{% endif %}
</a>
{%- endif -%}

{% schema %}
{
  "name": "RX Button",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Buy in Prescription" },
    { "type": "url", "id": "rx_url", "label": "Fallback RX partner URL", "info": "Used when the product's spec.rx_url metafield is empty." },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": true },
    { "type": "checkbox", "id": "always_show", "label": "Show even if spec.available_rx is false and spec.rx_url is empty", "default": false }
  ],
  "presets": [{ "name": "RX Button", "category": "SPY" }]
}
{% endschema %}
{%- comment -%}
  Only for RX-eligible frames. spec.available_rx controls visibility AND, when it
  holds a URL, supplies the link for that product.
  Link priority: product metafield URL → block "RX partner URL" setting → SportRx default.
  The `always_show` setting is the escape hatch if the metafield is wrong for a given line.
{%- endcomment -%}
{%- assign rx_value = closest.product.metafields.spec.available_rx.value -%}
{%- assign rx_str = rx_value | append: '' -%}

{%- assign rx_href = block.settings.rx_url | default: 'https://www.sportrx.com' -%}
{%- if rx_str contains 'http' -%}
  {%- assign rx_href = rx_str -%}
{%- endif -%}

{%- if rx_value or block.settings.always_show -%}
<a
  href="{{ rx_href }}"
  class="flex items-center justify-center w-full py-3 mt-8 border border-spy-orange-ui text-spy-orange-ui uppercase font-bold text-[0.8125rem] tracking-[0.06em] no-underline hover:bg-spy-orange-ui hover:text-white transition-colors"
  {% if block.settings.open_new_tab %}target="_blank" rel="noopener nofollow"{% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.label | default: 'Buy in Prescription' }}
  {%- if block.settings.open_new_tab %}<span class="sr-only"> {{ 'accessibility.new_window' | t }}</span>{% endif %}
</a>
{%- endif -%}

{% schema %}
{
  "name": "RX Button",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Buy in Prescription" },
    { "type": "url", "id": "rx_url", "label": "Fallback RX partner URL", "info": "Used when the product's spec.available_rx metafield doesn't contain a URL." },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": true },
    { "type": "checkbox", "id": "always_show", "label": "Show even if spec.available_rx is empty or false", "default": false }
  ],
  "presets": [{ "name": "RX Button", "category": "SPY" }]
}
{% endschema %}
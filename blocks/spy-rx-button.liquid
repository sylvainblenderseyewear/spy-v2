{%- liquid
  assign p = closest.product
  assign rx_ok = p.metafields.spec.available_rx.value
  assign rx_product_url = p.metafields.spec.rx_url.value | append: '' | strip

  assign rx_href = block.settings.rx_url | default: 'https://www.sportrx.com'
  if rx_product_url != blank
    assign rx_href = rx_product_url
  endif

  assign match_keys = '^'
  assign type_key = p.type | handleize
  if type_key != blank
    assign match_keys = match_keys | append: type_key | append: '^'
  endif
  for tag in p.tags
    assign tag_key = tag | handleize
    assign match_keys = match_keys | append: tag_key | append: '^'
  endfor
  for coll in p.collections
    assign match_keys = match_keys | append: coll.handle | append: '^'
  endfor

  assign force_show = false
  assign wanted = block.settings.always_show_for | split: ','
  for item in wanted
    assign item_key = item | handleize
    if item_key == blank
      continue
    endif
    assign probe = '^' | append: item_key | append: '^'
    if match_keys contains probe
      assign force_show = true
      break
    endif
  endfor
-%}

{%- if rx_ok or rx_product_url != blank or force_show or block.settings.always_show -%}
  <a
    href="{{ rx_href }}"
    class="mt-8 flex w-full items-center justify-center border border-spy-orange-ui py-3 text-[0.8125rem] font-bold uppercase tracking-[0.06em] text-spy-orange-ui no-underline transition-colors hover:bg-spy-orange-ui hover:text-white"
    {% if block.settings.open_new_tab %}
      target="_blank"
      rel="noopener nofollow"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.label | default: 'Buy in Prescription' }}
    {%- if block.settings.open_new_tab %}<span class="sr-only"> {{ 'accessibility.new_window' | t }}</span>{% endif %}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "RX Button",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Buy in Prescription" },
    { "type": "url", "id": "rx_url", "label": "Fallback RX partner URL", "info": "Used when the product's spec.rx_url metafield is empty." },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": true },
    {
      "type": "text",
      "id": "always_show_for",
      "label": "Always show for",
      "info": "Comma-separated product types, tags or collection handles that get the button even when spec.available_rx is false.",
      "default": "eyeglasses"
    },
    { "type": "checkbox", "id": "always_show", "label": "Show even if spec.available_rx is false and spec.rx_url is empty", "default": false }
  ],
  "presets": [{ "name": "RX Button", "category": "SPY" }]
}
{% endschema %}

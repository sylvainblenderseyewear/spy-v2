{%- doc -%}
  "Notify me when back in stock" — shows only when the current variant is sold out.

  With "Open the Back in Stock app popup" on, the button opens the AMP Back in Stock
  popup for this variant. The app's script is loaded on demand from the
  "widget script URL" setting (spy-notify-me.js), not on every page. Its list holds every sold-out colourway of the colour row
  (data-spy-notify-variants, also on the swatches), so another colour can be picked
  there. The app keeps the list and sends the restock email.
  If the app hasn't loaded, the small email form below opens instead (Shopify's
  contact form, lands in the shop's inbox), like the source PDP.
  Click logic lives in spy-notify-me.js.
{%- enddoc -%}

{%- liquid
  assign p = closest.product
  assign variant = p.selected_or_first_available_variant
  assign form_id = 'spy-notify-' | append: block.id
  assign panel_id = 'spy-notify-panel-' | append: block.id

  # The popup's heading: the model, as the colours sit in its list
  capture model_name
    render 'spy-group-name', product: p
  endcapture
  assign model_name = model_name | strip | default: p.title

  # The size joins the label when the frame comes in 2+ real sizes, as on the swatches
  assign size_keys = '^'
  assign size_total = 0
  for opt in p.options_with_values
    assign opt_name = opt.name | downcase
    if opt_name == 'size'
      for value in opt.values
        assign size_key = value.name | downcase | replace: '-', ' ' | split: ' ' | join: ' '
        assign size_probe = '^' | append: size_key | append: '^'
        unless size_keys contains size_probe
          assign size_keys = size_keys | append: size_key | append: '^'
          assign size_total = size_total | plus: 1
        endunless
      endfor
    endif
  endfor
  assign many_sizes = false
  if size_total > 1
    assign many_sizes = true
  endif
-%}

{%- comment -%} Always rendered, so spy-variant-sync.js can swap it on a size or lens pick {%- endcomment -%}
<div class="contents" data-spy-variant-sync="{{ block.id }}">
{%- unless variant.available -%}
  <div class="spy-notify-me mt-2" {{ block.shopify_attributes }}>
    {%- comment -%} Source: white button, orange hairline + orange uppercase label {%- endcomment -%}
    <button
      type="button"
      class="spy-notify-me__toggle w-full py-3 border border-spy-orange-ui text-spy-orange-ui uppercase font-bold text-[0.8125rem] tracking-[0.06em] bg-transparent cursor-pointer hover:bg-spy-orange-ui hover:text-white transition-colors aria-expanded:hidden aria-busy:opacity-60 aria-busy:cursor-progress"
      data-spy-notify-toggle
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
      data-variant-id="{{ variant.id }}"
      data-product-id="{{ p.id }}"
      {% if block.settings.use_app %}
        data-spy-notify-app
        {% if block.settings.app_script_url != blank %}data-spy-notify-script="{{ block.settings.app_script_url | escape }}"{% endif %}
        aria-haspopup="dialog"
        data-model-name="{{ model_name | escape }}"
        {% capture own_item %}{% render 'spy-notify-variant', product: p, variant: variant, with_size: many_sizes %}{% endcapture %}
        data-spy-notify-variants="[{{ own_item | strip | escape }}]"
      {% endif %}
    >
      {{ block.settings.label | default: 'Notify me when back in stock' }}
    </button>

    <div id="{{ panel_id }}" class="spy-notify-me__panel mt-4" hidden>
      {%- form 'contact', id: form_id, class: 'flex flex-col items-start gap-3' -%}
        {%- comment -%} Tells the script to keep the panel open after a send {%- endcomment -%}
        {%- if form.posted_successfully? or form.errors -%}
          <span data-spy-notify-open hidden></span>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="m-0 text-[14px] leading-5 text-[color:var(--color-spy-positive)]" role="status">
            {{ block.settings.success_text | default: "Thanks — we'll email you when this is back in stock." }}
          </p>
        {%- else -%}
          {%- if form.errors -%}
            <p id="{{ form_id }}-error" class="m-0 text-[14px] leading-5 text-[color:var(--color-spy-negative)]" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}

          <p class="m-0 text-[14px] font-medium leading-5 tracking-[0.01em] text-[color:var(--color-spy-text)]">
            {{ block.settings.intro | default: 'We will send you an email when the product is back in stock' }}
          </p>

          {%- comment -%} Tells the merchant which colourway to restock {%- endcomment -%}
          <input type="hidden" name="contact[subject]" value="Back in stock request: {{ p.title | escape }}">
          <input type="hidden" name="contact[product]" value="{{ p.title | escape }} — {{ variant.title | escape }}">
          <input type="hidden" name="contact[variant_id]" value="{{ variant.id }}">
          <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ p.url }}">

          <label for="{{ form_id }}-email" class="m-0 text-[14px] leading-5 text-[color:var(--color-spy-text)]">
            {{ block.settings.email_label | default: 'Email' }}
            <span class="text-[color:var(--color-spy-negative)]">*</span>
          </label>
          <input
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            required
            autocomplete="email"
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
            class="w-full max-w-[420px] h-10 px-3 border border-spy-input-border bg-white text-[14px] text-[color:var(--color-spy-text)] focus:outline-none focus:border-spy-orange-ui"
          >

          <label class="flex items-start gap-2 cursor-pointer text-[14px] leading-5 text-[color:var(--color-spy-text)]">
            <input
              type="checkbox"
              name="contact[consent]"
              value="yes"
              required
              class="mt-[3px] h-4 w-4 shrink-0 cursor-pointer accent-spy-orange-ui"
            >
            <span>{{ block.settings.consent_text | default: 'I agree to receive a notification by email.' }}<span class="text-[color:var(--color-spy-negative)]">*</span></span>
          </label>

          <button
            type="submit"
            class="w-full max-w-[420px] py-3 bg-spy-orange-ui text-white uppercase font-bold text-[0.8125rem] tracking-[0.06em] border-0 cursor-pointer hover:opacity-90 transition-opacity"
          >
            {{ block.settings.send_label | default: 'Send' }}
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
{%- endunless -%}
</div>

{%- comment -%} Outside the wrapper: the synced copy drops scripts, and the colour switch can bring the button in later {%- endcomment -%}
<script src="{{ 'spy-notify-me.js' | asset_url }}" type="module"></script>
<script src="{{ 'spy-variant-sync.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Notify Me",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Button label", "default": "Notify me when back in stock" },
    {
      "type": "checkbox",
      "id": "use_app",
      "label": "Open the Back in Stock app popup",
      "info": "If the app hasn't loaded, the email form below opens instead.",
      "default": true
    },
    {
      "type": "text",
      "id": "app_script_url",
      "label": "Back in Stock widget script URL",
      "info": "With a URL here the app loads only when a shopper heads for this button, so its app embed can stay off. Leave empty to rely on the app embed."
    },
    { "type": "header", "content": "Email form (when the app isn't used)" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "We will send you an email when the product is back in stock" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "consent_text", "label": "Consent text", "default": "I agree to receive a notification by email." },
    { "type": "text", "id": "send_label", "label": "Send button label", "default": "Send" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — we'll email you when this is back in stock." }
  ],
  "presets": [{ "name": "Notify Me", "category": "SPY" }]
}
{% endschema %}

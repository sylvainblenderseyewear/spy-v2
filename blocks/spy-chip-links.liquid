{%- comment -%}
  Chip links — a wrapping row of up to 5 outline link chips (the source's
  category cross-links under the Sale card: Sunglasses / Snow Goggles / ...).

  Exists for the same reason as [spy-card-grid]: stock `group` won't wrap a row
  above 750px, and these short links have to wrap inside a ~370px card at every
  width. The source also flips them to a full-width stack below 769px, which a
  row of buttons can't do on its own.
{%- endcomment -%}

{%- liquid
  assign chip_count = 0
  for i in (1..5)
    assign text_key = 'link_' | append: i | append: '_text'
    if block.settings[text_key] != blank
      assign chip_count = chip_count | plus: 1
    endif
  endfor

  if block.settings.uppercase
    assign case_class = 'uppercase'
  else
    assign case_class = 'normal-case'
  endif

  if block.settings.stack_mobile
    assign stack_class = 'max-[769px]:flex-col max-[769px]:text-center'
  else
    assign stack_class = ''
  endif
-%}

{%- if chip_count > 0 -%}
  <div
    class="spy-chip-links flex flex-wrap w-full {{ stack_class }}"
    style="
      gap: {{ block.settings.gap }}px;
      --ccl-color: {{ block.settings.color | default: 'var(--color-foreground)' }};
      --ccl-hover-text: {{ block.settings.hover_text_color }};
      --ccl-size: {{ block.settings.size }}px;
      --ccl-leading: {{ block.settings.line_height | divided_by: 100.0 }};
      --ccl-tracking: {{ block.settings.letter_spacing }}px;
      --ccl-weight: {{ block.settings.weight }};
      --ccl-pad-y: {{ block.settings.padding_y }}px;
      --ccl-pad-x: {{ block.settings.padding_x }}px;
      --ccl-ms: {{ block.settings.transition }}ms;
    "
    {{ block.shopify_attributes }}
  >
    {%- for i in (1..5) -%}
      {%- liquid
        assign text_key = 'link_' | append: i | append: '_text'
        assign url_key = 'link_' | append: i | append: '_url'
        assign chip_text = block.settings[text_key]
        assign chip_url = block.settings[url_key]
      -%}
      {%- if chip_text != blank -%}
        <a
          href="{{ chip_url | default: '#' }}"
          class="
            inline-block no-underline {{ case_class }}
            text-[length:var(--ccl-size)] font-[number:var(--ccl-weight)]
            leading-[var(--ccl-leading)] tracking-[var(--ccl-tracking)]
            [padding:var(--ccl-pad-y)_var(--ccl-pad-x)]
            border border-[color:var(--ccl-color)] text-[color:var(--ccl-color)]
            [transition:all_var(--ccl-ms)_ease]
            hover:bg-[color:var(--ccl-color)] hover:text-[color:var(--ccl-hover-text)] hover:no-underline
          "
        >{{ chip_text }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Chip links",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "color",
      "label": "Border and text color",
      "info": "Leave empty to use the theme's text color.",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Text color on hover",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "transition",
      "label": "Hover transition",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "ms",
      "default": 200
    },
    {
      "type": "header",
      "content": "Type"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "weight",
      "label": "Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 100,
      "max": 220,
      "step": 5,
      "unit": "%",
      "default": 160
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -1,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding — vertical",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding — horizontal",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "Stack full width on mobile",
      "info": "Matches the source below 769px.",
      "default": true
    },
    { "type": "header", "content": "Link 1" },
    { "type": "text", "id": "link_1_text", "label": "Text", "default": "Sunglasses" },
    { "type": "url", "id": "link_1_url", "label": "URL" },
    { "type": "header", "content": "Link 2" },
    { "type": "text", "id": "link_2_text", "label": "Text", "default": "Snow Goggles" },
    { "type": "url", "id": "link_2_url", "label": "URL" },
    { "type": "header", "content": "Link 3" },
    { "type": "text", "id": "link_3_text", "label": "Text", "default": "Snow Helmets" },
    { "type": "url", "id": "link_3_url", "label": "URL" },
    { "type": "header", "content": "Link 4" },
    { "type": "text", "id": "link_4_text", "label": "Text", "default": "Moto Goggles" },
    { "type": "url", "id": "link_4_url", "label": "URL" },
    { "type": "header", "content": "Link 5" },
    { "type": "text", "id": "link_5_text", "label": "Text", "default": "Eyeglasses" },
    { "type": "url", "id": "link_5_url", "label": "URL" }
  ],
  "presets": [
    {
      "name": "Chip links",
      "category": "SPY"
    }
  ]
}
{% endschema %}



{% assign block_settings = block.settings %}
{% liquid
  assign custom_color = false
  if block_settings.background_color != blank or block_settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

{%- comment -%}
  Source panel: one grey box, 16px inset, heading centred on top.
  "Extend" now just stretches the panel to the full column height.
{%- endcomment -%}
<div
  class="cart-summary border-style w-full{% if block_settings.extend_summary %} cart-summary--extend h-full{% endif %}{% if block_settings.border_radius > 0 %} rounded-[var(--border-radius)] overflow-hidden{% endif %}"
  style="{% render 'border-override', settings: block_settings %} --spy-cart-summary-bg: {{ block_settings.background_color | default: 'var(--color-spy-tile)' }};"
  {{ block.shopify_attributes }}
>
  <div class="cart-summary__inner{% if custom_color %} color-custom-{{ block.id }}{% endif %} @container static [display:flex] flex-col items-stretch gap-0 w-full min-w-0 max-w-full p-4 bg-[var(--spy-cart-summary-bg)]{% if block_settings.extend_summary %} h-full{% endif %}">
    {%- if block_settings.heading != blank -%}
      <h2 class="m-0 mb-2 text-center text-[20px] font-normal leading-[24px] text-spy-ink normal-case">
        {{- block_settings.heading -}}
      </h2>
    {%- endif -%}
    {% render 'cart-summary',
      accelerated_checkout_buttons_layout: 'vertical',
      section_id: section.id,
      show_subtotal: block_settings.show_subtotal,
      shipping_label: block_settings.shipping_label,
      shipping_value: block_settings.shipping_value,
      shipping_estimate: block_settings.shipping_estimate,
      shipping_select_label: block_settings.shipping_select_label,
      estimate_country: block_settings.estimate_country,
      estimate_province: block_settings.estimate_province,
      estimate_zip: block_settings.estimate_zip,
      checkout_label: block_settings.checkout_label
    %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.summary",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "extend_summary",
      "label": "t:settings.extend_summary",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order Summary"
    },
    {
      "type": "checkbox",
      "id": "show_subtotal",
      "label": "Show subtotal row",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "shipping_estimate",
      "label": "Show shipping method select",
      "info": "Lists your real shipping rates and adds the chosen one to the total. Checkout still confirms the final rate.",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_select_label",
      "label": "Select label",
      "default": "Shipping",
      "visible_if": "{{ block.settings.shipping_estimate }}"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping cost label",
      "info": "Leave blank to hide the row.",
      "default": "Shipping cost"
    },
    {
      "type": "text",
      "id": "shipping_value",
      "label": "Fallback text",
      "info": "Shown while rates load, or when no rate can be estimated.",
      "default": "Calculated at checkout"
    },
    {
      "type": "text",
      "id": "estimate_country",
      "label": "Estimate country",
      "info": "Rates need a full address. Signed-in customers use their own; otherwise this, or the store address when blank.",
      "visible_if": "{{ block.settings.shipping_estimate }}"
    },
    {
      "type": "text",
      "id": "estimate_province",
      "label": "Estimate state / province",
      "visible_if": "{{ block.settings.shipping_estimate }}"
    },
    {
      "type": "text",
      "id": "estimate_zip",
      "label": "Estimate ZIP / postal code",
      "visible_if": "{{ block.settings.shipping_estimate }}"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "info": "Leave blank to use the translation."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "paragraph",
      "content": "t:content.cart_summary_mobile_colors"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.summary"
    }
  ]
}
{% endschema %}

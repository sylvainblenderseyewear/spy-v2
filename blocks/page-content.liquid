{%- liquid
  # The three legal pages were each pasted from a different tool, so each one
  # gets the base type its source really uses. Sizes live on the wrapper only —
  # the copy carries Word's own inline styles and those must keep winning.
  assign legal_type = ''

  # Runs and lists every legal document relies on
  capture legal_shared
    echo '[&_strong]:font-bold [&_b]:font-bold [&_u]:underline [&_a]:underline [&_em]:italic [&_i]:italic '
    echo '[&_ul]:list-disc [&_ol]:list-decimal [&_ul]:my-0 [&_ol]:my-0 '
    # Word writes a./b./c. sub-items as type="a" lists and Tailwind resets those.
    # HTML matches the type value case-insensitively, so a/A both land here.
    echo '[&_ol[type=a]]:list-[lower-alpha] [&_ol[type=i]]:list-[lower-roman] '
  endcapture

  case page.template_suffix
    when 'terms-of-use'
      # Source: Word paste, Times New Roman 10pt / 1.6em, justified
      capture legal_type
        echo 'spy-legal font-legal text-[13.3333px] leading-[1.6] text-justify hyphens-none '
        # source row (48) + markup (48/16) padding, and only from 992px up
        echo 'min-[992px]:pt-[96px] min-[992px]:pb-[64px] '
        # blank paragraphs do the spacing; only style-less ones need the reset
        echo '[&_p:not([style])]:m-0 '
        echo '[&_p[align=center]:not([style*=text-align])]:text-center '
        echo '[&_ul]:pl-[2.5em] [&_ol]:pl-[2.5em] [&_li]:text-justify '
        echo legal_shared
      endcapture
    when 'privacy-policy'
      # Source: Word paste, Calibri 11pt / normal, justified; tables carry their
      # own widths and run border-less
      capture legal_type
        echo 'spy-legal font-word-sans text-[14.6667px] leading-normal text-justify hyphens-none '
        echo '[&_p:not([style])]:m-0 '
        echo '[&_p[align=center]:not([style*=text-align])]:text-center '
        echo '[&_ul]:pl-[2.5em] [&_ol]:pl-[2.5em] '
        echo '[&_table]:border-collapse '
        echo legal_shared
      endcapture
    when 'legal-notices'
      # Source: hand-written markup in the brand sans, headings fluid below 1200
      capture legal_type
        echo 'spy-legal text-[16px] leading-[1.4] '
        # source row padding, from 992px up
        echo 'min-[992px]:py-[48px] '
        echo '[&_h1]:text-[calc(1.325rem_+_0.9vw)] min-[1200px]:[&_h1]:text-[32px] [&_h1]:font-semibold [&_h1]:leading-[1.2] [&_h1]:tracking-normal [&_h1]:m-0 [&_h1]:mb-2 '
        echo '[&_h2]:text-[calc(1.3rem_+_0.6vw)] min-[1200px]:[&_h2]:text-[28px] [&_h2]:font-semibold [&_h2]:leading-[1.2] [&_h2]:tracking-normal [&_h2]:m-0 [&_h2]:mb-2 '
        echo '[&_p]:m-0 [&_p]:mb-4 [&_ul]:pl-[40px] [&_ol]:pl-[40px] '
        echo legal_shared
      endcapture
  endcase
-%}

<div
  class="page-content {{ legal_type }}"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ page.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .page-content {
    color: var(--color, inherit);
  }

  .page-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "class": "rte",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}

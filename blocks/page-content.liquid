{%- liquid
  # Each of these pages was pasted from a different tool, so each one gets the
  # base type its source really uses. Sizes live on the wrapper only —
  # the copy carries Word's own inline styles and those must keep winning.
  assign page_type = ''
  assign word_bullets = false

  # Inline runs every page below relies on
  capture rte_runs
    echo '[&_strong]:font-bold [&_b]:font-bold [&_u]:underline [&_a]:underline [&_em]:italic [&_i]:italic '
  endcapture

  # Runs and lists every legal document relies on
  capture legal_shared
    echo rte_runs
    echo '[&_ul]:list-disc [&_ol]:list-decimal [&_ul]:my-0 [&_ol]:my-0 '
    # Word writes a./b./c. sub-items as type="a" lists and Tailwind resets those.
    # HTML matches the type value case-insensitively, so a/A both land here.
    echo '[&_ol[type=a]]:list-[lower-alpha] [&_ol[type=i]]:list-[lower-roman] '
  endcapture

  # Word's geometry only fits the source's 1110px column: the paste uses two-column
  # spacer tables (~642px of fixed cell widths), inch-deep nested indents and
  # justified type. On a phone that overflows sideways and reads as a mess, so below
  # 992px we drop Word's layout and run the copy as one plain column. Desktop keeps
  # the source 1:1 — every rule here is inside max-[992px].
  # Inline styles carry the values we are undoing, so these need `!`.
  capture word_mobile
    # One readable column: no justified rivers, no words pushed past the edge
    echo 'max-[992px]:text-left max-[992px]:break-words '
    echo 'max-[992px]:[&_[style*=justify]]:text-left! '
    # Spacer tables stack, so their two bullet columns become one list
    echo 'max-[992px]:[&_table]:block max-[992px]:[&_tbody]:block '
    echo 'max-[992px]:[&_tr]:block max-[992px]:[&_td]:block '
    echo 'max-[992px]:[&_table]:w-full! max-[992px]:[&_td]:w-full! '
    echo 'max-[992px]:[&_table]:ml-0! max-[992px]:[&_td]:pl-0! max-[992px]:[&_td]:pr-0! '
    # A stacked table is just a list now, so it needs its own gap from the copy
    echo 'max-[992px]:[&_table]:my-[0.75em]! '
    # Row heights are written in points and leave dead gaps once cells stack
    echo 'max-[992px]:[&_tr]:h-auto! max-[992px]:[&_td]:h-auto! '
    # Word's wrapper divs exist only to indent, so flatten them
    echo 'max-[992px]:[&_div]:ml-0! max-[992px]:[&_div]:mr-0! '
    echo 'max-[992px]:[&_div]:pl-0! max-[992px]:[&_div]:pr-0! '
    # Inch-deep paragraph indents go; hanging bullets/numbers keep a 1em step
    echo 'max-[992px]:[&_p]:ml-0! max-[992px]:[&_p]:mr-0! max-[992px]:[&_li]:ml-0! '
    echo 'max-[992px]:[&_ol]:ml-0! max-[992px]:[&_ul]:ml-0! '
    echo 'max-[992px]:[&_ol]:pl-[1.5em]! max-[992px]:[&_ul]:pl-[1.5em]! '
    echo 'max-[992px]:[&_p[style*=text-indent]]:pl-[1.1em]! '
    echo 'max-[992px]:[&_p[style*=text-indent]]:indent-[-1.1em]! '
    echo 'max-[992px]:[&_h3]:ml-0! max-[992px]:[&_h3]:pl-[1.1em]! '
    echo 'max-[992px]:[&_h3]:indent-[-1.1em]! '
    # Word marks its second level with a Courier "o" — flattening the indents
    # would lose that, so step those rows back in one level
    echo 'max-[992px]:[&_p:has(span[style*=Courier])]:pl-[2.6em]! '
    # Word pads each fake bullet with a 13-space run — drop it, keep one space
    echo 'max-[992px]:[&_span[style*=Symbol]>span]:text-[0px]! '
    echo 'max-[992px]:[&_span[style*=Symbol]]:mr-[0.45em] '
  endcapture

  case page.template_suffix
    when 'terms-of-use'
      # Source: Word paste, Times New Roman 10pt / 1.6em, justified
      capture page_type
        echo 'spy-legal font-legal text-[13.3333px] leading-[1.6] text-justify hyphens-none '
        # source row (48) + markup (48/16) padding, and only from 992px up
        echo 'min-[992px]:pt-[96px] min-[992px]:pb-[64px] '
        # blank paragraphs do the spacing; only style-less ones need the reset
        echo '[&_p:not([style])]:m-0 '
        echo '[&_p[align=center]:not([style*=text-align])]:text-center '
        echo '[&_ul]:pl-[2.5em] [&_ol]:pl-[2.5em] [&_li]:text-justify '
        echo legal_shared
      endcapture
    when 'privacy-policy'
      # Source: Word paste, Calibri 11pt / normal, justified; tables carry their
      # own widths and run border-less
      capture page_type
        echo 'spy-legal font-word-sans text-[14.6667px] leading-normal text-justify hyphens-none '
        echo '[&_p:not([style])]:m-0 '
        echo '[&_p[align=center]:not([style*=text-align])]:text-center '
        echo '[&_ul]:pl-[2.5em] [&_ol]:pl-[2.5em] '
        echo '[&_table]:border-collapse '
        echo legal_shared
        echo word_mobile
      endcapture
      # The body in the admin lost its list markup, so the bullets are plain text
      assign word_bullets = true
    when 'shipping'
      # Source: hand-written markup in the brand sans on Bootstrap's own type scale
      capture page_type
        echo 'text-[16px] leading-[1.4] '
        echo '[&_h2]:text-[calc(1.3rem_+_0.6vw)] min-[1200px]:[&_h2]:text-[28px] [&_h2]:font-semibold '
        echo '[&_h2]:leading-[1.2] [&_h2]:tracking-normal [&_h2]:normal-case [&_h2]:m-0 [&_h2]:mb-2 '
        # Blank paragraphs carry the spacing between the blocks, so they keep their margin
        echo '[&_p]:m-0 [&_p]:mb-4 '
        echo '[&_ul]:list-disc [&_ol]:list-decimal [&_ul]:pl-[40px] [&_ol]:pl-[40px] '
        echo '[&_ul]:m-0 [&_ul]:mb-4 [&_ol]:m-0 [&_ol]:mb-4 '
        # Nested list rides tight under its parent item and swaps the marker
        echo '[&_ul_ul]:mb-0 [&_ul_ul]:list-[circle] [&_ol_ol]:mb-0 '
        echo rte_runs
      endcapture
    when 'legal-notices'
      # Source: hand-written markup in the brand sans, headings fluid below 1200
      capture page_type
        echo 'spy-legal text-[16px] leading-[1.4] '
        # source row padding, from 992px up
        echo 'min-[992px]:py-[48px] '
        echo '[&_h1]:text-[calc(1.325rem_+_0.9vw)] min-[1200px]:[&_h1]:text-[32px] [&_h1]:font-semibold [&_h1]:leading-[1.2] [&_h1]:tracking-normal [&_h1]:m-0 [&_h1]:mb-2 '
        echo '[&_h2]:text-[calc(1.3rem_+_0.6vw)] min-[1200px]:[&_h2]:text-[28px] [&_h2]:font-semibold [&_h2]:leading-[1.2] [&_h2]:tracking-normal [&_h2]:m-0 [&_h2]:mb-2 '
        echo '[&_p]:m-0 [&_p]:mb-4 [&_ul]:pl-[40px] [&_ol]:pl-[40px] '
        echo legal_shared
      endcapture
  endcase
-%}

<div
  class="page-content {{ page_type }}"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter{% if word_bullets %} word-bullets{% endif %}>
    {%- comment -%}
      Page body first. Legal Notices falls back to the source copy so the page
      is never blank before an editor pastes it in the admin.
    {%- endcomment -%}
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- elsif page.template_suffix == 'legal-notices' -%}
      {%- render 'legal-notices-content' -%}
    {%- endif -%}
  </rte-formatter>
</div>

{% stylesheet %}
  .page-content {
    color: var(--color, inherit);
  }

  .page-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "class": "rte",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}

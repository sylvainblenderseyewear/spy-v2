{%- comment -%}
  Announcement bar — the source's `section.preheader`, the bottom band of the header.

  Height comes from a min-height per breakpoint (40 / 48 / 56px), not padding, and the
  message box plus the close button are centred TOGETHER as one row, so the X hugs the
  text instead of sitting out at the page edge.

  The `pl-12` is deliberate, not a stray margin: the source row is `col-12 ml-4`, so its
  content box sits 24px right of the page centre and the message lands 6.3px right of
  true centre. 48px of left padding puts our centre in the same place without the source's
  overflow. Drop it only if we decide to stop matching that. See
  audit/page-spec-announcement-bar.md.
{%- endcomment -%}

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar section section--full-width color-custom-{{ section.id }} relative [border-block-end:var(--border-bottom-width)_solid_var(--color-border)]"
  id="spy-ann-{{ section.id }}"
  style="--border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %} --spy-ann-h: {{ section.settings.height }}px; --spy-ann-h-tablet: {{ section.settings.height_tablet }}px; --spy-ann-h-mobile: {{ section.settings.height_mobile }}px;"
>
  {% liquid
    assign autoplay = false
    if section.blocks.size > 1
      assign autoplay = true
    endif
  %}

  <announcement-bar-component
    class="
      announcement-bar__slider
      [display:flex] items-center justify-center relative
      pl-12
      [min-height:var(--spy-ann-h)]
      max-[769px]:[min-height:var(--spy-ann-h-tablet)]
      max-[481px]:[min-height:var(--spy-ann-h-mobile)]
    "
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    <div
      class="
        announcement-bar__slides
        [display:grid] [grid-template-areas:'stack'] items-center
        w-auto max-w-full min-w-0 overflow-hidden
        px-4 max-[769px]:px-3 max-[481px]:px-2
      "
    >
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.enable_close %}
      <button
        class="announcement-bar__close [display:inline-flex] shrink-0 self-center items-center justify-center m-0 px-3 py-2 min-h-[34.8px] border border-transparent bg-transparent text-current leading-none cursor-pointer transition-opacity duration-200 hover:opacity-90"
        type="button"
        data-spy-ann-close
        aria-label="{{ 'actions.close' | t }}"
      >
        {%- comment -%} FontAwesome 4 "times", cropped to its 1188-unit ink box so 9px is the glyph {%- endcomment -%}
        <svg class="size-[9px] max-w-none" viewBox="302 366 1188 1188" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M1490 1322q0 40-28 68l-136 136q-28 28-68 28t-68-28l-294-294-294 294q-28 28-68 28t-68-28l-136-136q-28-28-28-68t28-68l294-294-294-294q-28-28-28-68t28-68l136-136q28-28 68-28t68 28l294 294 294-294q28-28 68-28t68 28l136 136q28 28 28 68t-28 68l-294 294 294 294q28 28 28 68z"/>
        </svg>
      </button>
    {% endif %}
  </announcement-bar-component>
</aside>

{% if section.settings.enable_close %}
  <script>
    (function () {
      var id = '{{ section.id }}';
      var key = 'spy-ann-dismissed-' + id;
      var aside = document.getElementById('spy-ann-' + id);
      var bg = aside && aside.previousElementSibling;

      function dismiss() {
        if (aside) aside.hidden = true;
        if (bg && bg.classList.contains('section-background')) bg.hidden = true;
        try { sessionStorage.setItem(key, '1'); } catch (e) {}
      }

      // Stays closed for the rest of the visit, but comes back in the editor
      if (!window.Shopify || !Shopify.designMode) {
        try { if (sessionStorage.getItem(key)) dismiss(); } catch (e) {}
      }

      var btn = aside && aside.querySelector('[data-spy-ann-close]');
      if (btn) btn.addEventListener('click', dismiss);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#1d2a2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_close",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop",
      "info": "From 769px up.",
      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "height_tablet",
      "label": "Tablet",
      "info": "481–768px.",
      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile",
      "info": "480px and below.",
      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}



{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }} relative [border-block-end:var(--border-bottom-width)_solid_var(--color-border)]"
  id="spy-ann-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="
      announcement-bar__slider
      [display:flex] items-center justify-center relative
      gap-9 max-md:gap-5
      max-[749px]:[grid-column:1/-1]
      {% if show_arrows %}announcement-bar__slider--has-arrows{% endif %}
    "
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides [display:grid] [grid-template-areas:'stack'] w-auto max-w-full min-w-0">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.enable_close %}
      <button
        class="announcement-bar__close [display:inline-flex] shrink-0 items-center justify-center size-[12px] m-0 p-0 border-0 bg-transparent text-current leading-none opacity-90 transition-opacity duration-200 cursor-pointer hover:opacity-100"
        type="button"
        data-spy-ann-close
        aria-label="{{ 'actions.close' | t }}"
      >
        <svg class="size-full" aria-hidden="true" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/>
        </svg>
      </button>
    {% endif %}
  </announcement-bar-component>
</aside>

{% if section.settings.enable_close %}
  <script>
    (function () {
      var id = '{{ section.id }}';
      var key = 'spy-ann-dismissed-' + id;
      var aside = document.getElementById('spy-ann-' + id);
      var bg = aside && aside.previousElementSibling;

      function dismiss() {
        if (aside) aside.hidden = true;
        if (bg && bg.classList.contains('section-background')) bg.hidden = true;
        try { sessionStorage.setItem(key, '1'); } catch (e) {}
      }

      // Stays closed for the rest of the visit, but comes back in the editor
      if (!window.Shopify || !Shopify.designMode) {
        try { if (sessionStorage.getItem(key)) dismiss(); } catch (e) {}
      }

      var btn = aside && aside.querySelector('[data-spy-ann-close]');
      if (btn) btn.addEventListener('click', dismiss);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#1d2a2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_close",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}

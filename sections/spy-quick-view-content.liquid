{%- comment -%}
  Quick View body — fetched by spy-quick-view.js with ?section_id= and dropped
  into the dialog shell.

  Same two-column split as the source: gallery on 7/12, product info on 5/12,
  stacked under 769px. The info column is the PDP column trimmed to what the
  dialog shows, and it reuses the PDP blocks/snippets so both stay in step.
  Only image media is carried over — video stays on the full PDP.
{%- endcomment -%}

{%- liquid
  assign p = product
  assign variant = p.selected_or_first_available_variant

  comment
    Every media type rides along, like the source carousel. Staging is images
    only today, so the video branch stays dormant until the migration lands.
  endcomment
  assign gallery = p.media

  assign title_class = 'block text-[30px] font-normal uppercase leading-[36px] text-[color:var(--color-spy-ink)]'
-%}

<div
  class="spy-qv-product"
  data-spy-qv-product
  data-product-id="{{ p.id }}"
  data-product-handle="{{ p.handle }}"
  data-product-url="{{ p.url }}"
>
  {%- comment -%} Stacked layout leads with the name, so it moves out of the info column {%- endcomment -%}
  <h2 class="{{ title_class }} px-[15px] pb-2 min-[769px]:hidden">{{ p.title }}</h2>

  <div class="[display:flex] flex-wrap">
    {%- comment -%} ── Gallery ─────────────────────────────────────────── {%- endcomment -%}
    <div class="w-full px-[30px] min-[769px]:w-[58.333333%]">
      {%- if gallery.size > 0 -%}
        <div class="relative" data-spy-qv-gallery>
          <div class="relative">
            {%- comment -%} Scroll-snap track — no JS needed for the swipe, only for the arrows {%- endcomment -%}
            <div
              class="[display:flex] snap-x snap-mandatory overflow-x-auto scroll-smooth overscroll-x-contain [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
              data-spy-qv-track
            >
              {%- for media in gallery -%}
                <div class="w-full shrink-0 snap-start p-px" data-spy-qv-slide="{{ forloop.index0 }}">
                  <div class="aspect-square w-full [&_iframe]:h-full [&_iframe]:w-full [&_video]:h-full [&_video]:w-full [&_video]:object-contain">
                    {%- case media.media_type -%}
                      {%- when 'video', 'external_video' -%}
                        {%- comment -%} Same player the PDP uses, so behaviour matches {%- endcomment -%}
                        {%- render 'video',
                          video: media,
                          video_loop: true,
                          widths: '600, 900, 1200',
                          sizes: '(min-width: 1200px) 586px, (min-width: 992px) 418px, (min-width: 769px) 262px, 100vw',
                          loading: 'lazy'
                        -%}
                      {%- else -%}
                        <img
                          src="{{ media.preview_image | image_url: width: 1200 }}"
                          srcset="
                            {{ media.preview_image | image_url: width: 600 }} 600w,
                            {{ media.preview_image | image_url: width: 900 }} 900w,
                            {{ media.preview_image | image_url: width: 1200 }} 1200w
                          "
                          sizes="(min-width: 1200px) 586px, (min-width: 992px) 418px, (min-width: 769px) 262px, 100vw"
                          alt="{{ media.preview_image.alt | default: p.title | escape }}"
                          width="1200"
                          height="1200"
                          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                          class="block h-full w-full object-contain"
                        >
                    {%- endcase -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>

            {%- if gallery.size > 1 -%}
              {%- comment -%} Source arrows: 35px pill, brand orange chevron, shadow deepens on hover {%- endcomment -%}
              {%- capture arrow_class -%}
                absolute top-1/2 z-[2] -translate-y-1/2 [display:flex] h-[35px] w-[35px] cursor-pointer items-center justify-center rounded-[18px] border-none bg-white p-0 text-[color:var(--color-spy-orange-ui)] opacity-75 shadow-[0_0_9px_0_rgba(119,119,119,0.1)] transition-[opacity,box-shadow] duration-300 hover:opacity-100 hover:shadow-[0_0_9px_0_rgba(119,119,119,0.4)] disabled:opacity-40
              {%- endcapture -%}

              <button type="button" class="{{ arrow_class }} left-0" aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}" data-spy-qv-prev>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M12.5 4L6.5 10l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button type="button" class="{{ arrow_class }} right-0" aria-label="{{ 'accessibility.next' | t | default: 'Next' }}" data-spy-qv-next>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M7.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- endif -%}
          </div>

          {%- comment -%}
            No thumbnail rail here. The source ships the markup but never shows it:
            its .slick-paging-wrapper computes to height 0 with overflow hidden and
            holds an absolutely positioned rail, so the dialog is arrows only.
          {%- endcomment -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Product info ────────────────────────────────────── {%- endcomment -%}
    <div class="w-full px-[15px] min-[769px]:w-[41.666667%]">
      <h2 class="{{ title_class }} mb-2 hidden min-[769px]:block">{{ p.title }}</h2>

      <div class="[display:flex] flex-wrap items-center gap-x-3 gap-y-1 pb-2">
        <div class="text-[16px] font-bold leading-[1.4] text-[color:var(--color-spy-text)]" data-spy-qv-price>
          {%- if variant.compare_at_price > variant.price -%}
            <span class="text-[color:var(--color-spy-sale)]">{{ variant.price | money }}</span>
            <s class="ml-1.5 font-normal text-[color:var(--color-spy-muted)]">{{ variant.compare_at_price | money }}</s>
          {%- else -%}
            <span>{{ variant.price | money }}</span>
          {%- endif -%}
        </div>
        {% content_for 'block', type: 'spy-rating', id: 'qv-rating', closest.product: p %}
      </div>

      <hr class="my-4 h-px border-none bg-[color:var(--color-spy-border)]">

      {%- comment -%}
        Source keeps 38px between the rule and the swatches (16px off the rule plus
        an empty label row). The picker's own 22px would collapse into the rule's
        margin and land 16px short, so set the gap here.
      {%- endcomment -%}
      {%- render 'spy-color-picker', product: p, wrapper_class: 'mt-[38px]' -%}

      {% content_for 'block', type: 'spy-frame-summary', id: 'qv-frame-summary', closest.product: p %}

      {%- comment -%}
        Size Chart sits between the lens rows and the stock line, as on the source.
        The block ships its own inline script and portals its drawer to <body>, so
        spy-quick-view.js re-runs that script after each fetch.
      {%- endcomment -%}
      {% content_for 'block', type: 'spy-frame-fit-guide', id: 'qv-fit-guide', closest.product: p %}

      {% content_for 'block', type: 'spy-stock-status', id: 'qv-stock', closest.product: p %}

      {%- comment -%}
        Horizon's own buy buttons, so the dialog shares the PDP cart flow (cart
        count, error states). The wrapper repaints the button to the source's
        full-width orange bar and drops the shared snippet's cart glyph, the same
        two things the PDP does — the block's own default is the secondary style.
      {%- endcomment -%}
      <div class="spy-qv-buy [&_.add-to-cart-button]:w-full [&_.add-to-cart-button]:border [&_.add-to-cart-button]:border-solid [&_.add-to-cart-button]:border-[color:var(--color-spy-orange-ui)] [&_.add-to-cart-button]:bg-[color:var(--color-spy-orange-ui)] [&_.add-to-cart-button]:p-4 [&_.add-to-cart-button]:text-[14px] [&_.add-to-cart-button]:font-normal [&_.add-to-cart-button]:uppercase [&_.add-to-cart-button]:leading-[1.4] [&_.add-to-cart-button]:text-white [&_.add-to-cart-button:hover]:bg-[color:var(--color-primary-button-hover-background)] [&_.add-to-cart-button:hover]:border-[color:var(--color-primary-button-hover-background)] [&_.add-to-cart-icon]:hidden [&_.product-form-buttons]:gap-0">
        {% content_for 'block', type: 'buy-buttons', id: 'qv-buy-buttons', closest.product: p %}
      </div>

      {%- comment -%}
        The dialog cannot reach the PDP block's settings, so it carries its own
        copy of the reinsurance rows. Keep the two in step when the promise changes.
      {%- endcomment -%}
      {%- render 'spy-trust-badges', settings: section.settings -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quick View Content",
  "settings": [
    { "type": "header", "content": "Badge 1" },
    { "type": "text", "id": "badge_1_text", "label": "Text", "default": "Free Shipping for any order over $100" },
    { "type": "text", "id": "badge_1_link_text", "label": "Inline link text" },
    { "type": "text", "id": "badge_1_link_url", "label": "Inline link URL" },
    { "type": "header", "content": "Badge 2" },
    { "type": "text", "id": "badge_2_text", "label": "Text", "default": "Easy Returns for 30 days" },
    { "type": "text", "id": "badge_2_link_text", "label": "Inline link text" },
    { "type": "text", "id": "badge_2_link_url", "label": "Inline link URL" },
    { "type": "header", "content": "Badge 3" },
    { "type": "text", "id": "badge_3_text", "label": "Text", "default": "Discount calculated on the original price." },
    { "type": "text", "id": "badge_3_link_text", "label": "Inline link text", "default": "See conditions" },
    { "type": "text", "id": "badge_3_link_url", "label": "Inline link URL", "default": "/pages/offers-and-conditions" },
    { "type": "header", "content": "Badge 4" },
    { "type": "text", "id": "badge_4_text", "label": "Text", "default": "Pay in 4 installments with no fees using" },
    {
      "type": "select",
      "id": "badge_4_logo",
      "label": "Inline logo",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "paypal", "label": "PayPal" }
      ],
      "default": "paypal"
    },
    { "type": "header", "content": "Badge 5" },
    { "type": "text", "id": "badge_5_text", "label": "Text", "default": "Lifetime warranty on all sunglasses" }
  ]
}
{% endschema %}

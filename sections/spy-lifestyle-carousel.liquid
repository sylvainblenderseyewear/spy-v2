{%- doc -%}
  Horizontal lifestyle strip under the product grid.

  Source geometry: square images 399px wide in 423px cells (12px gutter each side), so about
  3.2 cells show at 1440 and the count follows the viewport. Tall translucent side arrows,
  51px wide and full height, with an orange angle glyph. Scroll-snap gives native dragging,
  so the JS only moves the track a cell at a time.

  Data: pdp.feature_carousel (list.file). That definition does not exist yet, so it falls
  back to the product's own images and can be capped in the editor.
{%- enddoc -%}

{%- liquid
  assign p = product
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif
  assign shots = p.metafields.pdp.feature_carousel.value
  assign limit = section.settings.max_images | default: 8
-%}

{%- if shots != blank and shots.size > 0 -%}
  {%- assign items = shots -%}
{%- elsif section.settings.use_product_images and p.images.size > 0 -%}
  {%- assign items = p.images -%}
{%- endif -%}

{%- if items != blank -%}
  {%- comment -%}
    The source row sits in the page container but bleeds 15px past it, so the first image
    lands on the page margin (41 + 12 = 53 at 1440) and the arrows sit at 41. Inset lives
    here, not on the scroller — padding on a snap container gets cancelled by snapping.
  {%- endcomment -%}
  <div
    class="spy-strip relative mx-auto my-8 max-w-[1440px] px-px min-[769px]:px-[17px] min-[1200px]:px-[41px] min-[1800px]:px-[57px]"
    data-spy-strip
    {{ section.shopify_attributes }}
  >
    {%- comment -%}
      display via square brackets because Horizon's base.css owns the .flex class name and
      adds a 14.4px gap. Keep comments outside the tag — a whitespace-trimming comment tag
      eats the newline after "<div" and glues the tag name onto the class attribute.
    {%- endcomment -%}
    <div
      class="spy-strip__track [display:flex] snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-spy-strip-track
    >
      {%- for img in items limit: limit -%}
        {%- comment -%} 423px cell = 399px image + 12px each side, as the source track measures {%- endcomment -%}
        <div class="shrink-0 basis-[280px] snap-start px-3 min-[750px]:basis-[423px]">
          <img
            src="{{ img | image_url: width: 800 }}"
            srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 399px, 256px"
            alt="{{ img.alt | default: p.title | escape }}"
            width="399"
            height="399"
            loading="lazy"
            class="block aspect-square w-full bg-white object-contain"
          >
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Source arrows: 51px wide, full height, 75% white, orange glyph at 48px {%- endcomment -%}
    <button
      type="button"
      class="absolute inset-y-0 left-0 z-[1] flex w-[51px] cursor-pointer items-center justify-center border-0 bg-white/75 px-2 text-[color:var(--color-spy-orange)] transition-opacity disabled:pointer-events-none disabled:opacity-0"
      data-spy-strip-prev
      aria-label="{{ 'accessibility.slideshow_previous' | t }}"
    >
      <svg class="inline max-w-none align-middle" width="20" height="48" viewBox="0 0 20 48" fill="none" aria-hidden="true"><path d="M15 8L6 24L15 40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button
      type="button"
      class="absolute inset-y-0 right-0 z-[1] flex w-[51px] cursor-pointer items-center justify-center border-0 bg-white/75 px-2 text-[color:var(--color-spy-orange)] transition-opacity disabled:pointer-events-none disabled:opacity-0"
      data-spy-strip-next
      aria-label="{{ 'accessibility.slideshow_next' | t }}"
    >
      <svg class="inline max-w-none align-middle" width="20" height="48" viewBox="0 0 20 48" fill="none" aria-hidden="true"><path d="M5 8L14 24L5 40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <script src="{{ 'spy-strip-carousel.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "SPY Lifestyle Carousel",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses pdp.feature_carousel when that metafield definition lands. Source art is square, 1200x1200."
    },
    {
      "type": "checkbox",
      "id": "use_product_images",
      "label": "Fall back to the product's images",
      "default": true
    },
    { "type": "range", "id": "max_images", "label": "Images", "min": 3, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "SPY Lifestyle Carousel" }]
}
{% endschema %}

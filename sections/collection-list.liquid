

{% liquid
  if section.settings.content_source == 'products'
    assign max_items = section.settings.max_products | default: 10
  elsif section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    assign max_items = section.settings.collection_list.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  endif
%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-testid="collection-list"
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% if section.settings.content_source == 'products' and section.settings.heading != blank %}
    {%- comment -%}
      Source section header: 28px / 600 / uppercase, centred, margin 28px 0 14px.
      The size is Bootstrap's RFS curve — calc(1.3rem + 0.6vw) until it hits the
      1.75rem cap at a 1200px viewport, which min() expresses without a query.
    {%- endcomment -%}
    <div class="section-resource-list__header">
      <h2
        class="
          type-h2 m-0 mt-7 mb-3.5 text-center uppercase font-semibold
          leading-[1.2] tracking-normal
          text-[length:min(1.75rem,calc(1.3rem_+_0.6vw))]
        "
      >
        {{- section.settings.heading -}}
      </h2>
    </div>
  {% endif %}

  {% if section.settings.content_source == 'products' %}
    {%- liquid
      # Pool products across every collection picked in "Collections", so the
      # section can mix as many collections as the merchant wants.
      assign product_pool = blank
      for coll in section.settings.collection_list
        if coll == blank
          continue
        endif
        if product_pool == blank
          assign product_pool = coll.products
        else
          assign product_pool = product_pool | concat: coll.products
        endif
      endfor

      assign group_sep = '~|~'
      assign group_seen = group_sep
      assign group_card_count = 0
    -%}
    {% capture list_items %}
      {% if product_pool != blank and product_pool.size > 0 %}
        {%- capture groups -%}
          {%- render 'spy-product-groups', products: product_pool -%}
        {%- endcapture -%}
        {%- liquid
          assign groups = groups | strip | split: '~#~'
          assign group_keys = groups[0] | split: group_sep
          assign group_counts = groups[1] | split: group_sep
        -%}
        {% for product in product_pool %}
          {% liquid
            if group_card_count >= max_items
              break
            endif

            capture group_name
              render 'spy-group-name', product: product
            endcapture
            assign group_name = group_name | strip
            if group_name == ''
              assign group_key = 'ungrouped-' | append: product.id
            else
              assign group_key = group_name | handleize
            endif
            assign group_probe = group_sep | append: group_key | append: group_sep
          %}

          {% unless group_seen contains group_probe %}
            {% if group_card_count > 0 %}
              <!--@list/split-->
            {% endif %}
            {% liquid
              assign group_seen = group_seen | append: group_key | append: group_sep
              assign group_count = 1
              for candidate_key in group_keys
                if candidate_key == group_key
                  assign group_count = group_counts[forloop.index0] | plus: 0
                  break
                endif
              endfor
              assign group_card_count = group_card_count | plus: 1
            %}
            <div class="resource-list__item">
              {% render 'spy-grouped-product-card',
                product: product,
                group_name: group_name,
                group_count: group_count,
                block: section,
                product_view_context: 'collection'
              %}
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}
    {% endcapture %}

    {% liquid
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionList',
      slide_count: max_items,
      content_type: 'products',
      test_id: 'collections-list-grid'
    %}
  {% else %}
    {% if section_collections == null %}
      {% for i in (1..max_items) %}
        {% assign section_collections = section_collections | append: ', ' %}
      {% endfor %}

      {% assign section_collections = section_collections | split: ',' %}
    {% endif %}

    {% capture list_items %}
      {% for collection in section_collections limit: max_items %}
        {%- assign card_product = collection.products.first -%}
        <div class="resource-list__item">
          {%- if card_product != blank -%}
            {%- comment -%}
              One card per collection, drawn as the PLP model card: the collection's first
              product carries the image, the collection itself the name, colourway count,
              price range and hover thumbnails.
            {%- endcomment -%}
            {% render 'spy-grouped-product-card',
              product: card_product,
              group_name: collection.title,
              group_count: collection.all_products_count,
              group_collection: collection,
              block: section,
              product_view_context: 'collection'
            %}
          {%- else -%}
            {%- comment -%} Empty collection, or an unset slot in the editor — keep the stock tile {%- endcomment -%}
            {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
          {%- endif -%}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endcapture %}

    {% liquid
      # Create an array from the list items to be used for different layout types
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionList',
      slide_count: max_items,
      content_type: 'collections',
      test_id: 'collections-list-grid'
    %}
  {% endif %}
</div>


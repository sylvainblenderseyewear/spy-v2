{%- liquid
  # Count only tiles that have something to show
  assign tile_count = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.label != blank
      assign tile_count = tile_count | plus: 1
    endif
  endfor
  if tile_count == 0
    assign skip_section = true
  endif

  assign display_count = section.settings.columns

  # Arrows + loop only kick in when there are more tiles than fit in one view
  assign show_arrows = false
  if tile_count > display_count
    assign show_arrows = true
  endif

  # Source sizes every card in vw, so the image asks for the widest card it can become
  assign w_sm = section.settings.card_width_mobile | default: '80.5'
  assign w_md = section.settings.card_width_tablet | default: '30.242'
  assign w_lg = section.settings.card_width_desktop | default: '25'
  assign h_sm = section.settings.card_height_mobile | default: '110'
  assign h_md = section.settings.card_height_tablet | default: '42.944'
  assign h_lg = section.settings.card_height_desktop | default: '35.972'
  assign sizes = '(max-width: 768px) ' | append: w_sm | append: 'vw, (max-width: 991px) ' | append: w_md | append: 'vw, ' | append: w_lg | append: 'vw'
-%}

{%- unless skip_section -%}
<div
  class="spy-category-tiles"
  style="
    margin-block: {{ section.settings.margin_top }}px {{ section.settings.margin_bottom }}px;
    --spy-tile-w-sm: {{ w_sm }}vw; --spy-tile-w-md: {{ w_md }}vw; --spy-tile-w-lg: {{ w_lg }}vw;
    --spy-tile-h-sm: {{ h_sm }}vw; --spy-tile-h-md: {{ h_md }}vw; --spy-tile-h-lg: {{ h_lg }}vw;
    --spy-tile-img-w: {{ section.settings.image_width }}%; --spy-tile-img-h: {{ section.settings.image_height }}%;
    --spy-tile-label-sm: {{ section.settings.title_font_size }}px;
    --spy-tile-label-lg: {{ section.settings.title_font_size_desktop }}vw;
    --spy-tile-arrow-offset: {{ section.settings.arrow_offset }}vw;
  "
  {{ section.shopify_attributes }}
>
  {%- if section.settings.heading != blank -%}
    <p class="text-[11px] font-bold uppercase tracking-widest text-spy-gray mb-4">
      {{ section.settings.heading }}
    </p>
  {%- endif -%}

  <spy-tile-carousel
    class="spy-category-tiles__carousel block relative"
    data-loop="{{ show_arrows }}"
    data-display="{{ display_count }}"
    data-speed="{{ section.settings.transition_speed }}"
  >
    {%- if show_arrows -%}
      <button
        type="button"
        data-prev
        aria-label="Previous"
        class="absolute z-10 left-[var(--spy-tile-arrow-offset)] top-[calc(50%-40px)] -translate-y-1/2 h-10 w-10 rounded-full bg-spy-ink text-white [display:flex] items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spy-orange"
      >
        {%- comment %} Thin chevron, same weight as the source's FA light icon {% endcomment -%}
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}

    <div
      data-track
      class="spy-category-tiles__track [&[data-dragging]_a]:pointer-events-none [&[data-dragging]_button]:pointer-events-none [display:flex] overflow-x-auto snap-x snap-mandatory select-none [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden{% if show_arrows %} cursor-grab{% endif %}"
    >
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image -%}
        {%- assign label = block.settings.label -%}
        {%- assign link = block.settings.link -%}
        {%- if img == blank and label == blank -%}{%- continue -%}{%- endif -%}
        {%- assign tile_alt = label | escape -%}

        {%- comment -%}
          A tile with no link is a plain div, not <a href="#">. A dead anchor is
          focusable, announced as a link and goes nowhere when clicked.
        {%- endcomment -%}
        {%- if link != blank -%}{%- assign card_tag = 'a' -%}{%- else -%}{%- assign card_tag = 'div' -%}{%- endif -%}
        <{{ card_tag }}
          data-card
          draggable="false"
          class="spy-category-tiles__card group relative shrink-0 grow-0 min-w-0 snap-start no-underline w-[var(--spy-tile-w-sm)] h-[var(--spy-tile-h-sm)] min-[769px]:w-[var(--spy-tile-w-md)] min-[769px]:h-[var(--spy-tile-h-md)] min-[992px]:w-[var(--spy-tile-w-lg)] min-[992px]:h-[var(--spy-tile-h-lg)]"
          {% if link != blank %}href="{{ link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- comment %} Source insets the art 88% x 90% and pins it to the top, not the middle {% endcomment -%}
          <div class="relative overflow-hidden mx-auto w-[var(--spy-tile-img-w)] h-[var(--spy-tile-img-h)] bg-spy-slate">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  alt: tile_alt,
                  sizes: sizes,
                  widths: '300, 450, 600, 800, 1000, 1200',
                  class: 'spy-category-tiles__img absolute inset-0 w-full h-full object-cover pointer-events-none group-hover:opacity-0'
              }}
            {%- endif -%}

            {%- if block.settings.hover_image != blank -%}
              {{
                block.settings.hover_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  alt: '',
                  sizes: sizes,
                  widths: '300, 450, 600, 800, 1000, 1200',
                  class: 'spy-category-tiles__img absolute inset-0 w-full h-full object-cover pointer-events-none opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100'
              }}
            {%- endif -%}

            {%- if label != blank -%}
              <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full px-4 text-center pointer-events-none z-[9]">
                <p
                  class="text-white uppercase leading-none mb-2 text-[length:var(--spy-tile-label-sm)] min-[992px]:text-[length:var(--spy-tile-label-lg)]"
                  style="font-family: {{ section.settings.title_font }}; font-weight: {{ section.settings.title_font_weight }};"
                >
                  {{ label }}
                </p>
              </div>
            {%- endif -%}
          </div>
        </{{ card_tag }}>
      {%- endfor -%}
    </div>

    {%- if show_arrows -%}
      <button
        type="button"
        data-next
        aria-label="Next"
        class="absolute z-10 right-[var(--spy-tile-arrow-offset)] top-[calc(50%-40px)] -translate-y-1/2 h-10 w-10 rounded-full bg-spy-ink text-white [display:flex] items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spy-orange"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}
  </spy-tile-carousel>
</div>

<script>
  // Category tiles carousel: native swipe + seamless infinite loop + arrows.
  // Loop only turns on when there are more tiles than the display count.
  if (!customElements.get('spy-tile-carousel')) {
    customElements.define(
      'spy-tile-carousel',
      class SpyTileCarousel extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-track]');
          if (!this.track) return;

          this.loop = this.dataset.loop === 'true';
          this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          this.querySelector('[data-prev]')?.addEventListener('click', () => this.step(-1));
          this.querySelector('[data-next]')?.addEventListener('click', () => this.step(1));

          this.setupDrag();
          if (this.loop) this.setupLoop();
        }

        // Click-drag to scroll on mouse; touch/pen keep native scrolling
        setupDrag() {
          const track = this.track;
          let down = false;
          let startX = 0;
          let startScroll = 0;
          let moved = false;
          let downX = 0;
          let downY = 0;
          let lastX = 0;
          let lastT = 0;
          let velocity = 0;

          track.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse') return;
            this.clearSnapRestore();
            down = true;
            moved = false;
            downX = e.clientX;
            downY = e.clientY;
            velocity = 0;
            startX = e.clientX;
            startScroll = track.scrollLeft;
            lastX = e.clientX;
            lastT = performance.now();
            // Utilities are compiled !important, so inline styles need the priority flag to win
            track.style.setProperty('cursor', 'grabbing', 'important');
            track.style.setProperty('scroll-snap-type', 'none', 'important');
            // No setPointerCapture: it retargets the click to the track, which kills
            // every link and button inside the cards.
          });

          window.addEventListener('pointermove', (e) => {
            if (!down) return;
            const dx = e.clientX - startX;
            // Past the threshold this is a drag, not a click. Flagging the track kills
            // pointer events on the cards, so mouseup cannot land on a link or button.
            if (Math.abs(dx) > 3) {
              moved = true;
              track.dataset.dragging = '';
            }
            track.scrollLeft = startScroll - dx;

            const now = performance.now();
            const dt = now - lastT;
            if (dt > 0) velocity = (e.clientX - lastX) / dt;
            lastX = e.clientX;
            lastT = now;
          });

          const end = () => {
            if (!down) return;
            down = false;
            setTimeout(() => delete track.dataset.dragging, 0);
            track.style.removeProperty('cursor');
            // Glide a little in the flick direction, then ease onto the nearest card
            const projected = track.scrollLeft - velocity * 150;
            this.snapToNearest(projected);
            // Snap stays off during the glide; restore it once the scroll settles
            // so the release eases in instead of jumping, and touch keeps snapping
            this.restoreSnapAfterSettle();
          };
          window.addEventListener('pointerup', end);
          window.addEventListener('pointercancel', end);

          // Swallow the click after a real drag so the card link does not open
          track.addEventListener(
            'click',
            (e) => {
              // Compare against where the press started. pointermove can be swallowed
              // by a native image drag, so `moved` alone is not reliable.
              const travelled = Math.hypot(e.clientX - downX, e.clientY - downY);
              if (moved || travelled > 5) {
                e.preventDefault();
                e.stopPropagation();
                moved = false;
              }
            },
            true
          );

          // Stop the browser's native image ghost-drag
          track.addEventListener('dragstart', (e) => e.preventDefault());
        }

        restoreSnapAfterSettle() {
          this.clearSnapRestore();
          this._restoreSnap = () => {
            this.track.style.removeProperty('scroll-snap-type');
            this.clearSnapRestore();
          };
          this._restoreTimer = setTimeout(this._restoreSnap, 700);
          if ('onscrollend' in window) this.track.addEventListener('scrollend', this._restoreSnap);
        }

        clearSnapRestore() {
          if (this._restoreTimer) {
            clearTimeout(this._restoreTimer);
            this._restoreTimer = null;
          }
          if (this._restoreSnap) {
            this.track.removeEventListener('scrollend', this._restoreSnap);
            this._restoreSnap = null;
          }
        }

        // Ease onto whichever card is closest to pos, same feel as an arrow click
        snapToNearest(pos) {
          const cards = this.track.querySelectorAll('[data-card]');
          const x = pos == null ? this.track.scrollLeft : pos;
          let target = null;
          let best = Infinity;
          cards.forEach((c) => {
            const d = Math.abs(c.offsetLeft - x);
            if (d < best) {
              best = d;
              target = c;
            }
          });
          if (target) {
            this.track.scrollTo({ left: target.offsetLeft, behavior: this.reduceMotion ? 'auto' : 'smooth' });
          }
        }

        // Clone a screenful of tiles on each end so scrolling never hits a dead edge
        setupLoop() {
          this.reals = Array.from(this.track.children);
          const cloneCount = Math.min(parseInt(this.dataset.display, 10) || 4, this.reals.length);

          this.reals.slice(-cloneCount).forEach((card) => {
            this.track.insertBefore(this.markClone(card), this.reals[0]);
          });
          this.reals.slice(0, cloneCount).forEach((card) => {
            this.track.appendChild(this.markClone(card));
          });

          this.firstTail = this.reals[this.reals.length - 1].nextElementSibling;

          requestAnimationFrame(() => {
            this.track.scrollLeft = this.reals[0].offsetLeft;
          });

          let idle;
          this.track.addEventListener('scroll', () => {
            clearTimeout(idle);
            idle = setTimeout(() => this.normalize(), 120);
          });

          let resize;
          window.addEventListener('resize', () => {
            clearTimeout(resize);
            resize = setTimeout(() => this.normalize(), 150);
          });
        }

        markClone(card) {
          const clone = card.cloneNode(true);
          clone.setAttribute('data-clone', '');
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('tabindex', '-1');
          return clone;
        }

        // One card per click, glided over the source's slick speed rather than
        // the browser's own smooth-scroll timing
        step(dir) {
          const card = this.track.querySelector('[data-card]');
          if (!card) return;
          const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
          const amount = (card.getBoundingClientRect().width + gap) * dir;
          this.tween(this.track.scrollLeft + amount);
        }

        tween(to) {
          const track = this.track;
          const speed = parseInt(this.dataset.speed, 10) || 200;
          if (this.reduceMotion || speed <= 0) {
            track.scrollLeft = to;
            return;
          }
          const from = track.scrollLeft;
          const dist = to - from;
          if (!dist) return;
          // Snap fights a scripted scroll, so it is parked for the duration
          track.style.setProperty('scroll-snap-type', 'none', 'important');
          const t0 = performance.now();
          const ease = (t) => (t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t);
          const frame = (now) => {
            const p = Math.min(1, (now - t0) / speed);
            track.scrollLeft = from + dist * ease(p);
            if (p < 1) requestAnimationFrame(frame);
            else {
              track.style.removeProperty('scroll-snap-type');
              this.normalize();
            }
          };
          requestAnimationFrame(frame);
        }

        // Silently jump between clones and their real twins for a seamless loop
        normalize() {
          if (!this.loop) return;
          const start = this.reals[0].offsetLeft;
          const shift = this.firstTail.offsetLeft - start;
          const x = this.track.scrollLeft;

          if (x < start - 1) {
            this.track.scrollTo({ left: x + shift, behavior: 'auto' });
          } else if (x >= start + shift - 1) {
            this.track.scrollTo({ left: x - shift, behavior: 'auto' });
          }
        }
      }
    );
  }
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Category Tiles",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section title"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Cards visible (desktop)",
      "info": "Used for the loop clones and the arrow step."
    },
    {
      "type": "header",
      "content": "Card size — mobile (below 769px)"
    },
    {
      "type": "text",
      "id": "card_width_mobile",
      "label": "Card width (vw)",
      "default": "80.5"
    },
    {
      "type": "text",
      "id": "card_height_mobile",
      "label": "Card height (vw)",
      "default": "110"
    },
    {
      "type": "header",
      "content": "Card size — tablet (769–991px)"
    },
    {
      "type": "text",
      "id": "card_width_tablet",
      "label": "Card width (vw)",
      "default": "30.242"
    },
    {
      "type": "text",
      "id": "card_height_tablet",
      "label": "Card height (vw)",
      "default": "42.944"
    },
    {
      "type": "header",
      "content": "Card size — desktop (992px and up)"
    },
    {
      "type": "text",
      "id": "card_width_desktop",
      "label": "Card width (vw)",
      "default": "25"
    },
    {
      "type": "text",
      "id": "card_height_desktop",
      "label": "Card height (vw)",
      "default": "35.972"
    },
    {
      "type": "header",
      "content": "Artwork inside the card"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 88,
      "label": "Image width",
      "info": "The leftover space becomes the gap between cards."
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 90,
      "label": "Image height"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30,
      "label": "Space above"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": -50,
      "label": "Space below",
      "info": "Negative pulls the next section up into the card's empty strip."
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Glide duration",
      "min": 0,
      "max": 600,
      "step": 50,
      "unit": "ms",
      "default": 200,
      "info": "The source runs this carousel at 200ms."
    },
    {
      "type": "range",
      "id": "arrow_offset",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "vw",
      "default": 1,
      "label": "Arrow inset"
    },
    {
      "type": "header",
      "content": "Card title"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Font",
      "options": [
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "Font size (below 992px)"
    },
    {
      "type": "text",
      "id": "title_font_size_desktop",
      "label": "Font size (992px and up, vw)",
      "default": "2.083"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Card hover image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Card title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category Tiles",
      "category": "SPY",
      "settings": {
        "columns": 4
      },
      "blocks": [
        { "type": "tile", "settings": { "label": "Snow" } },
        { "type": "tile", "settings": { "label": "Safety" } },
        { "type": "tile", "settings": { "label": "Fishing" } },
        { "type": "tile", "settings": { "label": "Lifestyle" } },
        { "type": "tile", "settings": { "label": "Classics" } },
        { "type": "tile", "settings": { "label": "Moto" } },
        { "type": "tile", "settings": { "label": "Trail" } },
        { "type": "tile", "settings": { "label": "Blue Light" } }
      ]
    }
  ]
}
{% endschema %}

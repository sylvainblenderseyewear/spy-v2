{%- comment -%}
  SPY Footer Utilities — the light bottom bar. Each block is one full-bleed row
  (secure note + payments, then copyright + legal) separated by a hairline that
  runs the full width, like the source. Row content sits in the source's
  stepped container (540 / 720 / 1140 / 1440 + 15px gutters).
{%- endcomment -%}

{%- liquid
  assign bg = section.settings.background_color

  if bg != blank
    render 'contrast-override', background_color: bg, text_color: section.settings.text_color, section_id: section.id
  endif
-%}

<div
  class="spy-footer-utilities w-full{% if bg != blank %} color-custom-{{ section.id }}{% endif %}{% if section.settings.show_top_border %} border-t{% endif %}"
  style="{% if bg != blank %}background-color: {{ bg }};{% endif %}{% if section.settings.show_top_border %} border-top-color: {{ section.settings.top_border_color }};{% endif %}"
  {{ section.shopify_attributes }}
>
  <div
    class="spy-footer-utilities__inner w-full
      [&>.group-block]:w-full [&>.group-block]:[padding-block:var(--row-pad)] [&>.group-block:not(:last-child)]:border-b [&>.group-block:not(:last-child)]:[border-bottom-color:var(--row-line)]
      max-[769px]:[&>.group-block]:px-4
      [&>.group-block>.group-block-content]:mx-auto [&>.group-block>.group-block-content]:w-full [&>.group-block>.group-block-content]:px-[15px]
      min-[544px]:[&>.group-block>.group-block-content]:max-w-[540px] min-[769px]:[&>.group-block>.group-block-content]:max-w-[720px] min-[992px]:[&>.group-block>.group-block-content]:max-w-[1140px] min-[1200px]:[&>.group-block>.group-block-content]:max-w-[1440px]
      max-[769px]:[&>.group-block>.group-block-content]:flex-col max-[769px]:[&>.group-block>.group-block-content]:items-center max-[769px]:[&>.group-block>.group-block-content]:gap-0
      max-[769px]:[&_.group-block-content]:justify-center max-[769px]:[&_.text-block]:text-center max-[769px]:[&_.text-block_p]:text-center
      [&_a:not(:last-child)]:mr-2 [&_a:hover]:underline [&_a:hover]:text-inherit
      [&_svg]:block [&_svg]:shrink-0"
    style="--row-pad: {{ section.settings.row_padding }}px; --row-line: {{ section.settings.row_line_color }};"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "SPY Footer Utilities",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "group" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "text" },
    { "type": "payment-icons" },
    { "type": "custom-liquid" },
    { "type": "social-links" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Band"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1d2a2b"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top line",
      "default": false
    },
    {
      "type": "color",
      "id": "top_border_color",
      "label": "Top line color",
      "default": "#1d2a2b",
      "visible_if": "{{ section.settings.show_top_border }}"
    },
    {
      "type": "header",
      "content": "Rows"
    },
    {
      "type": "color",
      "id": "row_line_color",
      "label": "Line between rows",
      "default": "#1d2a2b"
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Row padding (top & bottom)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "SPY Footer Utilities",
      "category": "SPY"
    }
  ]
}
{% endschema %}

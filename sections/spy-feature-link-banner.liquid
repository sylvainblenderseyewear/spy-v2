{%- comment -%}
  Feature Link Banner — a full-bleed image with copy laid over it.

  Separate desktop and mobile art, because the source crops these banners
  differently per breakpoint rather than reflowing one file.

  The swap sits at 992px — the source's `lg`, verified on the capture: the art
  and the copy alignment both flip between 991 and 992. Tailwind's `md` (768)
  left the mobile art out of the 768–991 range, where the source still uses it.

  Placement is set per breakpoint too, so the copy can sit bottom-centre on a phone
  and centre-right on a desktop off one block. The scrim is optional: art that
  already carries a dark panel for the text doesn't want a second one over it.
{%- endcomment -%}

{%- liquid
  assign desktop_img = section.settings.image_desktop
  assign mobile_img = section.settings.image_mobile
  assign is_video = false
  if section.settings.media_type == 'video'
    assign is_video = true
  endif

  comment
    A video needs an explicit box — the iframe has no intrinsic size the way an image
    does — so each breakpoint carries its own ratio.
  endcomment
  assign ratio = section.settings.ratio_w | append: ' / ' | append: section.settings.ratio_h
  assign ratio_mobile = section.settings.ratio_w_mobile | append: ' / ' | append: section.settings.ratio_h_mobile

  # Filters can't run inside a render tag, so the style strings are built here
  assign video_style = '--size-style-aspect-ratio: ' | append: ratio | append: ';'
  assign video_style_mobile = '--size-style-aspect-ratio: ' | append: ratio_mobile | append: ';'
  assign cover_mobile = section.settings.cover_image_mobile | default: section.settings.cover_image

  if is_video
    if section.settings.video_url == blank and section.settings.video_url_mobile == blank
      assign skip_section = true
    endif
  elsif desktop_img == blank and mobile_img == blank
    assign skip_section = true
  endif

  comment
    "banner" makes the whole tile one link, which is what the big promo bands do.
    "cta" links only the button — the source hero works that way.
  endcomment
  assign wrap_link = false
  if section.settings.link != blank and section.settings.link_scope != 'cta'
    assign wrap_link = true
  endif

  comment
    Where the copy block sits is one setting; how the lines are set inside it is
    another. The source pushes this block to the right of the container but keeps
    its two heading lines flush left, so the two can't be one control.
    Text alignment falls back to the block position when left unset.
  endcomment

  case section.settings.content_align
    when 'center'
      assign align_d = 'min-[992px]:items-center'
    when 'right'
      assign align_d = 'min-[992px]:items-end'
    else
      assign align_d = 'min-[992px]:items-start'
  endcase

  assign text_d_raw = section.settings.text_align | default: section.settings.content_align
  case text_d_raw
    when 'center'
      assign text_d = 'min-[992px]:text-center'
      assign box_d = 'min-[992px]:items-center'
    when 'right'
      assign text_d = 'min-[992px]:text-right'
      assign box_d = 'min-[992px]:items-end'
    else
      assign text_d = 'min-[992px]:text-left'
      assign box_d = 'min-[992px]:items-start'
  endcase

  case section.settings.content_align_mobile
    when 'center'
      assign align_m = 'items-center'
    when 'right'
      assign align_m = 'items-end'
    else
      assign align_m = 'items-start'
  endcase

  assign text_m_raw = section.settings.text_align_mobile | default: section.settings.content_align_mobile
  case text_m_raw
    when 'center'
      assign text_m = 'text-center'
      assign box_m = 'items-center'
    when 'right'
      assign text_m = 'text-right'
      assign box_m = 'items-end'
    else
      assign text_m = 'text-left'
      assign box_m = 'items-start'
  endcase

  case section.settings.content_valign
    when 'top'
      assign valign_d = 'min-[992px]:justify-start'
    when 'center'
      assign valign_d = 'min-[992px]:justify-center'
    else
      assign valign_d = 'min-[992px]:justify-end'
  endcase

  case section.settings.content_valign_mobile
    when 'top'
      assign valign_m = 'justify-start'
    when 'center'
      assign valign_m = 'justify-center'
    else
      assign valign_m = 'justify-end'
  endcase

  comment
    The source lays the copy inside Bootstrap's .container, whose cap steps
    540 / 720 / 1140 / 1440 at 544 / 769 / 992 / 1200 with a flat 15px gutter.
    "container" reproduces that ladder; "page" is a single cap; "full" opts out.
  endcomment
  case section.settings.content_width
    when 'container'
      assign width_classes = 'mx-auto w-full min-[544px]:max-w-[540px] min-[769px]:max-w-[720px] min-[992px]:max-w-[1140px] min-[1200px]:max-w-[1440px]'
    when 'page'
      assign width_classes = 'mx-auto w-full max-w-[var(--flb-max)]'
    else
      assign width_classes = 'w-full'
  endcase

  if section.settings.show_overlay
    assign scrim = 'bg-gradient-to-t from-black/55 to-transparent'
  else
    assign scrim = ''
  endif
-%}

{%- unless skip_section -%}
  {%- assign banner_alt = section.settings.heading | strip_newlines | escape -%}
  {%- liquid
    # Source headings scale on Bootstrap's RFS curve up to the desktop size,
    # which they hit at a 1200px viewport. min() covers both sides in one value.
    if section.settings.heading_fluid
      assign flb_heading = 'min(' | append: section.settings.heading_size | append: 'px, calc(1.3rem + 0.6vw))'
      assign flb_heading_mobile = flb_heading
    else
      assign flb_heading = section.settings.heading_size | append: 'px'
      assign flb_heading_mobile = section.settings.heading_size_mobile | append: 'px'
    endif
  -%}
  <div
    class="spy-feature-link-banner relative w-full overflow-hidden mt-[var(--flb-mt-m)] mb-[var(--flb-mb-m)] min-[992px]:mt-[var(--flb-mt-d)] min-[992px]:mb-[var(--flb-mb-d)]"
    style="
      --flb-max: {{ section.settings.content_max_width }}px;
      --flb-heading: {{ flb_heading }};
      --flb-heading-mobile: {{ flb_heading_mobile }};
      --flb-mt-m: {{ section.settings.margin_top_mobile | default: 0 }}px;
      --flb-mb-m: {{ section.settings.margin_bottom_mobile | default: 0 }}px;
      --flb-mt-d: {{ section.settings.margin_top | default: 0 }}px;
      --flb-mb-d: {{ section.settings.margin_bottom | default: 0 }}px;
    "
    {{ section.shopify_attributes }}
  >
    {%- if wrap_link -%}
      <a
        href="{{ section.settings.link }}"
        class="group block no-underline"
        aria-label="{{ section.settings.eyebrow | default: banner_alt }}"
      >
    {%- endif -%}

    {%- if is_video -%}
      {%- comment -%} Desktop video {%- endcomment -%}
      {%- if section.settings.video_url != blank -%}
        <div class="hidden min-[992px]:block w-full">
          {%- render 'video-slot',
            source: 'url',
            video_url: section.settings.video_url,
            cover_image: section.settings.cover_image,
            alt: banner_alt,
            video_style: video_style,
            video_autoplay: true,
            video_loop: true,
            video_background: true
          -%}
        </div>
      {%- endif -%}

      {%- comment -%} Mobile video, falling back to the desktop file {%- endcomment -%}
      {%- assign small_video = section.settings.video_url_mobile | default: section.settings.video_url -%}
      {%- if small_video != blank -%}
        <div class="block min-[992px]:hidden w-full">
          {%- render 'video-slot',
            source: 'url',
            video_url: small_video,
            cover_image: cover_mobile,
            alt: banner_alt,
            video_style: video_style_mobile,
            video_autoplay: true,
            video_loop: true,
            video_background: true
          -%}
        </div>
      {%- endif -%}
    {%- else -%}

    {%- comment -%} Desktop art {%- endcomment -%}
    {%- if desktop_img != blank -%}
      {{
        desktop_img
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          alt: banner_alt,
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000',
          class: 'hidden min-[992px]:block w-full h-auto object-cover'
      }}
    {%- endif -%}

    {%- comment -%} Mobile art, falling back to the desktop file {%- endcomment -%}
    {%- if mobile_img != blank -%}
      {{
        mobile_img
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          alt: banner_alt,
          sizes: '100vw',
          widths: '390, 550, 800',
          class: 'block min-[992px]:hidden w-full h-auto object-cover'
      }}
    {%- elsif desktop_img != blank -%}
      {{
        desktop_img
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          alt: banner_alt,
          sizes: '100vw',
          widths: '390, 550, 800',
          class: 'block min-[992px]:hidden w-full h-auto object-cover'
      }}
    {%- endif -%}
    {%- endif -%}

    {%- if section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.cta_label != blank
    -%}
      {%- comment -%} Source insets, every width: container gutter 15px, copy box 16/16/64 {%- endcomment -%}
      <div class="spy-feature-link-banner__overlay absolute inset-0 flex pointer-events-none {{ scrim }}">
        <div
          class="
            spy-feature-link-banner__content
            flex flex-col h-full px-[15px] {{ width_classes }}
            {{ align_m }} {{ align_d }}
            {{ valign_m }} {{ valign_d }}
          "
        >
          {%- comment -%}
            The copy box is shrink-to-fit so the whole block can sit right of the
            container while its heading and button still share one left edge —
            which is what the source does.
          {%- endcomment -%}
          <div
            class="
              spy-feature-link-banner__box
              flex flex-col gap-2 w-fit max-w-full px-4 pt-4 pb-16
              {{ box_m }} {{ box_d }} {{ text_m }} {{ text_d }}
            "
          >
          {%- if section.settings.eyebrow != blank -%}
            <span class="text-spy-orange text-[11px] font-bold uppercase tracking-widest leading-none">
              {{ section.settings.eyebrow }}
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            {%- comment -%} Source .banner-heading: 600 at 1.2, with 8px under it {%- endcomment -%}
            <h2
              class="
                text-white font-semibold uppercase leading-[1.2] m-0 pb-2 tracking-normal
                text-[length:var(--flb-heading-mobile)] min-[992px]:text-[length:var(--flb-heading)]
              "
            >
              {{ section.settings.heading | newline_to_br }}
            </h2>
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            {%- comment -%} Only the button carries the link when the banner itself does not {%- endcomment -%}
            {%- liquid
              assign cta_tag = 'span'
              if wrap_link == false and section.settings.link != blank
                assign cta_tag = 'a'
              endif
            -%}
            {%- if section.settings.cta_style == 'solid' -%}
              <{{ cta_tag }}{% if cta_tag == 'a' %} href="{{ section.settings.link }}"{% endif %} class="group inline-block w-fit px-8 py-2 bg-white text-spy-ink border border-spy-ink text-sm leading-normal uppercase no-underline pointer-events-auto transition-colors duration-150 ease-in-out hover:bg-spy-ink hover:text-white group-hover:bg-spy-ink group-hover:text-white">
                {{ section.settings.cta_label }}
              </{{ cta_tag }}>
            {%- else -%}
              <{{ cta_tag }}{% if cta_tag == 'a' %} href="{{ section.settings.link }}"{% endif %} class="inline-block text-white text-xs font-bold uppercase tracking-widest border-b border-white/60 pb-0.5 leading-none no-underline pointer-events-auto">
                {{ section.settings.cta_label }}
              </{{ cta_tag }}>
            {%- endif -%}
          {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if wrap_link -%}
      </a>
    {%- endif -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Feature Link Banner",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Desktop video (992px and up)",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url_mobile",
      "label": "Mobile video",
      "accept": ["youtube", "vimeo"],
      "info": "Falls back to the desktop video if blank.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Desktop poster",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "cover_image_mobile",
      "label": "Mobile poster",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "range",
      "id": "ratio_w",
      "label": "Desktop video ratio — width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 32,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "range",
      "id": "ratio_h",
      "label": "Desktop video ratio — height",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "range",
      "id": "ratio_w_mobile",
      "label": "Mobile video ratio — width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "range",
      "id": "ratio_h_mobile",
      "label": "Mobile video ratio — height",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "visible_if": "{{ section.settings.media_type != 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Falls back to desktop image if blank",
      "visible_if": "{{ section.settings.media_type != 'video' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "link_scope",
      "label": "What the link covers",
      "options": [
        { "value": "banner", "label": "The whole banner" },
        { "value": "cta", "label": "The CTA only" }
      ],
      "default": "banner"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "underline", "label": "Underlined text" },
        { "value": "solid", "label": "Solid box" }
      ],
      "default": "underline"
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop",
      "min": 16,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_fluid",
      "label": "Scale with the viewport",
      "info": "Matches the source: grows with the window up to the desktop size, which it reaches at 1200px. Ignores the mobile size.",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile",
      "min": 14,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Placement — desktop"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Horizontal",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_valign",
      "label": "Vertical",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "info": "Separate from where the block sits.",
      "options": [
        { "value": "", "label": "Match block position" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Placement — mobile"
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Horizontal",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_valign_mobile",
      "label": "Vertical",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment",
      "info": "Separate from where the block sits.",
      "options": [
        { "value": "", "label": "Match block position" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Darken behind the copy",
      "info": "Turn off when the artwork already has a panel for the text.",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "container", "label": "Source container (540/720/1140/1440)" },
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Page width cap",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1140,
      "visible_if": "{{ section.settings.content_width == 'page' }}"
    },
    {
      "type": "header",
      "content": "Space around the banner"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Above (below 992px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Below (below 992px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Above (992px and up)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Below (992px and up)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Feature Link Banner",
      "category": "SPY"
    }
  ]
}
{% endschema %}

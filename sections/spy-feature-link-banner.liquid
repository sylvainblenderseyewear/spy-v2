{%- comment -%}
  Feature Link Banner — a full-bleed image with copy laid over it.

  Separate desktop and mobile art, because the source crops these banners
  differently per breakpoint rather than reflowing one file.

  The swap sits at 992px — the source's `lg`, verified on the capture: the art
  and the copy alignment both flip between 991 and 992. Tailwind's `md` (768)
  left the mobile art out of the 768–991 range, where the source still uses it.

  Placement is set per breakpoint too, so the copy can sit bottom-centre on a phone
  and centre-right on a desktop off one block. The scrim is optional: art that
  already carries a dark panel for the text doesn't want a second one over it.
{%- endcomment -%}

{%- liquid
  assign desktop_img = section.settings.image_desktop
  assign mobile_img = section.settings.image_mobile
  if desktop_img == blank and mobile_img == blank
    assign skip_section = true
  endif

  comment
    Where the copy block sits is one setting; how the lines are set inside it is
    another. The source pushes this block to the right of the container but keeps
    its two heading lines flush left, so the two can't be one control.
    Text alignment falls back to the block position when left unset.
  endcomment

  case section.settings.content_align
    when 'center'
      assign align_d = 'min-[992px]:items-center'
    when 'right'
      assign align_d = 'min-[992px]:items-end'
    else
      assign align_d = 'min-[992px]:items-start'
  endcase

  assign text_d_raw = section.settings.text_align | default: section.settings.content_align
  case text_d_raw
    when 'center'
      assign text_d = 'min-[992px]:text-center'
      assign box_d = 'min-[992px]:items-center'
    when 'right'
      assign text_d = 'min-[992px]:text-right'
      assign box_d = 'min-[992px]:items-end'
    else
      assign text_d = 'min-[992px]:text-left'
      assign box_d = 'min-[992px]:items-start'
  endcase

  case section.settings.content_align_mobile
    when 'center'
      assign align_m = 'items-center'
    when 'right'
      assign align_m = 'items-end'
    else
      assign align_m = 'items-start'
  endcase

  assign text_m_raw = section.settings.text_align_mobile | default: section.settings.content_align_mobile
  case text_m_raw
    when 'center'
      assign text_m = 'text-center'
      assign box_m = 'items-center'
    when 'right'
      assign text_m = 'text-right'
      assign box_m = 'items-end'
    else
      assign text_m = 'text-left'
      assign box_m = 'items-start'
  endcase

  case section.settings.content_valign
    when 'top'
      assign valign_d = 'min-[992px]:justify-start'
    when 'center'
      assign valign_d = 'min-[992px]:justify-center'
    else
      assign valign_d = 'min-[992px]:justify-end'
  endcase

  case section.settings.content_valign_mobile
    when 'top'
      assign valign_m = 'justify-start'
    when 'center'
      assign valign_m = 'justify-center'
    else
      assign valign_m = 'justify-end'
  endcase

  if section.settings.content_width == 'page'
    assign width_classes = 'mx-auto max-w-[var(--flb-max)]'
  else
    assign width_classes = 'w-full'
  endif

  if section.settings.show_overlay
    assign scrim = 'bg-gradient-to-t from-black/55 to-transparent'
  else
    assign scrim = ''
  endif
-%}

{%- unless skip_section -%}
  {%- assign banner_alt = section.settings.heading | strip_newlines | escape -%}
  {%- liquid
    # Source headings scale on Bootstrap's RFS curve up to the desktop size,
    # which they hit at a 1200px viewport. min() covers both sides in one value.
    if section.settings.heading_fluid
      assign flb_heading = 'min(' | append: section.settings.heading_size | append: 'px, calc(1.3rem + 0.6vw))'
      assign flb_heading_mobile = flb_heading
    else
      assign flb_heading = section.settings.heading_size | append: 'px'
      assign flb_heading_mobile = section.settings.heading_size_mobile | append: 'px'
    endif
  -%}
  <div
    class="spy-feature-link-banner relative w-full overflow-hidden"
    style="
      --flb-max: {{ section.settings.content_max_width }}px;
      --flb-heading: {{ flb_heading }};
      --flb-heading-mobile: {{ flb_heading_mobile }};
    "
    {{ section.shopify_attributes }}
  >
    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        class="group block no-underline"
        aria-label="{{ section.settings.eyebrow | default: banner_alt }}"
      >
    {%- endif -%}

    {%- comment -%} Desktop art {%- endcomment -%}
    {%- if desktop_img != blank -%}
      {{
        desktop_img
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          alt: banner_alt,
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000',
          class: 'hidden min-[992px]:block w-full h-auto object-cover'
      }}
    {%- endif -%}

    {%- comment -%} Mobile art, falling back to the desktop file {%- endcomment -%}
    {%- if mobile_img != blank -%}
      {{
        mobile_img
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          alt: banner_alt,
          sizes: '100vw',
          widths: '390, 550, 800',
          class: 'block min-[992px]:hidden w-full h-auto object-cover'
      }}
    {%- elsif desktop_img != blank -%}
      {{
        desktop_img
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          alt: banner_alt,
          sizes: '100vw',
          widths: '390, 550, 800',
          class: 'block min-[992px]:hidden w-full h-auto object-cover'
      }}
    {%- endif -%}

    {%- if section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.cta_label != blank
    -%}
      {%- comment -%} Desktop insets are the source's: container 15px, copy box 16/16/64 {%- endcomment -%}
      <div class="spy-feature-link-banner__overlay absolute inset-0 flex px-6 py-6 min-[992px]:px-[15px] min-[992px]:py-0 pointer-events-none {{ scrim }}">
        <div
          class="
            spy-feature-link-banner__content
            flex flex-col flex-1 {{ width_classes }}
            {{ align_m }} {{ align_d }}
            {{ valign_m }} {{ valign_d }}
          "
        >
          {%- comment -%}
            The copy box is shrink-to-fit so the whole block can sit right of the
            container while its heading and button still share one left edge —
            which is what the source does.
          {%- endcomment -%}
          <div
            class="
              spy-feature-link-banner__box
              flex flex-col gap-2 w-fit max-w-full
              min-[992px]:px-4 min-[992px]:pt-4 min-[992px]:pb-16
              {{ box_m }} {{ box_d }} {{ text_m }} {{ text_d }}
            "
          >
          {%- if section.settings.eyebrow != blank -%}
            <span class="text-spy-orange text-[11px] font-bold uppercase tracking-widest leading-none">
              {{ section.settings.eyebrow }}
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            {%- comment -%} Source .banner-heading: 600 at 1.2, with 8px under it {%- endcomment -%}
            <h2
              class="
                text-white font-semibold uppercase leading-[1.2] m-0 pb-2 tracking-normal
                text-[length:var(--flb-heading-mobile)] min-[992px]:text-[length:var(--flb-heading)]
              "
            >
              {{ section.settings.heading | newline_to_br }}
            </h2>
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            {%- if section.settings.cta_style == 'solid' -%}
              <span class="inline-block w-fit px-8 py-2 bg-white text-spy-ink border border-spy-ink text-sm leading-normal uppercase pointer-events-auto transition-colors duration-200 group-hover:bg-spy-ink group-hover:text-white">
                {{ section.settings.cta_label }}
              </span>
            {%- else -%}
              <span class="inline-block text-white text-xs font-bold uppercase tracking-widest border-b border-white/60 pb-0.5 leading-none pointer-events-auto">
                {{ section.settings.cta_label }}
              </span>
            {%- endif -%}
          {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Feature Link Banner",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Falls back to desktop image if blank"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "underline", "label": "Underlined text" },
        { "value": "solid", "label": "Solid box" }
      ],
      "default": "underline"
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop",
      "min": 16,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_fluid",
      "label": "Scale with the viewport",
      "info": "Matches the source: grows with the window up to the desktop size, which it reaches at 1200px. Ignores the mobile size.",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile",
      "min": 14,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Placement — desktop"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Horizontal",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_valign",
      "label": "Vertical",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "info": "Separate from where the block sits.",
      "options": [
        { "value": "", "label": "Match block position" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Placement — mobile"
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Horizontal",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_valign_mobile",
      "label": "Vertical",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment",
      "info": "Separate from where the block sits.",
      "options": [
        { "value": "", "label": "Match block position" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Darken behind the copy",
      "info": "Turn off when the artwork already has a panel for the text.",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Page width cap",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1140,
      "visible_if": "{{ section.settings.content_width == 'page' }}"
    }
  ],
  "presets": [
    {
      "name": "Feature Link Banner",
      "category": "SPY"
    }
  ]
}
{% endschema %}

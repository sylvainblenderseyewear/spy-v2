{%- comment -%}
  Quick View shell — the empty dialog every PLP card opens. spy-quick-view.js
  fills the body from the spy-quick-view-content section.

  Geometry follows the source modal: a light grey veil (#e6e6e6 at 60%, not a
  black scrim), a white sheet centred in the viewport, and Bootstrap's width
  ladder — full bleed under 544px, then 500 / 800 / 1140.

  Stacking sits just under the PDP drawers (1001), so a Size Chart opened from
  inside the dialog covers it once its own script moves it to <body>.
{%- endcomment -%}

<div class="spy-qv group/qv" data-spy-qv-root {{ section.shopify_attributes }}>
  <div
    class="fixed inset-0 z-[990] bg-[color:var(--color-spy-border)] opacity-0 pointer-events-none transition-opacity duration-150 ease-linear group-data-[open]/qv:opacity-60 group-data-[open]/qv:pointer-events-auto motion-reduce:transition-none"
    data-spy-qv-close
  ></div>

  {%- comment -%} Scroll layer, so a tall dialog scrolls with the page behind it locked {%- endcomment -%}
  <div
    class="fixed inset-0 z-[1000] hidden overflow-y-auto overflow-x-hidden overscroll-contain outline-none group-data-[open]/qv:block"
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.dialog_label | default: 'Quick view' }}"
    aria-hidden="true"
    data-spy-qv-layer
  >
    {%- comment -%}
      Source dialog: margin .5rem full-bleed, then 1.75rem auto with a max-width
      per breakpoint. It slides down 50px on open, like .modal.fade.
    {%- endcomment -%}
    <div
      class="relative m-2 [display:flex] min-h-[calc(100%_-_16px)] items-center -translate-y-[50px] transition-transform duration-300 ease-out group-data-[open]/qv:translate-y-0 min-[544px]:mx-auto min-[544px]:my-7 min-[544px]:min-h-[calc(100%_-_56px)] min-[544px]:max-w-[500px] min-[992px]:max-w-[800px] min-[1200px]:max-w-[1140px] motion-reduce:transition-none"
      data-spy-qv-dialog
    >
      <div class="relative w-full [display:flex] flex-col bg-white pb-6">
        <div class="[display:flex] items-start justify-between p-4">
          <a
            class="text-[16px] font-semibold leading-[1.4] text-[color:var(--color-spy-orange-ui)] no-underline hover:underline"
            href="#"
            data-spy-qv-pdp-link
          >
            {{ section.settings.full_details_label | default: 'View Full Details' }}
          </a>

          {%- comment -%} Source close is a text glyph that scales with the viewport {%- endcomment -%}
          <button
            type="button"
            class="-m-4 ml-auto block cursor-pointer border-none bg-transparent p-4 text-[calc(1.3rem_+_0.6vw)] font-extralight leading-none text-black opacity-50 [text-shadow:0_1px_0_#fff] hover:opacity-75 min-[1200px]:text-[1.75rem]"
            aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
            data-spy-qv-close
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="relative min-h-[200px] flex-1 p-4" data-spy-qv-body></div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'spy-quick-view.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quick View Modal",
  "settings": [
    {
      "type": "text",
      "id": "full_details_label",
      "label": "Full details link",
      "default": "View Full Details"
    },
    {
      "type": "text",
      "id": "dialog_label",
      "label": "Dialog accessible name",
      "default": "Quick view"
    }
  ]
}
{% endschema %}

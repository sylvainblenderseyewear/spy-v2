

{% liquid
  assign s = section.settings

  if s.background_color != blank
    render 'contrast-override', background_color: s.background_color, section_id: section.id
  endif

  # Legal and support pages follow the source's Bootstrap container (540/720/1140/1440
  # + 15px gutters) instead of Horizon's 54rem reading column. From 992px the source row
  # adds 48px of side padding, and Terms adds another 48 on top of that.
  # Horizon caps the centre column at 100% - 2 × --page-margin (3.5rem), which is
  # narrower than the source's container, so these pages drop the margin to 5px.
  assign source_grid = '[--page-margin:5px] [--page-content-width:calc(100%-30px)] min-[544px]:[--page-content-width:510px] min-[769px]:[--page-content-width:690px] '
  assign page_column = ''

  case page.template_suffix
    when 'privacy-policy'
      assign page_column = source_grid | append: 'min-[992px]:[--page-content-width:1110px] min-[1200px]:[--page-content-width:min(1410px,calc(100%-30px))]'
    when 'legal-notices'
      assign page_column = source_grid | append: 'min-[992px]:[--page-content-width:1014px] min-[1200px]:[--page-content-width:min(1314px,calc(100%-126px))]'
    when 'terms-of-use'
      assign page_column = source_grid | append: 'min-[992px]:[--page-content-width:918px] min-[1200px]:[--page-content-width:min(1218px,calc(100%-222px))]'
    when 'shipping'
      # Source column is col-lg-8 of the 1440 container less the row's 48px side
      # margins — 834px at full width, and it never gets wider than that.
      capture page_column
        echo source_grid
        echo 'min-[992px]:[--page-content-width:min(834px,calc(66.6667%-126px))] '
        # The title sits in its own block, so its type has to be set from out here
        echo '[&_h1]:text-[calc(1.325rem_+_0.9vw)] min-[1200px]:[&_h1]:text-[32px] '
        echo '[&_h1]:font-semibold [&_h1_strong]:font-semibold [&_h1]:leading-[1.2] '
        echo '[&_h1]:tracking-normal [&_h1]:normal-case [&_h1]:mb-2 '
        # Source keeps an empty paragraph under the title: 8px + 38.4px of it
        echo '[&_.section-content-wrapper]:gap-[38.4px] '
        # Row only adds its top padding from 992px up
        echo 'min-[992px]:[&_.section-content-wrapper]:pt-[48px] '
      endcapture
  endcase

  # Spacing: desktop values, and the mobile set only when the editor asks for one
  assign pad_desktop = s['padding-block-start'] | append: ',' | append: s['padding-block-end']
  assign pad_desktop = pad_desktop | append: ',' | append: s.padding_left | append: ',' | append: s.padding_right

  assign mar_desktop = s.margin_top | append: ',' | append: s.margin_bottom
  assign mar_desktop = mar_desktop | append: ',' | append: s.margin_left | append: ',' | append: s.margin_right

  if s.mobile_override
    assign pad_mobile = s.padding_top_mobile | append: ',' | append: s.padding_bottom_mobile
    assign pad_mobile = pad_mobile | append: ',' | append: s.padding_left_mobile | append: ',' | append: s.padding_right_mobile

    assign mar_mobile = s.margin_top_mobile | append: ',' | append: s.margin_bottom_mobile
    assign mar_mobile = mar_mobile | append: ',' | append: s.margin_left_mobile | append: ',' | append: s.margin_right_mobile
  else
    assign pad_mobile = pad_desktop
    assign mar_mobile = mar_desktop
  endif
%}

{%- comment -%}
  One var per side, per breakpoint. Padding keeps Horizon's spacing scale so
  existing pages measure the same; margin stays flat px.
{%- endcomment -%}
{%- capture spacing_vars -%}
  {%- assign pad_names = 'pt,pb,pl,pr' | split: ',' -%}
  {%- assign mar_names = 'mt,mb,ml,mr' | split: ',' -%}
  {%- assign sets = 'd,m' | split: ',' -%}
  {%- for set in sets -%}
    {%- if set == 'd' -%}
      {%- assign pad_vals = pad_desktop | split: ',' -%}
      {%- assign mar_vals = mar_desktop | split: ',' -%}
      {%- assign suffix = '' -%}
    {%- else -%}
      {%- assign pad_vals = pad_mobile | split: ',' -%}
      {%- assign mar_vals = mar_mobile | split: ',' -%}
      {%- assign suffix = '-m' -%}
    {%- endif -%}
    {%- for name in pad_names -%}
      {%- assign v = pad_vals[forloop.index0] | plus: 0 -%}
      --mp-{{ name }}{{ suffix }}:
      {%- if v > 20 %} max(20px, calc(var(--spacing-scale) * {{ v }}px));
      {%- else %} {{ v }}px;
      {%- endif -%}
    {%- endfor -%}
    {%- for name in mar_names -%}
      --mp-{{ name }}{{ suffix }}: {{ mar_vals[forloop.index0] | plus: 0 }}px;
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content {{ page_column }}{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  {%- comment -%}
    The vars below feed Horizon's own `spacing-style`, so padding and margin
    land on every side without a second wrapper.
  {%- endcomment -%}
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
      {% if s.full_width %}force-full-width{% endif %}
      [--padding-block-start:var(--mp-pt-m)] [--padding-block-end:var(--mp-pb-m)]
      [--padding-inline-start:var(--mp-pl-m)] [--padding-inline-end:var(--mp-pr-m)]
      [--margin-block-start:var(--mp-mt-m)] [--margin-block-end:var(--mp-mb-m)]
      [--margin-inline-start:var(--mp-ml-m)] [--margin-inline-end:var(--mp-mr-m)]
      min-[750px]:[--padding-block-start:var(--mp-pt)] min-[750px]:[--padding-block-end:var(--mp-pb)]
      min-[750px]:[--padding-inline-start:var(--mp-pl)] min-[750px]:[--padding-inline-end:var(--mp-pr)]
      min-[750px]:[--margin-block-start:var(--mp-mt)] min-[750px]:[--margin-block-end:var(--mp-mb)]
      min-[750px]:[--margin-inline-start:var(--mp-ml)] min-[750px]:[--margin-inline-end:var(--mp-mr)]
    "
    style="
      {% render 'layout-panel-style', settings: s %}
      {{ spacing_vars }}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width content",
      "info": "Lets blocks run edge to edge instead of sitting in the page reading column. Blocks then set their own max width.",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Margin",
      "info": "Space outside the content, so a background color stops before it."
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_left",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_right",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile spacing",
      "info": "Off means phones reuse the values above."
    },
    {
      "type": "checkbox",
      "id": "mobile_override",
      "label": "Separate values below 750px",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Padding left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Padding right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margin top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margin bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "margin_left_mobile",
      "label": "Margin left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    },
    {
      "type": "range",
      "id": "margin_right_mobile",
      "label": "Margin right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.mobile_override }}"
    }
  ]
}
{% endschema %}

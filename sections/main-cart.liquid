

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

{%- liquid
  # Utility sets shared by the live page and the empty-cart template
  assign ladder_class = ''
  if section.settings.section_width == 'container'
    assign ladder_class = ' w-full mx-auto min-[544px]:max-w-[540px] min-[769px]:max-w-[720px] min-[992px]:max-w-[1140px] min-[1200px]:max-w-[1440px]'
  endif
-%}
{%- capture cart_page_style -%}
  {%- render 'spacing-style', settings: section.settings -%}
  --spy-cart-cols: {{ section.settings.summary_columns | default: 5 }};
  --spy-cart-gap: {{ section.settings.column_gap | default: 0 }}px;
  --spy-cart-gutter: {{ section.settings.gutter | default: 0 }}px;
{%- endcapture -%}

{% capture more_blocks %}{%- content_for 'blocks' -%}{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}{% if section.settings.section_width == 'container' %} [&>*]:col-span-full{% endif %}"
    >
      <div
        class="cart-page cart-page--empty spacing-style [display:flex] flex-col items-center justify-center px-[var(--spy-cart-gutter)]{{ ladder_class }}"
        style="{{ cart_page_style }}"
      >
        <div class="cart-page__title mt-[var(--margin-6xl)] text-center">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true %}
        </div>
        <div class="cart-page__items mt-[var(--margin-lg)]">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true %}
        </div>
        <div class="cart-page__more-blocks w-full mt-[var(--margin-6xl)]">{{ more_blocks }}</div>
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}{% if section.settings.section_width == 'container' %} [&>*]:col-span-full{% endif %}"
  >
    {%- comment -%}
      Source grid: Bootstrap row, items + summary split out of 12 columns,
      side by side from 769px. Values come from the section settings.
    {%- endcomment -%}
    <div
      class="cart-page spacing-style px-[var(--spy-cart-gutter)] text-spy-ink{% if cart.empty? %} cart-page--empty [display:flex] flex-col items-center justify-center{% else %} [display:grid] grid-cols-[100%] gap-0 min-[769px]:grid-cols-[calc((100%_+_var(--spy-cart-gap))_*_(12_-_var(--spy-cart-cols))_/_12_-_var(--spy-cart-gap))_calc((100%_+_var(--spy-cart-gap))_*_var(--spy-cart-cols)_/_12_-_var(--spy-cart-gap))] min-[769px]:gap-x-[var(--spy-cart-gap)] grid-rows-[auto]{% endif %}{{ ladder_class }}"
      style="{{ cart_page_style }}"
    >
      {%- if section.settings.show_continue_link != false -%}
        {%- comment -%} Source puts a back link above the heading {%- endcomment -%}
        {%- liquid
          assign continue_label = section.settings.continue_label
          if continue_label == blank
            assign continue_label = 'actions.continue_shopping' | t
          endif
        -%}
        <div class="spy-cart__continue-row row-1 col-span-full self-start mb-6 leading-[22.4px]">
          <a
            class="spy-cart__continue inline-block text-[13px] font-semibold leading-[18.2px] uppercase text-spy-text-2 no-underline transition-colors duration-200 ease-out hover:text-spy-link-hover"
            href="{{ section.settings.continue_link | default: settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
          >
            &lt; {{ continue_label }}
          </a>
        </div>
      {%- endif -%}

      <div class="cart-page__title{% if cart.empty? %} mt-[var(--margin-6xl)] text-center{% else %} row-2 col-span-full mb-2{% endif %}">
        {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
      </div>

      <div class="cart-page__items min-w-0{% if cart.empty? %} mt-[var(--margin-lg)]{% else %} row-3 col-1 mt-0{% endif %}">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}

        {%- comment -%}
          Promo code — Shopify has no cart-page discount API, so this hands off to
          /discount/{code}, which applies it and redirects back here.
        {%- endcomment -%}
        {%- if section.settings.show_promo != false -%}
          {%- unless cart.empty? -%}
            {%- render 'spy-cart-promo',
              toggle_label: section.settings.promo_toggle_label,
              label: section.settings.promo_label,
              placeholder: section.settings.promo_placeholder,
              button_label: section.settings.promo_button
            -%}
          {%- endunless -%}
        {%- endif -%}
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary row-4 col-1 min-[769px]:row-3 min-[769px]:col-2 block h-auto min-w-0 p-0 self-start min-[769px]:has-[.cart-summary--extend]:self-stretch">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      <div class="cart-page__more-blocks w-full{% if cart.empty? %} mt-[var(--margin-6xl)]{% else %} col-span-full{% endif %}">{{ more_blocks }}</div>
    </div>
  </div>
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        },
        {
          "value": "container",
          "label": "Container ladder (540 / 720 / 1140 / 1440)"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gutter",
      "label": "Side gutter",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "summary_columns",
      "label": "Summary width (columns of 12)",
      "info": "Items and summary sit side by side from 769px.",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Continue shopping link"
    },
    {
      "type": "checkbox",
      "id": "show_continue_link",
      "label": "Show link",
      "default": true
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Label",
      "info": "Leave blank to use the translation.",
      "visible_if": "{{ section.settings.show_continue_link }}"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "Link",
      "info": "Leave blank to use the empty-cart link from theme settings.",
      "visible_if": "{{ section.settings.show_continue_link }}"
    },
    {
      "type": "header",
      "content": "Promo code"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo code box",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_toggle_label",
      "label": "Mobile toggle label",
      "info": "Shown under 544px. Leave blank to use the translation.",
      "visible_if": "{{ section.settings.show_promo }}"
    },
    {
      "type": "text",
      "id": "promo_label",
      "label": "Label",
      "info": "Leave blank to use the translation.",
      "visible_if": "{{ section.settings.show_promo }}"
    },
    {
      "type": "text",
      "id": "promo_placeholder",
      "label": "Placeholder",
      "visible_if": "{{ section.settings.show_promo }}"
    },
    {
      "type": "text",
      "id": "promo_button",
      "label": "Button label",
      "visible_if": "{{ section.settings.show_promo }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}

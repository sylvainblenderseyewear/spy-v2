{%- comment -%}
  Favorite products — a hand-picked row of four PLP cards, for any page.

  Reuses the grouped PLP card (`spy-grouped-product-card`), so a card here reads
  exactly like one on a category page: square image, hover swatches, Quick View,
  badge slot, model name and colourway count.

  Two things make that work outside a collection:
  - the wrapper carries `section-resource-list`, the class the card CSS is scoped
    to alongside `collection-component`;
  - the card settings are passed as `block: section`, since the snippet only ever
    reads `.settings` and `.id` off it.

  Every measurement is a setting. Values ride on CSS vars set inline and are read
  back by Tailwind utilities (`pt-[var(--x)]`), because Tailwind runs in important
  mode — a plain inline style would lose to any utility on the same box.
  Mobile and desktop get their own var, switched at the `lg` breakpoint.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign cols_d = s.columns_desktop | default: 4
  assign cols_t = s.columns_tablet | default: 2
  assign cols_m = s.columns_mobile | default: 2

  assign max_width = '100%'
  if s.section_width == 'page'
    assign max_width = s.max_width | default: 1440 | append: 'px'
  endif
-%}

<div
  class="
    section-resource-list
    pt-[var(--spy-fav-pt-m)] pb-[var(--spy-fav-pb-m)] px-[var(--spy-fav-px-m)]
    lg:pt-[var(--spy-fav-pt)] lg:pb-[var(--spy-fav-pb)] lg:px-[var(--spy-fav-px)]
    {% if s.section_background_color != blank %}bg-[var(--spy-fav-bg)]{% endif %}
  "
  style="
    --spy-fav-pt: {{ s.padding-block-start }}px;
    --spy-fav-pb: {{ s.padding-block-end }}px;
    --spy-fav-px: {{ s.padding_inline }}px;
    --spy-fav-pt-m: {{ s.padding_block_start_mobile }}px;
    --spy-fav-pb-m: {{ s.padding_block_end_mobile }}px;
    --spy-fav-px-m: {{ s.padding_inline_mobile }}px;
    --spy-fav-maxw: {{ max_width }};
    --spy-fav-cols: repeat({{ cols_d }}, minmax(0, 1fr));
    --spy-fav-cols-t: repeat({{ cols_t }}, minmax(0, 1fr));
    --spy-fav-cols-m: repeat({{ cols_m }}, minmax(0, 1fr));
    --spy-fav-gx: {{ s.gap_horizontal }}px;
    --spy-fav-gy: {{ s.gap_vertical }}px;
    --spy-fav-gx-m: {{ s.gap_horizontal_mobile }}px;
    --spy-fav-gy-m: {{ s.gap_vertical_mobile }}px;
    --spy-fav-heading: {{ s.heading_size_mobile }}px;
    --spy-fav-heading-d: {{ s.heading_size }}px;
    --spy-fav-heading-gap: {{ s.heading_spacing }}px;
    {% if s.section_background_color != blank %}--spy-fav-bg: {{ s.section_background_color }};{% endif %}
  "
>
  <div class="mx-auto w-full max-w-[var(--spy-fav-maxw)]">
    {%- if s.heading != blank -%}
      <h2
        class="
          m-0 font-spy font-bold uppercase tracking-wide text-spy-text
          mb-[var(--spy-fav-heading-gap)]
          text-[length:var(--spy-fav-heading)] lg:text-[length:var(--spy-fav-heading-d)]
          {% case s.heading_alignment %}
            {% when 'left' %}text-left
            {% when 'right' %}text-right
            {% else %}text-center
          {% endcase %}
        "
      >
        {{ s.heading }}
      </h2>
    {%- endif -%}

    <ul
      class="
        m-0 list-none p-0 [display:grid]
        [grid-template-columns:var(--spy-fav-cols-m)]
        gap-x-[var(--spy-fav-gx-m)] gap-y-[var(--spy-fav-gy-m)]
        md:[grid-template-columns:var(--spy-fav-cols-t)]
        lg:[grid-template-columns:var(--spy-fav-cols)]
        lg:gap-x-[var(--spy-fav-gx)] lg:gap-y-[var(--spy-fav-gy)]
      "
    >
      {%- for i in (1..4) -%}
        {%- liquid
          assign key = 'product_' | append: i
          assign fav_product = s[key]
        -%}
        {%- if fav_product == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- comment -%}
          Model name and colourway total, same sources the grouped PLP reads: the
          `collection: xxx` tag names the model, the model's own collection knows
          how many colourways it holds.
        {%- endcomment -%}
        {%- capture group_name -%}
          {%- render 'spy-group-name', product: fav_product -%}
        {%- endcapture -%}
        {%- assign group_name = group_name | strip -%}

        {%- capture model_facts -%}
          {%- render 'spy-model-collection-facts', product: fav_product, group_name: group_name -%}
        {%- endcapture -%}
        {%- liquid
          assign model_facts = model_facts | strip | split: '~^~'
          assign group_count = model_facts[0] | plus: 0
          if group_count < 1
            assign group_count = 1
          endif

          # Card image only ever fills one grid track, so the hint follows the column count
          assign vw_d = 100 | divided_by: cols_d
          assign vw_m = 100 | divided_by: cols_m
          assign image_sizes = '(min-width: 1024px) ' | append: vw_d | append: 'vw, ' | append: vw_m | append: 'vw'
        -%}

        <li class="product-grid__item" data-product-id="{{ fav_product.id }}">
          {%- render 'spy-grouped-product-card',
            product: fav_product,
            group_name: group_name,
            group_count: group_count,
            block: section,
            image_sizes: image_sizes,
            product_view_context: 'page'
          -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Favorite products",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pick up to four products. Each card shows the model name and colourway count from the product's `collection: xxx` tag."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show the row on its own."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size — desktop",
      "min": 14,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size — mobile",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "full",
          "label": "t:options.full"
        },
        {
          "value": "page",
          "label": "t:options.page"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440,
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "info": "From 1024px up.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "info": "768px to 1023px.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "Horizontal gap — desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "Vertical gap — desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "Horizontal gap — mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "Vertical gap — mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Side padding — desktop",
      "info": "Left and right.",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_block_start_mobile",
      "label": "Top padding — mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_block_end_mobile",
      "label": "Bottom padding — mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Side padding — mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "text",
      "id": "label_colors_one",
      "label": "Label — one colourway",
      "default": "1 color available"
    },
    {
      "type": "text",
      "id": "label_colors_many",
      "label": "Label — several colourways",
      "info": "Use [count] where the number goes.",
      "default": "[count] colors available"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show colourway thumbnails on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "swatch_count",
      "label": "Thumbnails shown",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.show_swatches }}"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "label_price_from",
      "label": "Label — price range",
      "info": "Printed before the price when the model's colourways differ.",
      "default": "Starting from",
      "visible_if": "{{ section.settings.show_price }}"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "Space between the card's bands",
      "info": "0 matches the PLP card, which spaces them with their own margins.",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "image_picker",
      "id": "happy_boost_icon",
      "label": "Happy Boost badge"
    },
    {
      "type": "image_picker",
      "id": "mips_icon",
      "label": "Mips badge"
    },
    {
      "type": "image_picker",
      "id": "bonus_lens_icon",
      "label": "Bonus lens badge"
    },
    {
      "type": "image_picker",
      "id": "deadbolt_icon",
      "label": "Deadbolt badge"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.thickness",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:settings.opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Favorite products"
    }
  ]
}
{% endschema %}

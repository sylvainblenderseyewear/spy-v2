{%- comment -%}
  Favorite products — a hand-picked row of four PLP cards, for any page.

  Reuses the grouped PLP card (`spy-grouped-product-card`), so a card here reads
  exactly like one on a category page: square image, hover swatches, Quick View,
  badge slot, model name and colourway count.

  Two things make that work outside a collection:
  - the wrapper carries `section-resource-list`, the class the card CSS is scoped
    to alongside `collection-component`;
  - the card settings are passed as `block: section`, since the snippet only ever
    reads `.settings` and `.id` off it.

  Each page picks its own four products in the theme editor.
{%- endcomment -%}

{%- liquid
  assign picked = ''
  for i in (1..4)
    assign key = 'product_' | append: i
    assign chosen = section.settings[key]
    if chosen != blank
      assign picked = picked | append: chosen.id | append: ','
    endif
  endfor
-%}

<div
  class="
    section-resource-list
    pt-[var(--spy-fav-pt)] pb-[var(--spy-fav-pb)]
    px-[var(--spy-fav-px-mobile)] lg:px-[var(--spy-fav-px)]
  "
  style="
    --spy-fav-pt: {{ section.settings.padding-block-start }}px;
    --spy-fav-pb: {{ section.settings.padding-block-end }}px;
    --spy-fav-px: {{ section.settings.padding-inline }}px;
    --spy-fav-px-mobile: {{ section.settings.padding_inline_mobile }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="m-0 mb-6 text-center font-spy text-xl font-bold uppercase tracking-wide text-spy-text lg:text-2xl">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  <ul class="m-0 list-none p-0 [display:grid] grid-cols-2 gap-x-4 gap-y-6 lg:grid-cols-4">
    {%- for i in (1..4) -%}
      {%- liquid
        assign key = 'product_' | append: i
        assign fav_product = section.settings[key]
      -%}
      {%- if fav_product == blank -%}
        {%- continue -%}
      {%- endif -%}

      {%- comment -%}
        Model name and colourway total, same sources the grouped PLP reads: the
        `collection: xxx` tag names the model, the model's own collection knows
        how many colourways it holds.
      {%- endcomment -%}
      {%- capture group_name -%}
        {%- render 'spy-group-name', product: fav_product -%}
      {%- endcapture -%}
      {%- assign group_name = group_name | strip -%}

      {%- capture model_facts -%}
        {%- render 'spy-model-collection-facts', product: fav_product, group_name: group_name -%}
      {%- endcapture -%}
      {%- liquid
        assign model_facts = model_facts | strip | split: '~^~'
        assign group_count = model_facts[0] | plus: 0
        if group_count < 1
          assign group_count = 1
        endif
      -%}

      <li class="product-grid__item" data-product-id="{{ fav_product.id }}">
        {%- render 'spy-grouped-product-card',
          product: fav_product,
          group_name: group_name,
          group_count: group_count,
          block: section,
          image_sizes: '(min-width: 1024px) 25vw, 50vw',
          product_view_context: 'page'
        -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Favorite products",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pick up to four products. Each card shows the model name and colourway count from the product's `collection: xxx` tag."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show the row on its own."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "text",
      "id": "label_colors_one",
      "label": "Label — one colourway",
      "default": "1 color available"
    },
    {
      "type": "text",
      "id": "label_colors_many",
      "label": "Label — several colourways",
      "info": "Use [count] where the number goes.",
      "default": "[count] colors available"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show colourway thumbnails on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "swatch_count",
      "label": "Thumbnails shown",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.show_swatches }}"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "label_price_from",
      "label": "Label — price range",
      "info": "Printed before the price when the model's colourways differ.",
      "default": "Starting from",
      "visible_if": "{{ section.settings.show_price }}"
    },
    {
      "type": "image_picker",
      "id": "happy_boost_icon",
      "label": "Happy Boost badge"
    },
    {
      "type": "image_picker",
      "id": "mips_icon",
      "label": "Mips badge"
    },
    {
      "type": "image_picker",
      "id": "bonus_lens_icon",
      "label": "Bonus lens badge"
    },
    {
      "type": "image_picker",
      "id": "deadbolt_icon",
      "label": "Deadbolt badge"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "t:settings.left_padding",
      "info": "Left and right, on desktop.",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Mobile side padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Favorite products"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Grouped PLP — the category grid with one card per model instead of one per
  colourway. Staging carries each colourway as its own product, all sharing a
  `collection::MODEL` tag, so this section folds them together: it counts the
  group, renders one colourway as its card, and skips the rest.

  Colourway pages (picked in the settings, or a model's own collection) skip the
  folding and show one card per frame, like spyoptic.com's colourway tiles.

  Same shell as `main-collection` (filters, sort, pagination), so a collection can
  be moved between the two templates with nothing else to change. No breadcrumb —
  add `spy-breadcrumbs` as a block if the grouped PLP ever wants one.

  Liquid never hands a page more than 50 collection products, which is the whole
  difficulty here: a model's colourways are scattered through the sort order, so
  grouping page by page would repeat the same model on page after page (measured:
  189 cards for 137 models across 8 pages). Two modes handle that:

  - PAGE mode, when the results fit one page: that page holds every product there
    is to group, so first-seen-wins is exact and costs nothing extra.
  - MODEL mode, when they don't: the model's own collection names one colourway as
    the representative, so a model renders on exactly one page whatever the sort
    order (measured: 137 cards for 137 models, no repeats).

  Known limit: in MODEL mode a filter can hide the representative colourway, and
  the model then drops off the grid even though other colourways matched. Filters
  usually narrow to a single page, where PAGE mode takes over and nothing is lost.
  The real fix is the combined-listing migration, which retires this section and
  hands everything back to `main-collection`.
{%- endcomment -%}

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  # Same grid runs the search page, fed by product results instead of a collection
  assign is_search = false
  if template.name == 'search'
    assign is_search = true
  endif

  # One card per frame instead of per model: on the pages picked in the settings,
  # where spyoptic.com shows colourway tiles, and on a model's own collection,
  # where one model card would be the whole page
  assign per_colourway = false
  unless is_search
    assign colourway_handles = '|'
    for picked in section.settings.colourway_collections
      assign colourway_handles = colourway_handles | append: picked.handle | append: '|'
    endfor
    assign handle_probe = '|' | append: collection.handle | append: '|'

    if colourway_handles contains handle_probe
      assign per_colourway = true
    else
      capture first_model
        render 'spy-group-name', product: collection.products.first
      endcapture
      assign first_model = first_model | strip
      if first_model != blank
        assign first_model_key = first_model | handleize
        assign first_model_title = first_model | downcase
        assign collection_title = collection.title | downcase | strip
        if collection.handle == first_model_key or collection_title == first_model_title
          assign per_colourway = true
        endif
      endif
    endif
  endunless

  # Lens words this page is about (Polarized → "polar"), so each frame shows a lens that fits
  assign page_lens_words = ''
  if per_colourway
    assign collection_title = collection.title | downcase
    assign lens_words = section.settings.colourway_lens_words | split: ','
    for lens_word in lens_words
      # New name: an assign can't change the loop variable inside its own loop
      assign clean_word = lens_word | strip | downcase
      if clean_word == blank
        continue
      endif
      assign clean_word_handle = clean_word | handleize
      if collection.handle contains clean_word_handle or collection_title contains clean_word
        assign page_lens_words = page_lens_words | append: clean_word | append: '|'
      endif
    endfor
  endif
  assign page_lens_words = page_lens_words | split: '|'

  # Grouping wants every product it can get; colourway pages page like the source
  assign page_size = 50
  if per_colourway
    assign page_size = section.settings.colourway_page_size | default: 24
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component
  {% unless is_search %}
    view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  {% endunless %}
  {% if is_search %}
    data-spy-search-products
    {% comment %} Rebuy draws the results instead (search-header decides) {% endcomment %}
    class="[html[data-search-engine=rebuy]_&]:hidden"
  {% endif %}
>
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="false"
    {% comment %} ?page=N restores pages 1..N, so a "More results" URL survives a reload {% endcomment %}
    backfill-pages
    {% comment %} A model whose colourways span two pages renders twice; the stitcher drops the later copy {% endcomment %}
    {% unless per_colourway %}
      dedupe-groups
    {% endunless %}
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    {% comment %} Tailwind's own .grid forces a grid on mobile; Horizon wants a column there {% endcomment %}
    <div
      class="collection-wrapper grid gap-style max-[749px]:[display:flex] max-[749px]:flex-col{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% comment %}
        50 is the most products Liquid will hand us per page, and every extra one is
        another colourway the grouping can fold in — so always ask for all 50.
        The page is copied into a plain array (`where: 'id'`) so the grouping below
        reads the same list for a collection and for search.
      {% endcomment %}
      {%- if is_search -%}
        {%- paginate search.results by 50 -%}
          {%- assign page_products = search.results | where: 'object_type', 'product' -%}
          {%- assign pager = paginate -%}
        {%- endpaginate -%}
        {%- assign results_size = search.results_count -%}

        {%- comment -%} No hits: show a few models from a picked collection, like the source's "...Or check those" {%- endcomment -%}
        {%- assign is_fallback = false -%}
        {%- if search.results_count == 0 -%}
          {%- assign fallback_collection = section.settings.fallback_collection | default: settings.empty_state_collection | default: collections.all -%}
          {%- assign page_products = fallback_collection.products | where: 'id' -%}
          {%- assign is_fallback = true -%}
        {%- endif -%}
      {%- else -%}
        {%- paginate collection.products by page_size -%}
          {%- assign page_products = collection.products | where: 'id' -%}
          {%- assign pager = paginate -%}
        {%- endpaginate -%}
        {%- assign results_size = collection.products_count -%}
      {%- endif -%}

      {%- if is_fallback -%}
        {%- comment -%} Nothing to filter; the fallback grid sits below {%- endcomment -%}
      {%- elsif is_search -%}
        {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: results_size %}
      {%- else -%}
        {% content_for 'block', type: 'filters', id: 'filters', results: collection, results_size: results_size %}
      {%- endif -%}

        {% capture children %}
          {%- capture groups -%}
            {%- render 'spy-product-groups', products: page_products -%}
          {%- endcapture -%}

          {%- liquid
            assign sep = '~|~'
            assign groups = groups | strip | split: '~#~'
            assign group_keys = groups[0] | split: sep
            assign group_counts = groups[1] | split: sep

            # First-seen-wins, on every page. The merchant's order decides which
            # colourway fronts a model, so dragging any Discord to the top puts
            # Discord on top. A model with colourways on two pages renders on both;
            # `dedupe-groups` drops the later copy once the pages are stitched.
            # Picking the representative from the model collection instead got the
            # order wrong: that collection is sorted best-selling, not by hand.
            # Keys of groups holding at least one in-stock colourway, so a model is
            # fronted with something a shopper can actually buy
            assign in_stock_keys = sep
            for product in page_products
              if per_colourway
                break
              endif
              unless product.available
                continue
              endunless
              capture group_name
                render 'spy-group-name', product: product
              endcapture
              assign group_name = group_name | strip
              if group_name == ''
                assign group_key = 'ungrouped-' | append: product.id
              else
                assign group_key = group_name | handleize
              endif
              assign probe = sep | append: group_key | append: sep
              unless in_stock_keys contains probe
                assign in_stock_keys = in_stock_keys | append: group_key | append: sep
              endunless
            endfor

            assign rendered_keys = sep
            assign card_index = 0
            assign product_view_context = 'collection'
            if is_search
              assign product_view_context = 'search'
            endif
          -%}

          {%- comment -%} Same auto-fill maths the stock gallery uses — worked out once, not per card {%- endcomment -%}
          {%- capture card_size -%}
            {%- render 'util-product-grid-card-size', section: section -%}
          {%- endcapture -%}
          {%- capture image_sizes -%}
            {%- render 'util-autofill-img-size-attr',
              card_size: card_size,
              card_gap: section.settings.columns_gap_horizontal
            -%}
          {%- endcapture -%}
          {%- assign image_sizes = image_sizes | strip -%}

          {%- for product in page_products -%}
            {%- liquid
              capture group_name
                render 'spy-group-name', product: product
              endcapture
              assign group_name = group_name | strip

              if group_name == ''
                assign group_key = 'ungrouped-' | append: product.id
              else
                assign group_key = group_name | handleize
              endif
              assign probe = sep | append: group_key | append: sep

              # Does this colourway get to stand for the model? Colourway pages show every frame.
              assign is_representative = true
              unless per_colourway
                if rendered_keys contains probe
                  assign is_representative = false
                elsif product.available == false and in_stock_keys contains probe
                  assign is_representative = false
                endif
              endunless
            -%}

            {%- unless is_representative -%}
              {%- continue -%}
            {%- endunless -%}

            {%- if is_fallback and card_index >= section.settings.fallback_count -%}
              {%- break -%}
            {%- endif -%}

            {%- liquid
              assign rendered_keys = rendered_keys | append: group_key | append: sep

              # Fallback count only: the card counts the colours from the model collection
              assign group_count = 1
              for candidate_key in group_keys
                if candidate_key == group_key
                  assign group_count = group_counts[forloop.index0] | plus: 0
                  break
                endif
              endfor

              # Colourway pages: the frame's lens that fits the page, else its first one
              # in stock. $0 rows are skipped when the frame has real prices.
              assign card_per = ''
              assign card_variant = nil
              if per_colourway
                assign card_per = 'colourway'
                assign fit_live = nil
                assign fit_any = nil
                assign first_live = nil
                for v in product.variants
                  if product.price_max > 0 and v.price == 0
                    continue
                  endif
                  if first_live == nil and v.available
                    assign first_live = v
                  endif
                  assign v_title = v.title | downcase
                  for page_word in page_lens_words
                    if v_title contains page_word
                      if fit_any == nil
                        assign fit_any = v
                      endif
                      if fit_live == nil and v.available
                        assign fit_live = v
                      endif
                      break
                    endif
                  endfor
                endfor
                assign card_variant = fit_live | default: fit_any | default: first_live | default: product.selected_or_first_available_variant
              endif
            -%}

            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ card_index }}"
              data-page="{{ pager.current_page }}"
              data-product-id="{{ product.id }}"
              data-group-key="{{ group_key }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_spy-grouped-product-card',
                id: 'grouped-product-card',
                closest.product: product,
                group_name: group_name,
                group_count: group_count,
                image_sizes: image_sizes,
                product_view_context: product_view_context,
                card_per: card_per,
                card_variant: card_variant
              %}
            </li>

            {%- assign card_index = card_index | plus: 1 -%}
          {%- endfor -%}
        {% endcapture %}

        {%- liquid
          assign show_category_links = true
          if is_search
            assign show_category_links = false
          endif
        -%}
        {%- if is_fallback -%}
          {% comment %} Source centres its 3 fallback cards in 328px slots (1440) {% endcomment %}
          {% render 'product-grid',
            section: section,
            children: children,
            products: page_products,
            paginate: pager,
            enable_infinite_scroll: false,
            show_category_links: false,
            title: section.settings.fallback_heading,
            title_class: 'm-0 mb-12 pt-12 text-center font-spy text-[48px] leading-[57.6px] font-normal normal-case tracking-normal text-spy-ink max-[750px]:text-[32px] max-[750px]:leading-[38.4px]',
            grid_class: 'min-[992px]:max-w-[984px] min-[992px]:mx-auto min-[992px]:w-full'
          %}
        {%- else -%}
          {% render 'product-grid',
            section: section,
            children: children,
            products: page_products,
            paginate: pager,
            enable_infinite_scroll: false,
            show_category_links: show_category_links
          %}
        {%- endif -%}
    </div>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "Grouped collection",
  "enabled_on": {
    "templates": ["collection", "search"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "One card per model. Colourways are matched on their `collection::MODEL` tag."
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "text",
      "id": "more_results_label",
      "label": "\"More results\" button label",
      "default": "More results"
    },
    {
      "type": "header",
      "content": "Colourway pages"
    },
    {
      "type": "paragraph",
      "content": "These pages show one card per frame colour, like the colourway tiles on spyoptic.com. A collection that holds a single model does this on its own."
    },
    {
      "type": "collection_list",
      "id": "colourway_collections",
      "label": "Collections",
      "limit": 50
    },
    {
      "type": "text",
      "id": "colourway_lens_words",
      "label": "Lens words",
      "info": "Comma-separated. When a page's title or URL holds one of these words, each card shows a lens with that word, e.g. Polarized → a Polar lens.",
      "default": "Polar, Murdered Out, Happy Boost"
    },
    {
      "type": "range",
      "id": "colourway_page_size",
      "label": "Cards per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Search with no results"
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "Heading",
      "default": "...Or check those"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Collection",
      "info": "Models shown when a search finds nothing. Falls back to the empty state collection in theme settings."
    },
    {
      "type": "range",
      "id": "fallback_count",
      "label": "Models shown",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "link_list",
      "id": "category_links_menu",
      "label": "Category links menu",
      "info": "Buttons under the grid show the menu items that sit on the same level as the current collection. Leave blank to use the main menu.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": []
}
{% endschema %}

{%- comment -%}
  Agent Video — the video band on the Change Agents athlete pages.

  Same block engine as Horizon's custom section (video / text / group blocks
  nest inside it), but the band owns EVERY side of its padding and margin, per
  breakpoint. Spacing is authored with Tailwind utilities reading the vars set
  below, so an editor can move the band without a code change.

  Margin sits outside the background color; padding sits inside it.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # "Page" keeps the theme's page margins, the same cap a stock section gets
  case s.section_width
    when 'full-width'
      assign max_width = 'none'
    when 'custom'
      assign max_width = s.max_width | append: 'px'
    else
      assign max_width = 'min(var(--page-content-width), calc(100% - var(--page-margin) * 2))'
  endcase

  capture children
    content_for 'blocks'
  endcapture
-%}

<div
  class="
    agent-video
    mt-[var(--av-mt-m)] mb-[var(--av-mb-m)] ml-[var(--av-ml-m)] mr-[var(--av-mr-m)]
    min-[750px]:mt-[var(--av-mt)] min-[750px]:mb-[var(--av-mb)] min-[750px]:ml-[var(--av-ml)] min-[750px]:mr-[var(--av-mr)]
  "
  style="
    --av-bg: {{ s.background_color | default: 'transparent' }};
    --av-max: {{ max_width }};
    --av-pt: {{ s.padding_top }}px;
    --av-pb: {{ s.padding_bottom }}px;
    --av-pl: {{ s.padding_left }}px;
    --av-pr: {{ s.padding_right }}px;
    --av-pt-m: {{ s.padding_top_mobile }}px;
    --av-pb-m: {{ s.padding_bottom_mobile }}px;
    --av-pl-m: {{ s.padding_left_mobile }}px;
    --av-pr-m: {{ s.padding_right_mobile }}px;
    --av-mt: {{ s.margin_top }}px;
    --av-mb: {{ s.margin_bottom }}px;
    --av-ml: {{ s.margin_left }}px;
    --av-mr: {{ s.margin_right }}px;
    --av-mt-m: {{ s.margin_top_mobile }}px;
    --av-mb-m: {{ s.margin_bottom_mobile }}px;
    --av-ml-m: {{ s.margin_left_mobile }}px;
    --av-mr-m: {{ s.margin_right_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  {%- comment -%} The band: background and width cap live here, so margin stays outside the color {%- endcomment -%}
  <div class="mx-auto w-full bg-[var(--av-bg)] [max-width:var(--av-max)]">
    {%- comment -%}
      Horizon's own layout classes, so nested group / video / text blocks size
      themselves exactly as they do in a stock section.
    {%- endcomment -%}
    <div
      class="
        layout-panel-flex layout-panel-flex--{{ s.content_direction }} section-content-wrapper
        {% if s.vertical_on_mobile %}mobile-column{% endif %}
        pt-[var(--av-pt-m)] pb-[var(--av-pb-m)] pl-[var(--av-pl-m)] pr-[var(--av-pr-m)]
        min-[750px]:pt-[var(--av-pt)] min-[750px]:pb-[var(--av-pb)] min-[750px]:pl-[var(--av-pl)] min-[750px]:pr-[var(--av-pr)]
      "
      style="{% render 'layout-panel-style', settings: s %}"
    >
      {{ children }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Agent Video",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {

{%- comment -%}
  Product carousel — the homepage product rail.

  The source runs slick with a four-step ladder keyed to the WINDOW width, not to a
  container: 5 across above 1140, 3 down to 721, 2 down to 541, and a single centred
  card with a 50px peek at 540 and below. Horizon's own carousel only knows one
  desktop count plus a mobile card size, so this section owns the rail instead and
  reuses the shared product card block for the cards themselves.

  Slides sit flush (no gap) and each carries 8px of side padding, which is where the
  16px visual gutter between cards comes from — same trick the source uses.

  Arrows only appear where the source shows them: slick hides them when every slide
  already fits, so a 5-product rail has none on desktop.

  Some rails (the gift guide) keep slick's centre mode above 1140 too. With five
  products that is just empty space at both ends, so it is plain track padding here.
{%- endcomment -%}

{%- liquid
  assign coll = section.settings.collection
  assign max_items = section.settings.max_products

  assign c_sm = section.settings.count_mobile | default: 1
  assign c_md = section.settings.count_small | default: 2
  assign c_lg = section.settings.count_tablet | default: 3
  assign c_xl = section.settings.count_desktop | default: 5
  assign peek = section.settings.peek | default: 0

  # Mobile keeps a centred card with a peek either side; the wider steps divide evenly.
  # The peek is the track's own padding, so the card is a full 100% of what is left —
  # subtracting it again here would shrink the card twice over.
  assign basis_sm = 'calc(100% / ' | append: c_sm | append: ')'
  assign basis_md = 'calc(100% / ' | append: c_md | append: ')'
  assign basis_lg = 'calc(100% / ' | append: c_lg | append: ')'
  assign basis_xl = 'calc(100% / ' | append: c_xl | append: ')'

-%}

{%- comment -%} An empty collection falls back to placeholder cards: fine in the editor, never for shoppers {%- endcomment -%}
{%- liquid
  assign hide_carousel = false
  if coll == blank or coll.products.size == 0
    unless request.design_mode
      assign hide_carousel = true
    endunless
  endif
-%}
{%- unless hide_carousel -%}

{%- comment -%}
  The source scrolls a whole page of cards on the wider steps — 3 at a time in the
  721–1140 band, 2 at a time in 541–720 — and only single-steps at the extremes.
  It also wraps around at 540 and below. Both are read straight off its slick config.
{%- endcomment -%}

{%- comment -%}
  section-resource-list is the scope the shared product-card CSS hangs off. Without it
  the card renders unstyled — the swatch thumb balloons to the full card width.
{%- endcomment -%}
<div
  class="spy-product-carousel section-resource-list mt-[var(--spc-mt)] mb-[var(--spc-mb)]"
  style="
    --spc-b-sm: {{ basis_sm }}; --spc-b-md: {{ basis_md }};
    --spc-b-lg: {{ basis_lg }}; --spc-b-xl: {{ basis_xl }};
    --spc-peek: {{ peek }}px;
    --spc-peek-d: {{ section.settings.peek_desktop | default: 0 }}px;
    --spc-inset-m: {{ section.settings.track_inset_mobile }}px;
    --spc-inset-d: {{ section.settings.track_inset }}px;
    --spc-mt: {{ section.settings.margin_top }}px;
    --spc-mb: {{ section.settings.margin_bottom }}px;
    --spc-arrow: {{ section.settings.arrow_size }}px;
  "
  {{ section.shopify_attributes }}
>
  {%- comment -%} Brings in the shared .resource-list__item rules the card leans on {%- endcomment -%}
  {%- render 'resource-list-styles' -%}

    {%- liquid
      # Per width, lowest first: ≤540, 541–720, 721–1140, above (the source's slick ladder)
      assign s = section.settings
      capture rail_opts
        echo '{"speed":' | append: s.transition_speed
        echo ',"step":[' | append: s.scroll_mobile | append: ',' | append: s.scroll_small | append: ',' | append: s.scroll_tablet | append: ',' | append: s.scroll_desktop | append: ']'
        if s.wrap_mobile
          echo ',"loop":[1,0,0,0]'
        else
          echo ',"loop":0'
        endif
        echo ',"arrows":['
        if s.arrows_mobile
          echo '1,'
        else
          echo '0,'
        endif
        if s.arrows_tablet
          echo '1,1,'
        else
          echo '0,0,'
        endif
        if s.arrows_desktop
          echo '1]'
        else
          echo '0]'
        endif
        if s.dots_mobile
          echo ',"dots":[1,0,0,0]}'
        else
          echo ',"dots":0}'
        endif
      endcapture
    -%}
    <spy-slider class="block relative" data-opts="{{ rail_opts | strip | escape }}">
      {%- render 'spy-slider-arrow', dir: 'prev', class: 'absolute z-[2] top-[48%] left-[5px] -translate-y-1/2' -%}

    <div
      data-track
      class="spy-product-carousel__track [&_img]:[-webkit-user-drag:none] [&[data-dragging]_a]:pointer-events-none [&[data-dragging]_button]:pointer-events-none [display:flex] overflow-x-auto snap-x snap-mandatory mx-[var(--spc-inset-m)] min-[992px]:mx-[var(--spc-inset-d)] px-[var(--spc-peek)] min-[541px]:px-0 min-[1141px]:px-[var(--spc-peek-d)] min-[1141px]:scroll-px-[var(--spc-peek-d)] [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      {%- if coll != blank and coll.products.size > 0 -%}
        {%- for product in coll.products limit: max_items -%}
          <div
            data-slide
            class="spy-product-carousel__slide shrink-0 grow-0 min-w-0 px-2 snap-center min-[541px]:snap-start basis-[var(--spc-b-sm)] min-[541px]:basis-[var(--spc-b-md)] min-[721px]:basis-[var(--spc-b-lg)] min-[1141px]:basis-[var(--spc-b-xl)]"
          >
            {%- comment -%}
              resource-list__item gives the card its grid layout; h-auto cancels the
              height:100% that comes with it, which would collapse inside a flex rail.
            {%- endcomment -%}
            <div class="resource-list__item h-auto">
              {%- comment -%} Curated rail, not a category listing — keeps it out of PLP numbers {%- endcomment -%}
              {%- if section.settings.use_grouped_card -%}
                {%- comment -%} Same card as the PLP, so hover, Quick View and badges behave the same {%- endcomment -%}
                {%- capture group_name -%}{%- render 'spy-group-name', product: product -%}{%- endcapture -%}
                {%- assign group_name = group_name | strip -%}
                {%- capture model_facts -%}
                  {%- render 'spy-model-collection-facts', product: product, group_name: group_name -%}
                {%- endcapture -%}
                {%- liquid
                  assign model_facts = model_facts | strip | split: '~^~'
                  assign group_count = model_facts[0] | plus: 0
                  if group_count < 1
                    assign group_count = 1
                  endif
                -%}
                {%- content_for 'block',
                  type: '_spy-grouped-product-card',
                  id: 'grouped-product-card',
                  closest.product: product,
                  group_name: group_name,
                  group_count: group_count,
                  image_sizes: '(min-width: 1141px) 20vw, (min-width: 721px) 33vw, (min-width: 541px) 50vw, 100vw',
                  product_view_context: 'recommendation'
                -%}
              {%- else -%}
                {%- content_for 'block',
                  type: '_product-card',
                  id: 'static-product-card',
                  closest.product: product,
                  product_view_context: 'recommendation'
                -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards keep the rail measurable in the editor {%- endcomment -%}
        {%- for i in (1..max_items) -%}
          <div
            data-slide
            class="spy-product-carousel__slide shrink-0 grow-0 min-w-0 px-2 snap-center min-[541px]:snap-start basis-[var(--spc-b-sm)] min-[541px]:basis-[var(--spc-b-md)] min-[721px]:basis-[var(--spc-b-lg)] min-[1141px]:basis-[var(--spc-b-xl)]"
          >
            {%- comment -%} h-auto cancels the grid's height:100%, which collapses in a flex rail {%- endcomment -%}
            <div class="resource-list__item h-auto">
              {%- content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- render 'spy-slider-arrow', dir: 'next', class: 'absolute z-[2] top-[48%] right-[5px] -translate-y-1/2' -%}

    {%- comment -%}
      Source dots: 10px solid ink circles, 4px apart, 16px off the bottom.
      These are real buttons, so the group must not be aria-hidden — that would leave
      focusable controls unreachable to a screen reader.
    {%- endcomment -%}
    <div
      data-dots
      data-dot-label="{{ 'accessibility.slide_status' | t: index: '[i]', length: '[n]' | escape }}"
      class="[display:flex] data-[off]:hidden absolute inset-x-0 bottom-4 items-center justify-center gap-2"
      data-off
      role="group"
      aria-label="Choose a product"
    ></div>
  </spy-slider>
</div>

<script src="{{ 'spy-slider.js' | asset_url }}" type="module"></script>
{%- endunless -%}

{% schema %}
{
  "name": "SPY Product Carousel",
  "tag": "div",
  "class": "spy-product-carousel-section",
  "blocks": [{ "type": "@app" }],
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "use_grouped_card",
      "label": "Use the PLP card",
      "info": "Renders the grouped PLP card (set it to one card per colourway for the homepage look) instead of the block-built card.",
      "default": false
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Cards across"
    },
    {
      "type": "range",
      "id": "count_desktop",
      "label": "1141px and up",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "count_tablet",
      "label": "721–1140px",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "count_small",
      "label": "541–720px",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "count_mobile",
      "label": "540px and below",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "peek",
      "label": "Peek either side (540px and below)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 50,
      "info": "Matches slick's centre mode. Set 0 for full-width cards."
    },
    {
      "type": "range",
      "id": "peek_desktop",
      "label": "Space at both ends (above 1140px)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Slick's centre mode on wide screens. The homepage uses 0, the gift guide 50."
    },
    {
      "type": "header",
      "content": "Track inset"
    },
    {
      "type": "range",
      "id": "track_inset",
      "label": "992px and up",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "track_inset_mobile",
      "label": "Below 992px",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Cards moved per arrow click"
    },
    {
      "type": "range",
      "id": "scroll_desktop",
      "label": "1141px and up",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "scroll_tablet",
      "label": "721–1140px",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "scroll_small",
      "label": "541–720px",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "scroll_mobile",
      "label": "540px and below",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "wrap_mobile",
      "label": "Wrap around at 540px and below",
      "default": true,
      "info": "Matches the source, which only loops at the smallest step."
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Glide duration",
      "min": 0,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "default": 300,
      "info": "Slick's default is 300ms."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "arrows_mobile",
      "label": "Arrows at 540px and below",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrows_tablet",
      "label": "Arrows from 541px",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "arrows_desktop",
      "label": "Arrows from 1141px",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots_mobile",
      "label": "Dots at 540px and below",
      "default": true
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Arrow size",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Above",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Below",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "SPY Product Carousel",
      "category": "SPY"
    }
  ]
}
{% endschema %}

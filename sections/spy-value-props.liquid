{%- comment -%}
  SPY Value Props — trust/value row built only from basic blocks.
  Full-bleed light band with a col-10 content well: 4 columns from 769px, 2 below.
  The band itself has no padding — like the source, each column carries it, so
  stacked rows keep the same rhythm. Icons are picked in the editor.
{%- endcomment -%}

<div
  class="spy-value-props w-full"
  style="
    background-color: {{ section.settings.background_color }};
    {% if section.settings.show_border %}border-bottom: 1px solid {{ section.settings.border_color }};{% endif %}
  "
  {{ section.shopify_attributes }}
>
  {%- comment -%} [display:grid] not `grid`: Horizon's own .grid class would add 14 track areas. {%- endcomment -%}
  <div
    class="spy-value-props__inner mx-auto w-[calc((100%_+_30px)_*_var(--vp-col,0.8333333)_-_30px)] items-start [display:grid] [grid-template-columns:repeat(var(--vp-cols-mobile,2),minmax(0,1fr))] min-[769px]:[grid-template-columns:repeat(var(--vp-cols,4),minmax(0,1fr))]
      [&>.group-block]:h-full [&>.group-block]:[padding-block:var(--vp-pad-top)_var(--vp-pad-bottom)]
      [&_.icon-block\_\_media]:h-[var(--vp-icon-h,72px)] [&_.icon-block\_\_media]:w-auto"
    style="
      column-gap: {{ section.settings.column_gap }}px;
      --vp-col: {{ section.settings.content_columns | divided_by: 12.0 }};
      --vp-cols: {{ section.settings.columns }};
      --vp-cols-mobile: {{ section.settings.columns_mobile }};
      --vp-icon-h: {{ section.settings.icon_height }}px;
      --vp-pad-top: {{ section.settings.padding_top }}px;
      --vp-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{

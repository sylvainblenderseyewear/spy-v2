{%- comment -%}
  Collection hero — the banner above the PLP grid, built like the old site's
  `.category-banner`.

  - Two crops: desktop from 769px up, mobile below. Each image shows at its own
    ratio (width 100%, height auto), so the band is as tall as the art.
  - The name is centred in a box that starts 15px in from the left edge.
  - No image: no band, just the name in the text colour, like the old site.

  Data comes from the collection first, so one template serves them all:
  `hero_image`, `hero_image_mobile`, `hero_heading` and `hero_heading_size`
  (namespace `collection` or `custom`). Section settings are the fallback.
{%- endcomment -%}

{%- liquid
  # `collection` is the API namespace, `custom` is where the admin UI puts new fields
  assign mf = collection.metafields.collection
  assign mf_custom = collection.metafields.custom

  assign img_desktop = mf.hero_image.value | default: mf_custom.hero_image.value | default: section.settings.image_desktop
  assign img_mobile = mf.hero_image_mobile.value | default: mf_custom.hero_image_mobile.value | default: section.settings.image_mobile

  # One crop is enough, it just shows at every width
  if img_desktop == blank
    assign img_desktop = img_mobile
  endif
  if img_mobile == blank
    assign img_mobile = img_desktop
  endif

  assign has_image = true
  if img_desktop == blank
    assign has_image = false
  endif

  assign heading = mf.hero_heading.value | default: mf_custom.hero_heading.value | default: section.settings.heading | default: collection.title
  assign heading_plain = heading | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip

  # Some old titles are a fixed size (22px) on top of the responsive one
  assign heading_size = mf.hero_heading_size.value | default: mf_custom.hero_heading_size.value
-%}

{%- if has_image or section.settings.show_fallback -%}
  <div
    class="spy-collection-hero relative w-full overflow-hidden"
    style="
      --hero-zone-mobile: {{ section.settings.panel_width_mobile }}%;
      --hero-zone-desktop: {{ section.settings.panel_width_desktop }}%;
      --hero-title-mobile: {{ section.settings.title_vw_mobile }}vw;
      --hero-title-tablet: {{ section.settings.title_vw_tablet }}vw;
      --hero-title-desktop: {{ section.settings.title_vw_desktop }}vw;
      {% if heading_size != blank %}--hero-title-fixed: {{ heading_size }}px;{% endif %}
    "
    {{ section.shopify_attributes }}
  >
    {%- if has_image -%}
      <picture>
        <source
          media="(min-width: 769px)"
          srcset="{{ img_desktop | image_url: width: 1100 }} 1100w, {{ img_desktop | image_url: width: 1440 }} 1440w, {{ img_desktop | image_url: width: 1920 }} 1920w, {{ img_desktop | image_url: width: 2880 }} 2880w"
          sizes="100vw"
          width="{{ img_desktop.width }}"
          height="{{ img_desktop.height }}"
        >
        <img
          src="{{ img_mobile | image_url: width: 800 }}"
          srcset="{{ img_mobile | image_url: width: 400 }} 400w, {{ img_mobile | image_url: width: 800 }} 800w, {{ img_mobile | image_url: width: 1200 }} 1200w, {{ img_mobile | image_url: width: 1600 }} 1600w"
          sizes="100vw"
          alt="{{ heading_plain | escape }}"
          width="{{ img_mobile.width }}"
          height="{{ img_mobile.height }}"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        >
      </picture>
    {%- endif -%}

    {%- if section.settings.show_heading and heading != blank -%}
      <div class="px-[15px] {% if has_image %} pointer-events-none absolute inset-0 flex items-center {% endif %}">
        <div class="w-[calc(var(--hero-zone-mobile)_-_16px)] text-center min-[769px]:w-[calc(var(--hero-zone-desktop)_-_32px)] {% unless has_image %} mt-[16px] {% endunless %}">
          <h1
            class="m-0 uppercase leading-[1.2] text-[length:var(--hero-title-mobile)] min-[544px]:text-[length:var(--hero-title-tablet)] min-[769px]:text-[length:var(--hero-title-desktop)] {% unless has_image %} text-spy-ink {% endunless %}"
            style="
              {% if has_image %}color: {{ section.settings.heading_color }};{% endif %}
              font-family: var(--font-heading--family);
              font-weight: {{ section.settings.heading_weight }};
              letter-spacing: {{ section.settings.heading_tracking }}em;
            "
          >
            {%- if heading_size != blank -%}
              <span class="text-[length:var(--hero-title-fixed)]">{{ heading | escape | newline_to_br }}</span>
            {%- else -%}
              {{ heading | escape | newline_to_br }}
            {%- endif -%}
          </h1>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{%- comment -%} Banner impressions — no Shopify standard event covers these {%- endcomment -%}
{%- if section.settings.image_desktop != blank -%}
  {%- render 'spy-promotion-event',
    id: section.id,
    slot: 'collection_hero',
    name: heading
  -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection Hero",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each collection's own metafields come first: Hero Image, Hero Image (Mobile), Hero Heading and Hero Heading Size. The settings here are the fallback for collections that have none."
    },
    {
      "type": "header",
      "content": "Images",
      "info": "Each image shows at its own ratio, so the banner is as tall as the art. Old site sizes: desktop 1920×300 or 1920×400, mobile 800×400."
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image — desktop",
      "info": "From 769px wide."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image — mobile",
      "info": "Below 769px."
    },
    {
      "type": "checkbox",
      "id": "show_fallback",
      "label": "Show the collection name when there is no image",
      "info": "Like the old site: the name sits on the page in the text colour, with no band.",
      "default": true
    },
    {
      "type": "header",
      "content": "Collection name"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show collection name",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Override text",
      "info": "Changes the name on every collection that uses this template. For one collection, fill its Hero Heading metafield instead."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text colour on the image",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "heading_tracking",
      "label": "Letter spacing",
      "options": [
        { "value": "0", "label": "None" },
        { "value": "0.02", "label": "Tight" },
        { "value": "0.05", "label": "Normal" },
        { "value": "0.1", "label": "Wide" },
        { "value": "0.15", "label": "Wider" }
      ],
      "default": "0"
    },
    {
      "type": "range",
      "id": "title_vw_desktop",
      "label": "Size — desktop",
      "info": "Share of the screen width, from 769px. Old site: 1.8 (26px at 1440px).",
      "min": 0.5,
      "max": 5,
      "step": 0.1,
      "unit": "vw",
      "default": 1.8
    },
    {
      "type": "range",
      "id": "title_vw_tablet",
      "label": "Size — tablet",
      "info": "544–768px. Old site: 3 (23px at 768px).",
      "min": 1,
      "max": 8,
      "step": 0.1,
      "unit": "vw",
      "default": 3
    },
    {
      "type": "range",
      "id": "title_vw_mobile",
      "label": "Size — mobile",
      "info": "Below 544px. Old site: 4 (16px at 390px).",
      "min": 1,
      "max": 8,
      "step": 0.1,
      "unit": "vw",
      "default": 4
    },
    {
      "type": "header",
      "content": "Name position",
      "info": "Width of the box the name is centred in, from the left edge. The box is 2rem narrower on desktop and 1rem on mobile, like the old site."
    },
    {
      "type": "range",
      "id": "panel_width_desktop",
      "label": "Box width — desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 66
    },
    {
      "type": "range",
      "id": "panel_width_mobile",
      "label": "Box width — mobile",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": []
}
{% endschema %}
